@{
    ViewData["Title"] = "Customer SOA";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Head {
    <!-- DataTables -->
    <link href="~/assets/libs/datatables.net-bs4/css/dataTables.bootstrap4.min.css" rel="stylesheet" type="text/css" />
    <link href="~/assets/libs/datatables.net-buttons-bs4/css/buttons.bootstrap4.min.css" rel="stylesheet" type="text/css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/fixedheader/3.4.0/css/fixedHeader.dataTables.min.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/buttons/2.4.2/css/buttons.dataTables.min.css">
    <link href="~/assets/libs/select2/css/select2.min.css" rel="stylesheet" type="text/css">

    <style>
        .dataTables_empty {
            display: none !important;
        }
    </style>
}

<div class="page-content">
    <div class="container-fluid">

        <!-- Page Title -->
        <div class="row">
            <div class="col-12">
                <div class="page-title-box d-sm-flex align-items-center justify-content-between">
                    <h4 class="mb-sm-0">Statement of Account</h4>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-body">

                        <!-- Filter Button -->
                      @*   <div class="mb-3">
                            <button class="btn btn-info" type="button" data-bs-toggle="collapse" data-bs-target="#filterSection">
                                <i class="fa fa-filter"></i> Filter
                            </button>
                        </div> *@

                        <!-- Filter Section -->
                        <div class="" id="filterSection">
                            <div class="card mb-3 p-3">

                                <div class="row mb-3">

                                    <div class="col-md-3">
                                        <select id="filterCustomer" class="form-control select-my">
                                            <option value="" selected disabled>Select Customer</option>
                                        </select>
                                    </div>

                                    <!-- 📅 From Date -->
                                    <div class="col-md-3">
                                        <input type="date" id="filterFromDate" name="filterFromDate" class="form-control" placeholder="From Date">
                                    </div>

                                    <!-- 📅 To Date -->
                                    <div class="col-md-3">
                                        <input type="date" id="filterToDate" name="filterToDate" class="form-control" placeholder="To Date">
                                    </div>

                                    <div class="col-md-3 d-flex align-items-end">
                                        <button id="btnSearch" class="btn btn-primary me-2 w-75">Search</button>
                                        <button id="btnClear" class="btn btn-secondary w-50" style="display:none;">Clear</button>
                                    </div>

                                </div>

                               

                            </div>
                        </div>


                        <!-- Datatable -->
                        <div class="table-wrapper">
                            <div class="table-wrapper">
                                <table id="datatable" class="table table-striped table-bordered dt-responsive nowrap" style="width:100%">
                                    <thead>
                                        <tr>
                                            <th>Date</th>
                                            <th>Description / Transaction Details</th>
                                            <th>Invoice No</th>
                                            <th>B/L Number</th>
                                            <th>Debit (SAR)</th>
                                            <th>Credit (SAR)</th>
                                            <th>Balance (SAR)</th>
                                            <th>Status</th>
                                        </tr>
                                    </thead>
                                </table>
                            </div>
                        </div>


                        <div id="tableLoader" style="text-align:center;padding:40px;display:none;">
                            <div class="spinner-border text-primary"></div>
                            <div class="mt-2"></div>
                        </div>

                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

@section Script {

    <!-- Required datatable js -->
    <script src="~/assets/libs/datatables.net/js/jquery.dataTables.min.js"></script>
    <script src="~/assets/libs/datatables.net-bs4/js/dataTables.bootstrap4.min.js"></script>
    <script src="https://cdn.datatables.net/fixedheader/3.4.0/js/dataTables.fixedHeader.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/dataTables.buttons.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.html5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.print.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/pdfmake.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/vfs_fonts.js"></script>
    <script src="~/assets/libs/select2/js/select2.min.js"></script>

    <script>

        $(document).ready(function () {

            loadCustomer();
            clearForm();
            //loadRecords();

            $("#btnSearch").click(function () {
                loadRecords();
            });

            $("#btnClear").click(function () {
                clearForm();
                loadRecords();
            });

        });

        function loadRecords() {

            if ($.fn.DataTable.isDataTable('#datatable')) {
                $('#datatable').DataTable().destroy();
            }

            var table = $("#datatable").DataTable({
                processing: true,
                serverSide: true,
                paging: true,
                lengthChange: true,
                scrollX: true,
                scrollCollapse: true,
                autoWidth: false,
                responsive: false,
                pageLength: 100,
                order: [[0, "asc"]],
                searching: false,
                dom: "<'row mb-3 align-items-center'<'col-sm-12 col-md-6'B><'col-sm-12 col-md-6 text-end'l>>" +
                     "<'row'<'col-sm-12'tr>>" +
                     "<'row mt-3'<'col-sm-12 col-md-5'i><'col-sm-12 col-md-7'p>>",
                language: {
                    paginate: {
                        previous: "<i class='fas fa-chevron-left'></i>",
                        next: "<i class='fas fa-chevron-right'></i>"
                    }
                },
                buttons: [
                    {
                        extend: "excelHtml5",
                        text: '<i class="fas fa-file-excel me-1"></i> Export Excel',
                        className: "btn btn-sm btn-success",

                        title: function () {
                            const selectedCustomer =
                                $("#filterCustomer option:selected").text().trim();

                            const customerName =
                                !selectedCustomer ||
                                selectedCustomer.toLowerCase() === "select customer"
                                    ? "All"
                                    : selectedCustomer;

                            const fromDate = formatReportDate(
                                $("#filterFromDate").val()
                            );

                            const toDate = formatReportDate(
                                $("#filterToDate").val()
                            );

                            return (
                                `Customer Statement of Accounts\n` +
                                `Customer: ${customerName}\n` +
                                `From Date: ${fromDate} To Date: ${toDate}`
                            );
                        },

                        autoFilter: true,

                        exportOptions: {
                            columns: ":visible"
                        },

                        customize: function (xlsx) {
                            const sheet = xlsx.xl.worksheets["sheet1.xml"];
                            const styles = xlsx.xl["styles.xml"];

                            const fonts = $("fonts", styles);
                            const cellXfs = $("cellXfs", styles);

                            // New bold font with increased size
                            const fontId = $("font", fonts).length;

                            fonts.append(
                                "<font>" +
                                    "<b/>" +
                                    '<sz val="12"/>' +
                                    '<name val="Calibri"/>' +
                                    '<family val="2"/>' +
                                "</font>"
                            );

                            fonts.attr("count", fontId + 1);

                            // New centered style with text wrapping
                            const styleId = $("xf", cellXfs).length;

                            cellXfs.append(
                                '<xf numFmtId="0" ' +
                                    'fontId="' + fontId + '" ' +
                                    'fillId="0" ' +
                                    'borderId="0" ' +
                                    'xfId="0" ' +
                                    'applyFont="1" ' +
                                    'applyAlignment="1">' +
                                    '<alignment ' +
                                        'horizontal="center" ' +
                                        'vertical="center" ' +
                                        'wrapText="1"/>' +
                                "</xf>"
                            );

                            cellXfs.attr("count", styleId + 1);

                            // Apply style to Excel title cell
                            $('c[r="A1"]', sheet).attr("s", styleId);

                            // Increase title row height
                            $("row:first", sheet)
                                .attr("ht", "55")
                                .attr("customHeight", "1");
                        }
                    },
                    {
                        extend: "pdfHtml5",
                        text: '<i class="fas fa-file-pdf me-1"></i> PDF',
                        className: "btn btn-sm btn-danger ms-1",
                        title: null,
                        orientation: "landscape",
                        pageSize: "A4",

                        exportOptions: {
                            columns: ":visible"
                        },

                        customize: function (doc) {
                            doc.pageOrientation = "landscape";
                            doc.pageSize = "A4";

                            const selectedCustomer =
                                $("#filterCustomer option:selected").text().trim();

                            const customerName =
                                !selectedCustomer ||
                                selectedCustomer.toLowerCase() === "select customer"
                                    ? "All"
                                    : selectedCustomer;

                            const fromDate = formatReportDate(
                                $("#filterFromDate").val()
                            );

                            const toDate = formatReportDate(
                                $("#filterToDate").val()
                            );

                            // Table ko title add karne se pehle find karein.
                            const table = doc.content.find(function (item) {
                                return item.table;
                            });

                            // PDF title
                            doc.content.splice(0, 0, {
                                text: [
                                    {
                                        text: "Customer Statement of Accounts",
                                        fontSize: 16,
                                        bold: true
                                    },
                                    {
                                        text: `\nCustomer: ${customerName}`,
                                        fontSize: 11,
                                        bold: true
                                    },
                                    {
                                        text: `\nFrom Date: ${fromDate} To Date: ${toDate}`,
                                        fontSize: 10,
                                        bold: true
                                    }
                                ],
                                alignment: "center",
                                margin: [0, 0, 0, 12]
                            });

                            doc.defaultStyle = {
                                fontSize: 8
                            };

                            doc.pageMargins = [10, 15, 10, 15];

                            if (table) {
                                const tableBody = table.table.body;

                                table.table.headerRows = 1;

                                table.table.widths = Array(tableBody[0].length)
                                    .fill("*");

                                table.layout = {
                                    hLineWidth: function () {
                                        return 0.5;
                                    },

                                    vLineWidth: function () {
                                        return 0.5;
                                    },

                                    hLineColor: function () {
                                        return "#cccccc";
                                    },

                                    vLineColor: function () {
                                        return "#cccccc";
                                    },

                                    paddingLeft: function () {
                                        return 4;
                                    },

                                    paddingRight: function () {
                                        return 4;
                                    },

                                    paddingTop: function () {
                                        return 3;
                                    },

                                    paddingBottom: function () {
                                        return 3;
                                    }
                                };
                            }

                            doc.styles.tableHeader = {
                                fontSize: 8,
                                bold: true,
                                alignment: "center",
                                fillColor: "#343a40",
                                color: "#ffffff"
                            };
                        }
                    }
                ],
                ajax: {
                    url: "/Report/GetCustomerStatement",
                    type: "POST",
                    data: function (d) {
                        d.customerId = $("#filterCustomer").val();
                        d.fromDate = $("#filterFromDate").val();
                        d.toDate = $("#filterToDate").val();
                    }
                },
                initComplete: function () {
                    var api = this.api();
                    setTimeout(function () {
                        api.columns.adjust();
                    }, 200);
                },
                drawCallback: function () {
                    this.api().columns.adjust();
                },
                columns: [
                    {
                        data: "Date",
                        className: "align-middle text-start",
                        render: function (data) {
                            return typeof formatDate === 'function' ? formatDate(data) : (data || '-');
                        }
                    },
                    {
                        data: "Description",
                        className: "align-middle text-start"
                    },
                    {
                        data: "InvoiceNo",
                        className: "align-middle text-start",
                        render: function (data) {
                            return data ? `<span class="fw-semibold text-dark">${data}</span>` : '-';
                        }
                    },
                    {
                        data: "BLNumber",
                        className: "align-middle text-start",
                        render: function (data) {
                            return data || '-';
                        }
                    },
                    {
                        data: "Debit",
                        className: "text-end align-middle",
                        render: formatAmount
                    },
                    {
                        data: "Credit",
                        className: "text-end align-middle",
                        render: formatAmount
                    },
                    {
                        data: "Balance",
                        className: "text-end align-middle fw-bold",
                        render: formatAmount
                    },
                    {
                        data: "Status",
                        className: "text-center align-middle",
                        render: function (data) {
                            if (!data) return '-';
                            const statusStr = data.toString().trim().toLowerCase();

                            if (statusStr === 'paid' || statusStr === '1') {
                                return `<span class="d-inline-flex align-items-center rounded-pill fw-semibold"
                                              style="background-color: rgba(25, 135, 84, 0.12); color: #198754; border: 1px solid rgba(25, 135, 84, 0.25); padding: 0.2rem 0.6rem; font-size: 0.725rem;">
                                            <i class="bi bi-check-circle-fill me-1"></i> Paid
                                        </span>`;
                            } else if (statusStr === 'unpaid' || statusStr === '0') {
                                return `<span class="d-inline-flex align-items-center rounded-pill fw-semibold"
                                              style="background-color: rgba(220, 53, 69, 0.12); color: #dc3545; border: 1px solid rgba(220, 53, 69, 0.25); padding: 0.2rem 0.6rem; font-size: 0.725rem;">
                                            <i class="bi bi-x-circle-fill me-1"></i> Unpaid
                                        </span>`;
                            } else {
                                return `<span class="d-inline-flex align-items-center rounded-pill fw-semibold"
                                              style="background-color: rgba(255, 193, 7, 0.15); color: #b58100; border: 1px solid rgba(255, 193, 7, 0.3); padding: 0.2rem 0.6rem; font-size: 0.725rem;">
                                            <i class="bi bi-hourglass-split me-1"></i> ${data}
                                        </span>`;
                            }
                        }
                    }
                ]
            });
        }

        function loadCustomer() {

            $('#filterCustomer').select2({

                placeholder: 'Select Customer',
                allowClear: true,
                width: '100%',

                ajax: {
                    url: '/Dropdown/GetCustomerSearch',
                    type: 'GET',
                    dataType: 'json',
                    delay: 250,

                    data: function (params) {
                        return {
                            search: params.term || "",
                            page: params.page || 1
                        };
                    },

                    processResults: function (data, params) {

                        params.page = params.page || 1;

                        return {
                            results: data.data,
                            pagination: {
                                more: data.hasMore
                            }
                        };
                    },

                    cache: true
                }
            });
        }

        function loadCustomer_bk() {
            $.ajax({
                url: '/Dropdown/GetCustomer',
                type: 'GET',
                success: function (response) {

                    let $dropdown = $('#filterCustomer');
                    $dropdown.empty();
                    $dropdown.append('<option value="" selected disabled>Select Customer</option>');

                    $.each(response.data, function (i, item) {
                        $dropdown.append(
                            `<option value="${item.Id}">${item.CustomerName}</option>`
                        );
                    });
                }
            });
        }

        function clearForm() {

            $("#filterSection").find("input").val("");
            $("#filterSection").find("select").val("");

            var today = new Date();
            var firstDay = new Date(today.getFullYear(), today.getMonth(), 1);
            var lastDay = new Date(today.getFullYear(), today.getMonth() + 1, 0);
            
            $('#filterFromDate').val(formatDateFilter(firstDay));
            $('#filterToDate').val(formatDateFilter(lastDay));
        }

    </script>

}