@{
    ViewData["Title"] = "Job Report";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Head {
    <!-- DataTables -->
    <link href="~/assets/libs/datatables.net-bs4/css/dataTables.bootstrap4.min.css" rel="stylesheet" type="text/css" />
    <link href="~/assets/libs/datatables.net-buttons-bs4/css/buttons.bootstrap4.min.css" rel="stylesheet" type="text/css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/fixedheader/3.4.0/css/fixedHeader.dataTables.min.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/buttons/2.4.2/css/buttons.dataTables.min.css">



    <style>

    </style>
}

<div class="page-content">
    <div class="container-fluid">

        <!-- Page Title -->
        <div class="row">
            <div class="col-12">
                <div class="page-title-box d-sm-flex align-items-center justify-content-between">
                    <h4 class="mb-sm-0">Job Report</h4>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-body">

                        <!-- Filter Button -->
                        <div class="mb-3">
                            <button class="btn btn-info" type="button" data-bs-toggle="collapse" data-bs-target="#filterSection">
                                <i class="fa fa-filter"></i> Filter
                            </button>
                        </div>

                        <!-- Filter Section -->
                        <div class="collapse" id="filterSection">
                            <div class="card mb-3 p-3">

                                <div class="row mb-3">

                                    <div class="col-md-3">
                                        <select id="filterUsers" class="form-control select-my">
                                            <option value="">All Users</option>
                                            <option value="1">User 1</option>
                                            <option value="2">User 2</option>
                                        </select>
                                    </div>

                                    <!-- 📅 From Date -->
                                    <div class="col-md-3">
                                        <input type="date" id="filterFromDate" name="filterFromDate" class="form-control" placeholder="From Date">
                                    </div>

                                    <!-- 📅 To Date -->
                                    <div class="col-md-3">
                                        <input type="date" id="filterToDate" name="filterToDate" class="form-control" placeholder="To Date">
                                    </div>

                                    <!-- 🔎 B/L Number -->
                                    <div class="col-md-3">
                                        <input type="text" id="filterBLNumber" class="form-control" placeholder="B/L or Booking Number">
                                    </div>

                                </div>

                                <div class="row mb-3" style="display:none;">

                                    <div class="col-md-12 text-end">

                                        <button id="btnExportExcel" class="btn btn-success">
                                            Export Excel (.xlsx)
                                        </button>

                                        <button id="btnExportPdf" class="btn btn-danger">
                                            Export PDF
                                        </button>

                                    </div>

                                </div>

                                <div class="row">
                                    <div class="col-md-4 d-flex align-items-end">
                                        <button id="btnSearch" class="btn btn-primary me-2 w-50">Search</button>
                                        <button id="btnClear" class="btn btn-secondary w-50">Clear</button>
                                    </div>
                                </div>

                            </div>
                        </div>


                        <!-- Datatable -->

                        <div style="width: 100%; overflow-x: auto;">
                            <table id="datatable" class="table table-striped table-bordered nowrap align-middle" style="width:100%">
                                <thead>
                                    <tr>
                                        <th>Job No.</th>
                                        <th>User - Admin</th>
                                        <th>Cost Center</th>
                                        <th>Customer Name</th>
                                        <th>Carrier</th>
                                        <th>Job Opening Date</th>
                                        <th>Mode Of Shipment</th>
                                        <th>Type of Shipment</th>
                                        <th>Booking # / B/L Number</th>
                                        <th>POL</th>
                                        <th>POD</th>
                                        <th>Container Type</th>
                                        <th>Container Number</th>
                                        <th>ETD</th>
                                        <th>SI Received Date</th>
                                        <th>Manifest Receive</th>
                                        <th>B/L Status</th>
                                        <th>Sailed Date</th>
                                        <th>Total Job Amount</th>
                                        <th>Remarks</th>
                                    </tr>
                                </thead>
                            </table>
                        </div>


                        <div id="tableLoader" style="text-align:center;padding:40px;display:none;">
                            <div class="spinner-border text-primary"></div>
                            <div class="mt-2">Loading...</div>
                        </div>

                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

@section Script {

    <!-- Required datatable js -->
    <script src="~/assets/libs/datatables.net/js/jquery.dataTables.min.js"></script>
    <script src="~/assets/libs/datatables.net-bs4/js/dataTables.bootstrap4.min.js"></script>
    <script src="https://cdn.datatables.net/fixedheader/3.4.0/js/dataTables.fixedHeader.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/dataTables.buttons.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.html5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.print.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/pdfmake.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/vfs_fonts.js"></script>

    <script>

        $(document).ready(function () {

            loadUser();
            clearForm();

            // Search & Clear
            $("#btnSearch").click(function () {
                loadRecords();
            });

            $("#btnClear").click(function () {
                clearForm();
                loadRecords();
            });

            loadRecords();

        });

        function loadRecords() {

            if ($.fn.DataTable.isDataTable('#datatable')) {
                $('#datatable').DataTable().destroy();
            }

            $("#datatable").DataTable({
                processing: true,
                serverSide: true,
                paging: true,
                lengthChange: true,
                scrollX: false,
                autoWidth: false,
                responsive: false,
                pageLength: 100,
                order: [[0, "desc"]],
                searching: false,
                dom: 'Bfrtip',
                buttons: [
                {
                        extend: 'excelHtml5',
                        text: '📥 Export Excel',

                        title: function () {
                            const selectedUserName = getSelectedUserName();
                            return `Job Report - User: ${selectedUserName}`;
                        },

                        footer: true,

                        exportOptions: {
                            columns: ':visible'
                        },

                        customize: function (xlsx) {
                            const sheet = xlsx.xl.worksheets['sheet1.xml'];
                            const styles = xlsx.xl['styles.xml'];

                            const fonts = $('fonts', styles);
                            const cellXfs = $('cellXfs', styles);

                            const fontId = $('font', fonts).length;

                            fonts.append(
                                '<font>' +
                                    '<b/>' +
                                    '<sz val="16"/>' +
                                    '<name val="Calibri"/>' +
                                    '<family val="2"/>' +
                                '</font>'
                            );

                            fonts.attr('count', fontId + 1);

                            // New centered cell style
                            const styleId = $('xf', cellXfs).length;

                            cellXfs.append(
                                '<xf numFmtId="0" ' +
                                    'fontId="' + fontId + '" ' +
                                    'fillId="0" ' +
                                    'borderId="0" ' +
                                    'xfId="0" ' +
                                    'applyFont="1" ' +
                                    'applyAlignment="1">' +
                                    '<alignment horizontal="center" vertical="center"/>' +
                                '</xf>'
                            );

                            cellXfs.attr('count', styleId + 1);

                            // Apply style to the first row, which contains the title
                            $('row:first c', sheet).attr('s', styleId);

                            // Increase title row height
                            $('row:first', sheet)
                                .attr('ht', '26')
                                .attr('customHeight', '1');
                        }
                    },
                {
                    extend: 'pdfHtml5',
                    text: '📄 PDF',
                    title: '',
                    orientation: 'landscape',
                    pageSize: 'A4',
                    exportOptions: {
                        columns: ':visible:not(:last-child)'
                    },

                    customize: function (doc) {

                    doc.pageOrientation = 'landscape';
                    doc.pageSize = 'A4';

                    doc.defaultStyle = {
                        fontSize: 6
                    };

                    const selectedUserName = getSelectedUserName();
                    
                    const fromDate = formatReportDate($("#filterFromDate").val());
                    const toDate = formatReportDate($("#filterToDate").val());

                    doc.content.splice(0, 0, {
                        text: [
                            {
                                text: `Job Report - User: ${selectedUserName}`,
                                fontSize: 16,
                                bold: true
                            },
                            {
                                text: `\nFrom Date: ${fromDate} To Date: ${toDate}`,
                                fontSize: 10,
                                bold: true
                            }
                        ],
                        fontSize: 16,
                        bold: true,
                        alignment: "center",
                        margin: [0, 0, 0, 14]
                    });

            doc.pageMargins = [5, 10, 5, 10]; // 🔥 reduce margins

            var tableBody = doc.content[1].table.body;

            doc.content[1].table.widths = Array(tableBody[0].length)
                .fill('auto');

            // 🔥 prevent overflow issues
            doc.styles.tableHeader = {
                fontSize: 7,
                bold: true,
                alignment: 'left'
            };

            doc.content[1].layout = {
                hLineWidth: function () { return 0.5; },
                vLineWidth: function () { return 0.5; },
                hLineColor: function () { return '#ccc'; },
                vLineColor: function () { return '#ccc'; },
                paddingLeft: function () { return 2; },
                paddingRight: function () { return 2 },
                paddingTop: function () { return 1 },
                paddingBottom: function () { return 1 }
            };
        }
                }],
                ajax: {
                    url: "/Report/GetJobsReport",
                    type: "POST",
                    data: function (d) {
                        d.userId = $("#filterUsers").val();
                        d.fromDate = $("#filterFromDate").val();
                        d.toDate = $("#filterToDate").val();
                        d.blNumber = $("#filterBLNumber").val();
                        d.shipmentType = "";  //Import Jobs
                    }
                },

                columns: [
                    { data: "JobNo" },                  // Job Number
                    { data: "AssignedUser" },          // User - Admin
                    { data: "CostCenter" },
                    { data: "CustomerName" },
                    { data: "Carrier" },
                    { data: "JobDate" },               // Job Opening Date
                    { data: "ModeOfShipment" },
                    { data: "ShipmentTypeName" },          // Type of Shipment (NEW)
                    { data: "BLNumber" },              // Booking # / B/L Number
                    { data: "POL" },
                    { data: "POD" },
                    { data: "ContainerType" },
                    { data: "ContainerNo" },
                    { data: "ETD" },
                    { data: "SIReceivedDate" },
                    { data: "ManifestReceive" },
                    { data: "ShipmentStatus" },       // B/L Status
                    { data: "SailedDate" },
                    {
                        data: "TotalJobAmount",
                        className: "text-end",
                        render: function (data) {

                            let amount = parseFloat(data || 0);

                            return amount.toLocaleString(undefined, {
                                minimumFractionDigits: 2,
                                maximumFractionDigits: 2
                            });
                        }
                    },
                    { data: "Remarks" }

                ]
            });
        }

        function loadUser(selectedId = null) {
            $.ajax({
                url: '/Dropdown/GetUser',
                type: 'GET',
                dataType: 'json',
                success: function (response) {

                    let $dropdown = $('#filterUsers');
                    $dropdown.empty();
                    $dropdown.append('<option value="" selected>Select All User</option>');

                    $.each(response.data, function (i, item) {
                        $dropdown.append(
                            `<option value="${item.Id}">
                                ${item.UserName || item.UserId}
                            </option>`
                        );
                    });

                    // Set selected if ID provided
                    if (selectedId !== null && selectedId !== "" && selectedId !== undefined) {
                        $dropdown.val(selectedId);
                    }
                },
                error: function (xhr, status, error) {
                    console.error("Error loading user:", error);
                }
            });
        }

        function clearForm(){
            $("#filterSection").find("input").val("");
            $("#filterSection").find("select").val("");

            var today = new Date();
            var firstDay = new Date(today.getFullYear(), today.getMonth(), 1);
            var lastDay = new Date(today.getFullYear(), today.getMonth() + 1, 0);

            $('#filterFromDate').val(formatDateFilter(firstDay));
            $('#filterToDate').val(formatDateFilter(lastDay));
        }

        function getSelectedUserName() {
            const selectedUser =
                $("#filterUsers option:selected").text().trim();

            if (!selectedUser ||
                selectedUser.toLowerCase() === "all users" ||
                selectedUser.toLowerCase() === "select all user") {
                return "All";
            }

            return selectedUser;
        }

    </script>

}