@{
    ViewData["Title"] = "Sales Invoice";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Head {
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            background: #f5f7fb;
            font-size: 14px;
        }

        .invoice-wrapper {
            max-width: 1200px;
            margin: 30px auto;
            background: #fff;
            border-radius: 16px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.08);
            overflow: hidden;
        }

        .invoice-header {
            border-top: 6px solid #0d6efd;
            padding: 30px;
        }

        .company-title {
            font-size: 1.8rem;
            font-weight: 700;
            color: #1f2937;
        }

        .section-title {
            font-size: 1rem;
            font-weight: 700;
            margin-bottom: 12px;
            color: #0d6efd;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .info-card {
            border: 1px solid #dee2e6;
            border-radius: 12px;
            padding: 20px;
            height: 100%;
            background: #fff;
        }

        .table thead th {
            background: #0d6efd;
            color: #fff;
            border-color: #0d6efd;
            vertical-align: middle;
            white-space: nowrap;
        }

        .table tfoot th,
        .table tfoot td {
            background: #f8f9fa;
            font-weight: 600;
        }

        .summary-table td,
        .summary-table th {
            padding: 0.65rem 1rem;
        }

        .grand-total {
            background: #0d6efd !important;
            color: #fff;
        }

        .badge-status {
            font-size: 0.85rem;
            padding: 0.5rem 0.75rem;
        }

        /* ================= FOOTER SECTION ================= */

        .invoice-footer {
            font-family: inherit;
            font-size: 15px;
            color: #212529;
        }

        /* ================= REMARKS ================= */

        .remarks-title {
            display: inline-block;
            border-top: 1px solid #000;
            padding-top: 4px;
            font-size: 13px;
            font-weight: 600;
            min-width: 170px;
        }

        /* ================= BANK SECTION ================= */

        .bank-details {
            margin-top: 20px;
        }

        .bank-title {
            /* font-size: 34px; */
            font-weight: 500;
            margin-bottom: 18px;
            color: #212529;
        }

        /* Label + Value Row */

        .bank-row {
            display: flex;
            align-items: center;
            margin-bottom: 8px;
            font-size: 14px;
            line-height: 1.5;
        }

        /* LEFT LABEL */

        .bank-label {
            width: 130px;
            font-weight: 500;
            color: #212529;
        }

        /* CENTER COLON */

        .bank-separator {
            width: 20px;
            text-align: center;
            font-weight: 500;
        }

        /* RIGHT VALUE */

        .bank-value {
            flex: 1;
            font-weight: 400;
            color: #212529;
            word-break: break-word;
        }

        /* ================= NOTES ================= */

        .invoice-notes {
            margin-top: 25px;
            font-size: 14px;
            line-height: 1.6;
            color: #212529;
        }

        .invoice-notes strong {
            font-weight: 700;
        }

        /* ================= QR SECTION ================= */

        .qr-section {
            min-height: 260px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: flex-start;
        }

        .qr-section h5 {
            font-size: 20px;
            font-weight: 500;
            margin-bottom: 20px;
        }

        /* ================= FOOTER LINE ================= */

        .footer-line {
            height: 10px;
            background: #2d63c8;
            width: 100%;
            margin-top: 25px;
        }

        .arabic-text {
            direction: rtl;
            unicode-bidi: isolate;
            white-space: nowrap;
        }


    </style>
}



<div class="page-content" id="invoiceArea">

    <div class="container-fluid py-4">
        <div class="invoice-wrapper">
            <div class="invoice-header">
                <div class="row align-items-start g-4">
                    <div class="col-lg-6">
                        <h1 class="company-title mb-2">Hadia Global Logistics</h1>
                        <p class="mb-1 fw-semibold">ESTABLISHMENT HADIA GLOBAL LOGISTICS</p>
                        <p class="mb-1">8156 BAGHDADIA AL GHARBIYAH, JEDDAH</p>
                        <p class="mb-1">Kingdom of Saudi Arabia</p>
                        <p class="mb-0">VAT No: 3113041577000003</p>
                    </div>
                    <div class="col-lg-6 text-lg-end" dir="rtl" lang="ar">
                        <h2 class="fw-bold mb-2">مؤسسة هاديا غلوبل لوجيستكس</h2>
                        <p class="mb-1">8156 المدينة المنورة 4391 حي البغدادية الغربية جدة</p>
                        <p class="mb-1">المملكة العربية السعودية</p>
                        <p class="mb-0">رقم ضريبة القيمة المضافة: 3113041577000003</p>
                    </div>
                </div>

                <!-- ================= HEADER SECTION ================= -->

                <div class="row mt-4 align-items-center">

                    <div class="col-md-6"></div>

                    <div class="col-md-6 text-md-end">

                        <h2 class="fw-bold text-primary mb-2">
                            Sales Invoice / فاتورة مبيعات
                        </h2>

                        <div>
                            <strong>Invoice No:</strong>
                            <span id="lblInvoiceNo"></span>
                        </div>

                        <div>
                            <strong>Date:</strong>
                            <span id="lblInvoiceDate"></span>
                        </div>

                        <div>
                            <strong>Status:</strong>

                            <span id="lblStatus"
                                  class="badge bg-success badge-status">
                            </span>
                        </div>

                    </div>
                </div>



            </div>
        </div>
    </div>

    <!-- ================= CUSTOMER SECTION ================= -->
    <div class="p-4">
        <div class="row g-4 mb-4">
            <div class="col-md-6">
                <div class="info-card">
                    <div class="section-title">Buyer / Customer</div>

                    <h6 class="fw-bold mb-2" id="lblCustomerName"></h6>

                    <p class="mb-1" id="lblCustomerAddress"></p>

                    <p class="mb-1" id="lblCustomerCity"></p>

                    <p class="mb-0">
                        VAT:
                        <span id="lblCustomerVat"></span>
                    </p>
                </div>
            </div>

            <!-- ================= SHIPMENT SECTION ================= -->
            <div class="col-md-6">
                <div class="info-card">
                    <div class="section-title">Shipment Details</div>
                    <div class="row g-2">
                        <div class="col-6"><strong>Job Number:</strong></div>
                        <div class="col-6" id="lblJobNumber"></div>

                        <div class="col-6"><strong>Mode of Shipment:</strong></div>
                        <div class="col-6" id="lblShipmentMode"></div>

                        <div class="col-6"><strong>Type of Shipment:</strong></div>
                        <div class="col-6" id="lblShipmentType"></div>

                        <div class="col-6"><strong>POL:</strong></div>
                        <div class="col-6" id="lblPOL"></div>

                        <div class="col-6"><strong>POD:</strong></div>
                        <div class="col-6" id="lblPOD"></div>

                        <div class="col-6"><strong>B/L Number:</strong></div>
                        <div class="col-6" id="lblBLNumber"></div>

                        <div class="col-6"><strong>Payment Terms:</strong></div>
                        <div class="col-6">Prepaid</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ================= DETAILS TABLE ================= -->
        <div class="table-responsive mb-4">
            <table class="table table-bordered align-middle">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Payment Type</th>
                        <th>Invoice Detail</th>
                        <th class="text-center">Unit</th>
                        <th class="text-center">Qty</th>
                        <th class="text-end">Rate</th>
                        <th class="text-end">Amount</th>
                        <th class="text-end vatPercentDisplay">VAT</th>
                        <th class="text-end">Total Amount</th>
                    </tr>
                </thead>
                <tbody id="invoiceDetailsBody"></tbody>
            </table>
        </div>

        <div class="row g-4">
            <div class="col-lg-7">
                <div class="info-card">
                    <div class="section-title">Amount in Words</div>
                    <p class="mb-0 fw-semibold" id="lblAmountInWords">Eight Thousand Three Hundred Six and 00/100 Saudi Riyals Only</p>
                </div>
            </div>

            <div class="col-lg-5">
                <table class="table table-bordered summary-table mb-0">
                    <tr>
                        <th>Total</th>
                        <td class="text-end" id="lblTotalAmount"></td>
                    </tr>
                    <tr>
                        <th>Advance</th>
                        <td class="text-end" id="lblAdvance"></td>
                    </tr>
                    <tr>
                        <th>Discount</th>
                        <td class="text-end" id="lblDiscount"></td>
                    </tr>
                    <tr>
                        <th>Net Amount</th>
                        <td class="text-end" id="lblNetAmount"></td>
                    </tr>
                    <tr>
                        <th>VAT Amount</th>
                        <td class="text-end" id="lblVatAmount"></td>
                    </tr>
                    <tr class="grand-total">
                        <th>Grand Total</th>
                        <td class="text-end fw-bold" id="lblGrandTotal"></td>
                    </tr>
                </table>
            </div>
        </div>


        <div class="row g-4 mt-1">

            <div class="col-lg-12">
                <div class="info-card">
                    <!-- ================= FOOTER SECTION ================= -->

                    <div class="invoice-footer mt-5">

                        <div class="row">

                            <!-- LEFT -->
                            <div class="col-lg-7">

                                <!-- Remarks -->
                                <div class="remarks-title">

                                    Remarks - ملاحظات

                                </div>

                                <!-- BANK DETAILS -->
                                <div class="bank-details">

                                    <h5 class="bank-title">

                                        OUR BANK A/C DETAILS

                                    </h5>

                                    <!-- ROW -->
                                    <div class="bank-row">

                                        <div class="bank-label">
                                            A/c NO
                                        </div>

                                        <div class="bank-separator">
                                            :
                                        </div>

                                        <div class="bank-value" id="lblAccountNo">
                                            1234567890
                                        </div>

                                    </div>

                                    <!-- ROW -->
                                    <div class="bank-row">

                                        <div class="bank-label">
                                            A/c TITLE
                                        </div>

                                        <div class="bank-separator">
                                            :
                                        </div>

                                        <div class="bank-value" id="lblAccountTitle">
                                            HADIA GLOBAL LOGISTICS
                                        </div>

                                    </div>

                                    <!-- ROW -->
                                    <div class="bank-row">

                                        <div class="bank-label">
                                            BANK
                                        </div>

                                        <div class="bank-separator">
                                            :
                                        </div>

                                        <div class="bank-value" id="lblBankName">
                                            Al Rajhi Bank
                                        </div>

                                    </div>

                                    <!-- ROW -->
                                    <div class="bank-row">

                                        <div class="bank-label">
                                            BRANCH
                                        </div>

                                        <div class="bank-separator">
                                            :
                                        </div>

                                        <div class="bank-value" id="lblBranch">
                                            Jeddah Branch
                                        </div>

                                    </div>

                                    <!-- ROW -->
                                    <div class="bank-row">

                                        <div class="bank-label">
                                            SWIFT CODE
                                        </div>

                                        <div class="bank-separator">
                                            :
                                        </div>

                                        <div class="bank-value" id="lblSwiftCode">
                                            RJHISARI
                                        </div>

                                    </div>

                                    <!-- ROW -->
                                    <div class="bank-row">

                                        <div class="bank-label">
                                            IBAN CODE
                                        </div>

                                        <div class="bank-separator">
                                            :
                                        </div>

                                        <div class="bank-value" id="lblIbanCode">
                                            SA0380000000608010167519
                                        </div>

                                    </div>

                                </div>

                                <!-- NOTES -->
                                <div class="invoice-notes">

                                    <p class="mb-2 d-flex align-items-start gap-2 flex-nowrap">

                                        <span class="text-nowrap">
                                            This is a computer-generated invoice and does not require a signature or stamp.
                                        </span>

                                        <span class="text-nowrap arabic-text" dir="rtl">
                                            هذه فاتورة إصدار آلي ولا تتطلب توقيعًا أو ختمًا
                                        </span>

                                    </p>

                                    <p class="mb-2">

                                        Any discrepancy must be reported within
                                        <strong>7 days</strong>
                                        from the date of the invoice; otherwise,
                                        it will be deemed as
                                        <strong>confirmation of correctness.</strong>

                                    </p>

                                    <p class="mb-0">

                                        Print Date & Time :
                                        <span id="lblPrintDateTime"></span>

                                    </p>

                                </div>

                            </div>

                            <!-- RIGHT -->
                            <div class="col-lg-5">

                                <div class="qr-section">

                                    <h5>

                                        QR Code

                                    </h5>

                                    <div id="qrcode"></div>

                                </div>

                            </div>

                        </div>

                        <!-- BLUE LINE -->
                        <div class="footer-line"></div>

                    </div>
                </div>
            </div>

        </div>


    </div>

</div>




<div id="globalLoader" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%;
background:rgba(0,0,0,0.4); z-index:9999; text-align:center; padding-top:20%;">

    <div class="spinner-border text-light" role="status"></div>
    <div style="color:white; margin-top:10px;">Loading...</div>
</div>

@section Script {
    
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>

    <script>

        var Id = parseInt('@ViewBag.Id') || 0;
        loadInvoice(Id);

        var vatPercentDisplay = 0;

        function loadInvoice(invoiceId) {

             // 🔥 SHOW LOADER + DISABLE SCREEN
            $("#globalLoader").show();

            $.ajax({

                url: '/Invoice/GetSalesInvoiceById',

                type: 'GET',

                data: { invoiceId: invoiceId },

                success: function (response) {

                    console.log(response);

                    if (response.errorCode === 404) {
                        showMessage && showMessage("Record not found", "error");
                        return;
                    }

                    let invoice = response.invoice;
                    let details = response.details;

                    // ================= HEADER =================

                    $('#lblInvoiceNo').text(invoice.InvoiceNo);

                    $('#lblInvoiceDate')
                        .text(formatDate(invoice.InvoiceDate));

                    $('#lblStatus').text(invoice.Status);

                    // ================= CUSTOMER =================

                    $('#lblCustomerName')
                        .text(invoice.CustomerName);

                    $('#lblCustomerAddress')
                        .text(invoice.CustomerAddress);

                    $('#lblCustomerCity')
                        .text(invoice.RegionName + ', ' + invoice.CountryName);

                    $('#lblCustomerVat')
                        .text(invoice.CustomerVat);

                    // ================= SHIPMENT =================

                    $('#lblJobNumber')
                        .text(invoice.JobNumber);

                    $('#lblShipmentMode')
                        .text(invoice.ModeOfShipment);

                    $('#lblShipmentType')
                        .text(invoice.ShipmentType);

                    $('#lblPOL')
                        .text(invoice.POL);

                    $('#lblPOD')
                        .text(invoice.POD);

                    $('#lblBLNumber')
                        .text(invoice.BLNumber);

                    // ================= DETAILS =================

                    let tbody = $('#invoiceDetailsBody');

                    tbody.empty();

                    $.each(details, function (i, item) {


                        if (item.VatPercent > 0 && vatPercentDisplay === 0) {
                            vatPercentDisplay = item.VatPercent;
                        }

                        let row = `

                            <tr>

                                <td>${i + 1}</td>

                                <td>${item.PaymentType}</td>

                                <td>${item.InvoiceDetail}</td>

                                <td class="text-center">${item.Unit}</td>

                                <td class="text-center">${item.Qty}</td>

                                <td class="text-end">
                                    ${formatCurrency(item.Rate)}
                                </td>

                                <td class="text-end">
                                    ${formatCurrency(item.Amount)}
                                </td>

                                <td class="text-end">
                                    ${formatCurrency(item.VatAmount)}
                                </td>

                                <td class="text-end">
                                    ${formatCurrency(item.TotalAmount)}
                                </td>

                            </tr>
                        `;

                        tbody.append(row);

                    });
                    
                    // ================= SUMMARY =================

                    $('#lblTotalAmount')
                        .text(formatCurrency(invoice.TotalAmount));

                    $('#lblAdvance')
                        .text(formatCurrency(invoice.Advance));

                    $('#lblDiscount')
                        .text(formatCurrency(invoice.Discount));

                    $('#lblNetAmount')
                        .text(formatCurrency(invoice.NetAmount));

                    $('#lblVatAmount')
                        .text(formatCurrency(invoice.VatAmount));

                    $('#lblGrandTotal')
                        .text(formatCurrency(invoice.GrandTotal));

                    // ================= AMOUNT IN WORDS =================

                    $('#lblAmountInWords')
                        .text(invoice.AmountInWords);


                    $('#lblPrintDateTime').text(
                        new Date().toLocaleString()
                    );

                    $(".vatPercentDisplay").text(vatPercentDisplay + "% VAT");

                    // ================= BANK DETAILS =================
                    

                },
                error: function () {
                    showMessage && showMessage("An error occurred while fetching job details.", "error");
                },
                complete: function () {

                    // 🔥 HIDE LOADER + ENABLE SCREEN
                    $("#globalLoader").hide();
                }

            });
        }
        
    </script>



}