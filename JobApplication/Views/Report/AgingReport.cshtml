@{
    ViewData["Title"] = "Aging Report";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Head {

    <!-- DataTables -->
    <link href="~/assets/libs/datatables.net-bs4/css/dataTables.bootstrap4.min.css" rel="stylesheet" type="text/css" />
    <link href="~/assets/libs/datatables.net-buttons-bs4/css/buttons.bootstrap4.min.css" rel="stylesheet" type="text/css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/fixedheader/3.4.0/css/fixedHeader.dataTables.min.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/buttons/2.4.2/css/buttons.dataTables.min.css">
    <link href="~/assets/libs/select2/css/select2.min.css" rel="stylesheet" type="text/css">
    
}

<div class="page-content">
    <div class="container-fluid">

        <!-- Page Title -->
        <div class="row">
            <div class="col-12">
                <div class="page-title-box d-sm-flex align-items-center justify-content-between">
                    <h4 class="mb-sm-0">Aging Report</h4>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-body">

                        <!-- Filter Button -->
                        <div class="mb-3">
                            <button class="btn btn-info" type="button" data-bs-toggle="collapse" data-bs-target="#filterSection">
                                <i class="fa fa-filter"></i> Filter
                            </button>
                        </div>

                        <!-- Filter Section -->
                        <div class="collapse" id="filterSection">
                            <div class="card mb-3 p-3">

                                <div class="row mb-3">

                                    <div class="col-md-3">
                                        <select id="filterAgingType" class="form-control">
                                            <option value="sales" selected>Receivables (Sales)</option>
                                            <option value="purchase">Payables (Purchase)</option>
                                        </select>
                                    </div>

                                    <div class="col-md-3">
                                        <select id="filterParty" class="form-control select-my">
                                            <option value="" selected disabled>Select Customer / Service Provider</option>
                                        </select>
                                    </div>

                                    <div class="col-md-3">
                                        <select id="filterCostCenter" class="form-control select-my">
                                            <option value="" selected disabled>Select Cost Centers</option>
                                        </select>
                                    </div>

                                    <div class="col-md-3">
                                        <input type="date" id="filterAsOfDate" class="form-control" placeholder="As Of Date">
                                    </div>

                                </div>

                                <div class="row">
                                    <div class="col-md-4 d-flex align-items-end">
                                        <button id="btnSearch" class="btn btn-primary me-2 w-50">Search</button>
                                        <button id="btnClear" class="btn btn-secondary w-50">Clear</button>
                                    </div>
                                </div>

                            </div>
                        </div>


                        <!-- Datatable -->
                        <div style="width: 100%; overflow-x: auto;">
                            <table id="datatable" class="table table-striped table-bordered nowrap align-middle" style="width:100%">
                                <thead>
                                    <tr>
                                        <th>Invoice No</th>
                                        <th>Invoice Date</th>
                                        <th>Customer / Service Provider</th>
                                        <th>Job Number</th>
                                        <th>B/L Number</th>
                                        <th>Age (Days)</th>
                                        <th>Current (0-30)</th>
                                        <th>31-60</th>
                                        <th>61-90</th>
                                        <th>90+</th>
                                        <th>Balance Total</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>

                                <tfoot>
                                    <tr class="fw-bold text-nowrap">
                                        <th></th>
                                        <th></th>
                                        <th></th>
                                        <th></th>
                                        <th></th>
                                        <th></th>
                                        <th class="text-end"></th>
                                        <th class="text-end"></th>
                                        <th class="text-end"></th>
                                        <th class="text-end"></th>
                                        <th class="text-end"></th>
                                        <th></th>
                                    </tr>
                                </tfoot>

                            </table>
                        </div>


                        <div id="tableLoader" style="text-align:center;padding:40px;display:none;">
                            <div class="spinner-border text-primary"></div>
                            <div class="mt-2">Loading...</div>
                        </div>

                    </div>
                </div>
            </div>
        </div>

    </div>
</div>



@section Script {

    <!-- Required datatable js -->
    <script src="~/assets/libs/datatables.net/js/jquery.dataTables.min.js"></script>
    <script src="~/assets/libs/datatables.net-bs4/js/dataTables.bootstrap4.min.js"></script>
    <script src="https://cdn.datatables.net/fixedheader/3.4.0/js/dataTables.fixedHeader.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/dataTables.buttons.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.html5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.print.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/pdfmake.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/vfs_fonts.js"></script>
    <script src="~/assets/libs/select2/js/select2.min.js"></script>

    <script>

        var reportCompanyName = "Company";
        var reportCompanyNameAr = "";

        $(document).ready(function () {

            $("#filterAsOfDate").val(formatDateFilter(new Date()));

            loadCostCenter();
            loadParty();

            // Party / type change
            $("#filterAgingType").change(function () {
                $("#filterParty").val("").trigger("change");
                loadParty();
            });

            // Search & Clear
            $("#btnSearch").click(function () {
                loadRecords(true);
            });

            $("#btnClear").click(function () {
                clearForm();
                loadRecords(true);
            });

            loadCompanyNames().always(function () {
                loadRecords(true);
            });

        });

        function loadRecords(isFilterApplied = false) {

            // destroy if already exists
            if ($.fn.DataTable.isDataTable('#datatable')) {
                $('#datatable').DataTable().destroy();
                $('#datatable tbody').empty();
            }

            $("#datatable").DataTable({

                processing: true,
                serverSide: true,
                paging: true,
                lengthChange: true,
                scrollX: false,
                autoWidth: false,
                responsive: false,
                pageLength: 100,
                order: [[0, "desc"]],
                searching: false,
                dom: 'Bfrtip',

                buttons: [
                    {
                        extend: 'excelHtml5',
                        text: '📥 Export Excel',

                        title: function () {
                            const typeName = $("#filterAgingType option:selected").text().trim();
                            const partyName = $("#filterParty option:selected").text().trim() || "All";
                            return `${typeName} - ${partyName} (${reportCompanyName})`;
                        },

                        footer: true,

                        exportOptions: {
                            columns: ':visible'
                        },

                        customize: function (xlsx) {
                            const sheet = xlsx.xl.worksheets['sheet1.xml'];
                            const styles = xlsx.xl['styles.xml'];

                            const fonts = $('fonts', styles);
                            const cellXfs = $('cellXfs', styles);

                            const fontId = $('font', fonts).length;

                            fonts.append(
                                '<font>' +
                                    '<b/>' +
                                    '<sz val="16"/>' +
                                    '<name val="Calibri"/>' +
                                    '<family val="2"/>' +
                                '</font>'
                            );

                            fonts.attr('count', fontId + 1);

                            // New centered cell style
                            const styleId = $('xf', cellXfs).length;

                            cellXfs.append(
                                '<xf numFmtId="0" ' +
                                    'fontId="' + fontId + '" ' +
                                    'fillId="0" ' +
                                    'borderId="0" ' +
                                    'xfId="0" ' +
                                    'applyFont="1" ' +
                                    'applyAlignment="1">' +
                                    '<alignment horizontal="center" vertical="center"/>' +
                                '</xf>'
                            );

                            cellXfs.attr('count', styleId + 1);

                            // Apply style to the first row, which contains the title
                            $('row:first c', sheet).attr('s', styleId);

                            // Increase title row height
                            $('row:first', sheet)
                                .attr('ht', '26')
                                .attr('customHeight', '1');
                        }
                    },
                    {
                        extend: 'pdfHtml5',
                        text: '📄 PDF',
                        orientation: 'landscape',
                        pageSize: 'A4',
                        footer: true,
                        title: '',
                        exportOptions: {
                            columns: ':visible'
                        },
                        customize: function(doc) {

                            // ========== Fonts ==========
                            pdfMake.fonts = {
                                Roboto: {
                                    normal: 'https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.66/fonts/Roboto/Roboto-Regular.ttf',
                                    bold: 'https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.66/fonts/Roboto/Roboto-Medium.ttf'
                                },
                                Amiri: {
                                    normal: 'https://raw.githack.com/google/fonts/main/ofl/amiri/Amiri-Regular.ttf',
                                    bold: 'https://raw.githack.com/google/fonts/main/ofl/amiri/Amiri-Bold.ttf'
                                }
                            };

                            doc.pageOrientation = 'landscape';
                            doc.pageSize = 'A4';
                            doc.pageMargins = [5, 15, 5, 10];

                            // Default style
                            doc.defaultStyle = {
                                font: 'Amiri',
                                fontSize: 7
                            };

                            doc.styles.tableHeader = {
                                font: 'Amiri',
                                fontSize: 7,
                                bold: true,
                                alignment: 'left'
                            };

                            // ========== Filters Data ==========
                            const typeName = $("#filterAgingType option:selected").text().trim();
                            const partyName = $("#filterParty option:selected").text().trim() || "All";
                            const asOfDate = $("#filterAsOfDate").val() || "All";
                            const formattedAsOfDate = formatReportDate(asOfDate);

                            // ========== Arabic Fix Function ==========
                            function fixArabic(text) {
                                if (!text) return "";
                                if (/[\u0600-\u06FF]/.test(text)) {
                                    return text.split(' ').reverse().join(' ');
                                }
                                return text;
                            }

                            // ========== Header ==========
                            var headerTextArray = [
                                {
                                    text: `Aging Report - ${typeName} - ${partyName} (${reportCompanyName} `,
                                    fontSize: 13,
                                    bold: true
                                }
                            ];

                            if (reportCompanyNameAr) {
                                headerTextArray.push({
                                    text: fixArabic(reportCompanyNameAr),
                                    fontSize: 13,
                                    bold: true,
                                    font: 'Amiri'
                                });
                            }

                            headerTextArray.push(
                                {
                                    text: `)\n`,
                                    fontSize: 13,
                                    bold: true
                                },
                                {
                                    text: `As Of Date: ${formattedAsOfDate}`,
                                    fontSize: 11,
                                    bold: true
                                }
                            );

                            // Header inject
                            doc.content.splice(0, 0, {
                                text: headerTextArray,
                                alignment: 'center',
                                margin: [0, 0, 0, 12]
                            });

                            // ========== Table Body Arabic Fix ==========
                            var tableBody = doc.content[1].table.body;

                            for (var i = 0; i < tableBody.length; i++) {
                                for (var j = 0; j < tableBody[i].length; j++) {
                                    var cell = tableBody[i][j];
                                    var cellText = (typeof cell === 'object' && cell !== null && cell.text !== undefined)
                                        ? cell.text
                                        : cell;

                                    if (typeof cellText === 'string') {
                                        var fixedText = fixArabic(cellText);

                                        if (typeof cell === 'object' && cell !== null) {
                                            cell.text = fixedText;
                                            cell.font = 'Amiri';
                                            cell.alignment = 'right';
                                        } else {
                                            tableBody[i][j] = {
                                                text: fixedText,
                                                font: 'Amiri',
                                                alignment: 'right'
                                            };
                                        }
                                    }
                                }
                            }

                            // Table widths
                            doc.content[1].table.widths = Array(tableBody[0].length).fill('auto');

                            // Table layout
                            doc.content[1].layout = {
                                hLineWidth: function() { return 0.5; },
                                vLineWidth: function() { return 0.5; },
                                hLineColor: function() { return '#ccc'; },
                                vLineColor: function() { return '#ccc'; },
                                paddingLeft: function() { return 2; },
                                paddingRight: function() { return 2; },
                                paddingTop: function() { return 1; },
                                paddingBottom: function() { return 1; }
                            };
                        }
                    }
                ],

                // 🔥 page load per empty table
                deferLoading: isFilterApplied ? null : 0,

                footerCallback: function (row, data, start, end, display) {

                    var api = this.api();

                    function parseValue(value) {
                        if (typeof value === 'string') {
                            return parseFloat(value.replace(/,/g, '')) || 0;
                        }

                        return typeof value === 'number' ? value : 0;
                    }

                    function total(columnIndex) {
                        return api
                            .column(columnIndex, { page: 'current' })
                            .data()
                            .reduce(function (a, b) {
                                return parseValue(a) + parseValue(b);
                            }, 0);
                    }

                    $(api.column(6).footer()).html(formatAmount(total(6)));
                    $(api.column(7).footer()).html(formatAmount(total(7)));
                    $(api.column(8).footer()).html(formatAmount(total(8)));
                    $(api.column(9).footer()).html(formatAmount(total(9)));
                    $(api.column(10).footer()).html(formatAmount(total(10)));
                },

                ajax: {
                    url: "/Report/GetAgingReport",
                    type: "POST",
                    data: function (d) {

                        d.type = $("#filterAgingType").val();
                        d.partyId = $("#filterParty").val();
                        d.costCenterId = $("#filterCostCenter").val();
                        d.asOfDate = $("#filterAsOfDate").val();

                        d.orderColumn = d.columns[d.order[0].column].data;
                        d.orderDir = d.order[0].dir;
                    }
                },

                columns: [

                    { data: "InvoiceNo", defaultContent: "" },

                    {
                        data: "InvoiceDate",
                        defaultContent: "",
                        render: function (data) {
                            return data ? formatDate(data) : "";
                        }
                    },

                    { data: "PartyName", defaultContent: "" },

                    { data: "JobNo", defaultContent: "" },

                    { data: "BlNo", defaultContent: "" },

                    {
                        data: "AgeDays",
                        className: "text-center",
                        defaultContent: ""
                    },

                    {
                        data: "Current",
                        className: "text-end",
                        defaultContent: "",
                        render: function (data) {
                            return data ? formatAmount(data) : "";
                        }
                    },

                    {
                        data: "Days31_60",
                        className: "text-end",
                        defaultContent: "",
                        render: function (data) {
                            return data ? formatAmount(data) : "";
                        }
                    },

                    {
                        data: "Days61_90",
                        className: "text-end",
                        defaultContent: "",
                        render: function (data) {
                            return data ? formatAmount(data) : "";
                        }
                    },

                    {
                        data: "Days90Plus",
                        className: "text-end",
                        defaultContent: "",
                        render: function (data) {
                            return data ? formatAmount(data) : "";
                        }
                    },

                    {
                        data: "Total",
                        className: "text-end",
                        defaultContent: "",
                        render: function (data) {
                            return data ? formatAmount(data) : "";
                        }
                    },

                    { data: "Status", defaultContent: "" }
                ]

            });
        }


        function loadCostCenter(selectedId = null) {
            $.ajax({
                url: '/Dropdown/GetCostCenter',
                type: 'GET',
                dataType: 'json',
                success: function (response) {

                    let $dropdown = $('#filterCostCenter');

                    $dropdown.empty();
                    $dropdown.append('<option value="" selected>Select All</option>');

                    $.each(response.data, function (i, item) {
                        $dropdown.append(
                            `<option value="${item.Id}">
                                        ${item.CostCenterName} (${item.CostCenterCode})
                                    </option>`
                        );
                    });

                    // Destroy previous Select2 (important for reload cases)
                    if ($dropdown.hasClass("select2-hidden-accessible")) {
                        $dropdown.select2('destroy');
                    }

                    // Initialize Select2
                    $dropdown.select2({
                        placeholder: "Select Cost Center",
                        allowClear: true,
                        width: '100%'
                    });

                    // Set selected value
                    if (selectedId) {
                        $dropdown.val(selectedId).trigger('change');
                    }
                },
                error: function (xhr, status, error) {
                    console.error("Error loading cost centers:", error);
                }
            });
        }

        function loadParty() {
            var type = $("#filterAgingType").val();
            var url = "/Dropdown/GetCustomer";

            if (type === "purchase") {
                url = "/Dropdown/GetServiceProvider";
            }

            $.ajax({
                url: url,
                type: 'GET',
                dataType: 'json',
                success: function (response) {

                    let $dropdown = $('#filterParty');

                    $dropdown.empty();
                    $dropdown.append('<option value="" selected>All</option>');

                    $.each(response.data, function (i, item) {
                        $dropdown.append(
                            `<option value="${item.Id}">${item.CustomerName}</option>`
                        );
                    });

                    // Destroy previous Select2 (important for reload cases)
                    if ($dropdown.hasClass("select2-hidden-accessible")) {
                        $dropdown.select2('destroy');
                    }

                    // Initialize Select2
                    $dropdown.select2({
                        placeholder: "Select Customer / Service Provider",
                        allowClear: true,
                        width: '100%'
                    });
                },
                error: function (xhr, status, error) {
                    console.error("Error loading parties:", error);
                }
            });
        }

        function loadCompanyNames() {
            return $.ajax({
                url: "/Report/GetCompanyNames",
                type: "GET",
                dataType: "json",
                success: function(response) {
                    if (response.errorCode === 200) {
                        // Separately store English and Arabic names
                        reportCompanyName = response.companyName || "";
                        reportCompanyNameAr = response.companyNameAr || "";

                        if (!reportCompanyName && !reportCompanyNameAr) {
                            reportCompanyName = "Company";
                        }
                    }
                },
                error: function() {
                    reportCompanyName = "Company";
                    reportCompanyNameAr = "";
                }
            });
        }

        function clearForm(){
            $("#filterSection").find("input").val("");
            $("#filterSection").find("select").val("");

            $("#filterAgingType").val("sales");
            $("#filterAsOfDate").val(formatDateFilter(new Date()));
            loadParty();
        }

         // Arabic Text & RTL Processing Helper Function
        // Pure JS Arabic Reshaper Engine (No CDN Needed)
        function fixArabic(text) {
            if (!text) return "";

            // Agar Arabic hai to sirf words reverse karo
            if (/[\u0600-\u06FF]/.test(text)) {
                return text.split(' ').reverse().join(' ');
            }

            return text;
        }

    </script>

}