@inject BusinessLogic.Interfaces.ISessionHelper SessionHelper
@{
    ViewData["Title"] = "Unauthorized Access";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="page-content">
    <div class="container-fluid">
        <div class="row justify-content-center">
            <div class="col-12 col-md-8 col-lg-6">
                <div class="card">
                    <div class="card-body p-5 text-center">
                        <div class="mb-4">
                            <i class="ri-lock-2-line text-danger" style="font-size: 5rem;"></i>
                        </div>
                        <h2 class="text-danger mb-3">Unauthorized Access</h2>
                        <p class="text-muted mb-1">You do not have permission to access this page.</p>
                        <p class="text-muted mb-4">If you believe this is a mistake, please contact your administrator.</p>
                        <a href="@(SessionHelper.UserType == 1 ? "/Dashboard/SuperAdmin" : "/Dashboard/Index")" class="btn btn-primary px-4">
                            <i class="ri-dashboard-line me-1"></i> Go to Dashboard
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>