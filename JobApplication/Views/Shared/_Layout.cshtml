                </div>

                <div class="mb-2">
                    <img src="~/assets/images/layouts/layout-2.jpg" class="img-fluid img-thumbnail" alt="layout-2">
                </div>
                <div class="form-check form-switch mb-3">
                    <input class="form-check-input theme-choice" type="checkbox" id="dark-mode-switch" data-bsStyle="~/assets/css/bootstrap.min.css" data-appStyle="assets/css/app.min.css">
                    <label class="form-check-label" for="dark-mode-switch">Dark Mode</label>
                </div>

                <div class="mb-2">
                    <img src="~/assets/images/layouts/layout-3.jpg" class="img-fluid img-thumbnail" alt="layout-3">
                </div>
                <div class="form-check form-switch mb-5">
                    <input class="form-check-input theme-choice" type="checkbox" id="rtl-mode-switch" data-appStyle="~/assets/css/app-rtl.min.css">
                    <label class="form-check-label" for="rtl-mode-switch">RTL Mode</label>
                </div>


            </div>

        </div> <!-- end slimscroll-menu-->
    </div>
    <!-- Right Sidebar End -->

    <!-- Right bar overlay-->
    <div class="rightbar-overlay"></div>


    <!-- Javascripts -->
    <script src="~/assets/libs/jquery/jquery.min.js"></script>
    <script src="~/assets/libs/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/assets/libs/metismenu/metisMenu.min.js"></script>
    <script src="~/assets/libs/simplebar/simplebar.min.js"></script>
    <script src="~/assets/libs/node-waves/waves.min.js"></script>

    <!-- form mask -->
    <script src="~/assets/libs/inputmask/jquery.inputmask.min.js"></script>

    <!-- form mask init -->
    <script src="~/assets/js/pages/form-mask.init.js"></script>

    <!-- Moment JS (must be above DataTables date plugins if used) -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/moment.js/2.29.4/moment.min.js"></script>

    <!-- Datatable init js -->
    <script src="~/assets/js/pages/datatables.init.js"></script>

    <script src="~/assets/js/app.js"></script>
    
    <!-- Sweet Alerts js -->
    <script src="~/assets/libs/sweetalert2/sweetalert2.min.js"></script>
    <script src="//cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/js/toastr.min.js" asp-append-version="true"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery.mask/1.14.16/jquery.mask.min.js"></script>

    <!-- Custom js -->
    <script src="~/assets/js/custom.js"></script>

    <script>
        n(document).ready(function () {
            var e;
            0 < n("#sidebar-menu").length &&
                0 < n("#sidebar-menu .mm-active .active").length &&
                300 < (e = n("#sidebar-menu .mm-active .active").offset().top) &&
                ((e -= 300), n(".vertical-menu .simplebar-content-wrapper").animate({ scrollTop: e }, "slow"));

            // NAYA CODE: Page load hotay sath hi check karein ke user ne pehle collapse kiya tha ya nahi
            if (sessionStorage.getItem("sidebar-collapsed") === "true" && 992 <= n(window).width()) {
                n("body").addClass("vertical-collpsed");
            }
        }),
    </script>

    <script>
        
        // 1. DataTables global core defaults injection
        if (typeof window.DataTable !== 'undefined') {
            window.DataTable.defaults.errMode = 'none';
        }

        document.addEventListener("DOMContentLoaded", function() {
            if (window.$ && $.fn && $.fn.dataTable) {
                $.fn.dataTable.ext.errMode = 'none';
                $.extend(true, $.fn.dataTable.defaults, {
                    ajax: {
                        error: function (xhr, textStatus, errorThrown) {
                            if (xhr.status === 401) {
                                return true;
                            }
                        }
                    }
                });
            }
        });

        // 2. Pure JavaScript AJAX Interceptor
        (function() {
            var open = XMLHttpRequest.prototype.open;
            XMLHttpRequest.prototype.open = function() {
                this.addEventListener("readystatechange", function() {
                    if (this.readyState === 4 && this.status === 401) {

                        if (window.$ && $.fn && $.fn.dataTable) {
                            $.fn.dataTable.ext.errMode = 'none';
                        }

                        handleSessionExpired();

                        // Immediately login page par bhejien bina history chore
                       // window.location.replace('/Home/Login');
                    }
                }, false);
                open.apply(this, arguments);
            };
        })();

        // 3. Logout function
        document.addEventListener("DOMContentLoaded", function() {
            var logoutBtn = document.getElementById("Logout");
            if (logoutBtn) {
                logoutBtn.addEventListener("click", function(e) {
                    e.preventDefault();
                    fetch('/Account/logout', { method: 'POST' })
                        .then(() => { window.location.href = "/Home/Login"; });
                });
            }
        });
    </script>
