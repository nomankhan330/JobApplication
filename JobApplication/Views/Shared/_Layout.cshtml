    <script>
        
        // 1. DataTables global core defaults injection
        if (typeof window.DataTable !== 'undefined') {
            window.DataTable.defaults.errMode = 'none';
        }

        document.addEventListener("DOMContentLoaded", function() {
            if (window.$ && $.fn && $.fn.dataTable) {
                $.fn.dataTable.ext.errMode = 'none';
                $.extend(true, $.fn.dataTable.defaults, {
                    ajax: {
                        error: function (xhr, textStatus, errorThrown) {
                            if (xhr.status === 401) {
                                return true;
                            }
                        }
                    }
                });
            }
        });

        // 2. Pure JavaScript AJAX Interceptor
        (function() {
            var open = XMLHttpRequest.prototype.open;
            XMLHttpRequest.prototype.open = function() {
                this.addEventListener("readystatechange", function() {
                    if (this.readyState === 4 && this.status === 401) {

                        if (window.$ && $.fn && $.fn.dataTable) {
                            $.fn.dataTable.ext.errMode = 'none';
                        }

                        handleSessionExpired();

                        // Immediately login page par bhejien bina history chore
                       // window.location.replace('/Home/Login');
                    }
                }, false);
                open.apply(this, arguments);
            };
        })();

        // 3. Logout function
        document.addEventListener("DOMContentLoaded", function() {
            var logoutBtn = document.getElementById("Logout");
            if (logoutBtn) {
                logoutBtn.addEventListener("click", function(e) {
                    e.preventDefault();
                    fetch('/Account/logout', { method: 'POST' })
                        .then(() => { window.location.href = "/Home/Login"; });
                });
            }
        });
    </script>
