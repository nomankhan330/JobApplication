                            <li>
                                <a href="/Account/CostCenter" class=" waves-effect">
                                    <i class="ri-calendar-2-line"></i>
                                    <span>Cost Center</span>
                                </a>
                            </li>

                            <li>
                                <a href="/Account/Users" class=" waves-effect">
                                    <i class="ri-account-circle-line"></i>
                                    <span>Users</span>
                                </a>
                            </li>

                            <li>
                                <a href="/Customer/Index" class=" waves-effect">
                                    <i class="ri-profile-line"></i>
                                    <span>Customer / Service Provider</span>
                                </a>
                            </li>

                            <li>
                                <a href="/Job/InvoiceAccessRequests" class=" waves-effect">
                                    <i class="ri-calendar-2-line"></i>
                                    <span>Invoice Access Requests</span>
                                </a>
                            </li>

                            <li>
                                <a href="javascript: void(0);" class="has-arrow waves-effect">
                                    <i class="ri-mail-send-line"></i>
                                    <span>Create Job</span>
                                </a>
                                <ul class="sub-menu" aria-expanded="false">
                                    <li><a href="/Job/Import">Import</a></li>
                                    <li><a href="/Job/Export">Export</a></li>
                                </ul>
                            </li>

                            <li>
                                <a href="javascript: void(0);" class="has-arrow waves-effect">
                                    <i class="fas fa-th-list"></i>
                                    <span>Accounts Management</span>
                                </a>
                                <ul class="sub-menu" aria-expanded="false">
                                    <li><a href="/Invoice/SalesInvoice">Sales Invoice</a></li>
                                    <li><a href="/Invoice/PurchaseInvoice">Purchase Invoice</a></li>
                                    <li><a href="/Report/CustomerSOA">Account Statement</a></li>
                                    <li><a href="/Report/ServiceProviderSOA">Account Statement SP</a></li>
                                    <li><a href="/Invoice/GovtTax">Government TAX</a></li>
                                    @* <li><a href="#">Ledger</a></li>
                                    <li><a href="#">Search</a></li> *@
                                </ul>
                            </li>

                            <li>
                                <a href="javascript: void(0);" class="has-arrow waves-effect">
