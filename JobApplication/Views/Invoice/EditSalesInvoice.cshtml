<div id="globalLoader" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%;
background:rgba(0,0,0,0.4); z-index:9999; text-align:center; padding-top:20%;">
    
    <div class="spinner-border text-light" role="status"></div>
    <div style="color:white; margin-top:10px;">Loading...</div>
</div>

@section Script {

    <script src="~/assets/libs/select2/js/select2.min.js"></script>

    <script>

        var Id = parseInt('@ViewBag.Id') || 0;
        var vatPercentDisplay = 0;


        function calculateInvoice() {

            let total = 0;
            let totalVat = 0;
            let vatPercentDisplay = 0;

            $('#invoiceTable tbody tr').each(function () {

                let row = $(this);

                let qty = parseFloat(row.find('.qty').val()) || 0;
                let rate = parseFloat(row.find('.rate').val()) || 0;
                let vatPercent = parseFloat(row.find('.vat-percent').val()) || 0;
                
                console.log("vatPercent", vatPercent)

                if (vatPercent > 0 && vatPercentDisplay === 0) {
                    vatPercentDisplay = vatPercent;
                }

                // Amount
                let amount = qty * rate;

                // VAT
                let vatAmount = (amount * vatPercent) / 100;

                // Total Per Row
                let totalAmount = amount + vatAmount;

                // Set Row Values
                row.find('.amount').val(amount.toFixed(2));
                row.find('.vat-amount').val(vatAmount.toFixed(2));
                row.find('.total-amount').val(totalAmount.toFixed(2));

                // Summary Totals
                total += amount;
                totalVat += vatAmount;
            });

            // Inputs
            let advance = parseFloat($('#advanceAmount').val()) || 0;
            let discount = parseFloat($('#discountAmount').val()) || 0;

            // Total Including VAT
            let totalAmount = total + totalVat;

            // Grand Total
            let grandTotal = totalAmount - advance - discount;

            // Summary Fields
            $('#totalAmount').val(totalAmount.toFixed(2));
            $('#vatAmount').val(totalVat.toFixed(2));
            $('#netAmount').val(total.toFixed(2));
            $('#grandTotal').val(grandTotal.toFixed(2));

            // Amount In Words
            let roundedGrandTotal = parseFloat(grandTotal.toFixed(2));

            let integerPart = Math.floor(roundedGrandTotal);
            let decimalPart = Math.round((roundedGrandTotal - integerPart) * 100);

            let words =
                numberToWords(integerPart) +
                ' and ' +
                decimalPart.toString().padStart(2, '0') +
                '/100 Saudi Riyals Only';

            $('#amountInWords').text(words);

            // Row Numbers
            updateRowNumbers();

            $(".vatPercentDisplay").text(vatPercentDisplay + "% VAT");
        }

        // Add New Row
        $(document).on('click', '.addRow', function () {

            let newRow = `
                <tr>

                    <td class="row-no"></td>

                    <td>
                        <select class="form-select payment-type">
                            <option value="" selected>Select Payment Type</option>
                            <option value="1">Official</option>
                            <option value="2">Unofficial</option>
                        </select>
                    </td>

                    <td>
                        <select class="form-select payment_headers" name="payment_headers[]">
                            <option value="">Select Payment Details</option>
                    </select>
                    </td>

                    <td>
                        <input type="number"
                               class="form-control text-center unit"
                               value="1"
                               min="1">
                    </td>

                    <td>
                        <input type="number"
                               class="form-control text-center qty calc"
                               value="1"
                               min="1">
                    </td>

                    <td>
                        <input type="number"
                               class="form-control text-end rate calc"
                               value="0"
                               step="0.01" min="1">
                    </td>

                    <td>
                        <input type="text"
                               class="form-control text-end amount"
                               value="0.00"
                               readonly>
                    </td>

                    <td style="display:none;">
                        <input type="number"
                                class="form-control text-end vat-percent calc"
                                value="0" min="1">
                   

                    <td>
                        <input type="text"
                               class="form-control text-end vat-amount"
                               value="0.00"
                               readonly>
                    </td>

                    <td>
                        <input type="text"
                               class="form-control text-end total-amount"
                               value="0.00"
                               readonly>
                    </td>

                    <td>
                        <button type="button"
                                class="btn btn-success btn-sm addRow">
                            +
                        </button>

                        <button type="button"
                                class="btn btn-danger btn-sm removeRow">
                            -
                        </button>
                    </td>

                </tr>
            `;

            $('#invoiceTable tbody').append(newRow);

            updateRowNumbers();
        });


        // Remove Row
        $(document).on('click', '.removeRow', function () {

            if ($('#invoiceTable tbody tr').length > 1) {

                $(this).closest('tr').remove();

                calculateInvoice();
            }
        });


        // Recalculate
        $(document).on('keyup change', '.calc, .summary-calc', function () {
            calculateInvoice();
        });

        $(document).on('change', '.payment-type', function () {

            let paymentTypeId = $(this).val();

            // Current Table Row
            let $currentRow = $(this).closest('tr');

            // Current Row Dropdown
            let $paymentDetailsDropdown =
                $currentRow.find('.payment_headers');

            // Load Dropdown Data
            loadPaymentDetails(
                paymentTypeId,
                $paymentDetailsDropdown
            );

        });

        $(document).on('change', '.payment_headers', function () {

            let vatPercent = $(this)
                .find(':selected')
                .data('vatpercentage');
            
            let row = $(this).closest('tr');

            row.find('.vat-percent').val(vatPercent || 0);

            // Recalculate row
            calculateInvoice();
        });


        $('#btnSaveInvoice').click(function () {

            let model = getInvoiceData();

            let invoiceData = model;

            if (
                !invoiceData.CustomerId ||
                !invoiceData.JobId ||
                invoiceData.Items.length === 0
            ) {
                showMessage("Please complete all invoice details before submitting.", "error");
                return;
            }

            console.log("model",model);
            //return;


            var $btn = $(this);

            $.ajax({

                url: '/Invoice/SaveSalesInvoice',

                type: 'POST',

                data: JSON.stringify(model),

                contentType: 'application/json',

                success: function (response) {

                    console.log(response);

                    if (response.errorCode === 200) {

                        //alert(response.message);
                        showMessage(response.message, "success");
                        //console.log("Invoice No:", response.invoiceNo);

                        redirectAction("/Invoice/SalesInvoice");

                    } else{
                        showMessage(response.errorMessage, "error");
                    }
                },

                beforeSend: function () {
                    $btn.prop("disabled", true).text("Processing...");
                },

                error: function (xhr) {

                    showMessage("An error occurred " + xhr, "error");

                },

                complete: function () {
                    $btn.prop("disabled", false).text("Save");
                }
            });

        });

        // Update Row Numbers
        function updateRowNumbers() {

            $('#invoiceTable tbody tr').each(function (index) {

                $(this).find('.row-no').text(index + 1);

            });
        }

        function numberToWords(num) {

            const ones = [
                '', 'One', 'Two', 'Three', 'Four', 'Five',
                'Six', 'Seven', 'Eight', 'Nine', 'Ten',
                'Eleven', 'Twelve', 'Thirteen', 'Fourteen',
                'Fifteen', 'Sixteen', 'Seventeen', 'Eighteen', 'Nineteen'
            ];

            const tens = [
                '', '', 'Twenty', 'Thirty', 'Forty',
                'Fifty', 'Sixty', 'Seventy', 'Eighty', 'Ninety'
            ];

            function convertHundreds(n) {

                let str = '';

                if (n > 99) {
                    str += ones[Math.floor(n / 100)] + ' Hundred ';
                    n = n % 100;
                }

                if (n > 19) {
                    str += tens[Math.floor(n / 10)] + ' ';
                    n = n % 10;
                }

                if (n > 0) {
                    str += ones[n] + ' ';
                }

                return str.trim();
            }

            if (num === 0)
                return 'Zero';

            let result = '';

            if (Math.floor(num / 1000000) > 0) {
                result += convertHundreds(Math.floor(num / 1000000)) + ' Million ';
                num %= 1000000;
            }

            if (Math.floor(num / 1000) > 0) {
                result += convertHundreds(Math.floor(num / 1000)) + ' Thousand ';
                num %= 1000;
            }

            if (num > 0) {
                result += convertHundreds(num);
            }

            return result.trim();
        }

        function loadInvoiceTable(items) {

            let tbody = $('#invoiceTable tbody');

            tbody.empty();

            console.log("items", items);

            $.each(items, function (i, item) {

                // DB Values
                let qty = parseFloat(item.Qty) || 1;
                let rate = parseFloat(item.Amount) || 0;
                let vatPercent = parseFloat(item.VatPercent) || 0;

                // Row Calculations
                let amount = qty * rate;
                let vatAmount = (amount * vatPercent) / 100;
                let totalAmount = amount + vatAmount;

                console.log("vatPercent load", vatPercent);
                

                let row = $(`
                <tr>

                    <td class="row-no">${i + 1}</td>

                    <td>
                        <select class="form-select payment-type">
                            <option value="">Select Payment Type</option>
                            <option value="1" ${item.PaymentTypeId == '1' ? 'selected' : ''}>Official</option>
                            <option value="2" ${item.PaymentTypeId == '2' ? 'selected' : ''}>Unofficial</option>
                        </select>
                    </td>

                    <td>
                        <select class="form-select payment_headers">

                            <option value="">Select Payment Details</option>

                            <option value="${item.InvoiceDetail}" selected>
                                ${item.InvoiceDetail}
                            </option>

                        </select>
                    </td>

                    <td>
                        <input type="number"
                               class="form-control text-center unit"
                               min="1"
                               value="${item.Unit || 1}">
                    </td>

                    <td>
                        <input type="number"
                               class="form-control text-center qty calc"
                               min="1"
                               value="${qty}">
                    </td>

                    <td>
                        <input type="number"
                               class="form-control text-end rate calc"
                               value="${rate.toFixed(2)}"
                               min="0">
                    </td>

                    <td>
                        <input type="text"
                               class="form-control text-end amount"
                               value="${amount.toFixed(2)}"
                               readonly>
                    </td>

                    <td style="display:none;">
                        <input type="number"
                               class="form-control text-end vat-percent calc"
                               value="${vatPercent}"
                               min="0">
                    </td>

                    <td>
                        <input type="text"
                               class="form-control text-end vat-amount"
                               value="${vatAmount.toFixed(2)}"
                               readonly>
                    </td>

                    <td>
                        <input type="text"
                               class="form-control text-end total-amount"
                               value="${totalAmount.toFixed(2)}"
                               readonly>
                    </td>

                    <td>
                        <button type="button"
                                class="btn btn-success btn-sm addRow">
                            +
                        </button>

                        <button type="button"
                                class="btn btn-danger btn-sm removeRow">
                            -
                        </button>
                    </td>

                </tr>`);

                tbody.append(row);

                // AUTO LOAD PAYMENT DETAILS
                let paymentTypeId = item.PaymentTypeId;

                let $paymentDropdown = row.find('.payment_headers');

                loadPaymentDetails(
                    paymentTypeId,
                    $paymentDropdown,
                    item.PaymentHeaderId
                );
            });

            // Generic Total Calculation
            calculateInvoice();
        }

        function loadPaymentDetails(paymentTypeId, $dropdown, selectedId = null) {

            $dropdown.empty();

            $dropdown.append(`
                <option value="">Select Payment Details</option>
            `);

            if (!paymentTypeId) {
                return;
            }

            $.ajax({
                url: '/Dropdown/GetPaymentHeadersByType',
                type: 'GET',
                data: { paymentTypeId: paymentTypeId },
                dataType: 'json',

                success: function (response) {

                    if (response.errorCode === 200 && response.data) {

                        $.each(response.data, function (i, item) {

                            $dropdown.append(`
                                <option value="${item.Id}" data-vatpercentage="${item.Vat}">
                                    ${item.CombinedHeader}
                                </option>
                            `);

                        });

                        // Edit Mode Selected Value
                        if (selectedId !== null &&
                            selectedId !== "" &&
                            selectedId !== undefined) {

                            $dropdown.val(selectedId);

                        }
                    }
                },

                error: function (xhr, status, error) {

                    console.error("Error loading payment details:", error);

                }
            });
        }

    </script>
    
    <script>


        $(document).ready(function () {
            GetInvoiceById(Id);
        });

        function GetInvoiceById(id) {

            // 🔥 SHOW LOADER + DISABLE SCREEN
            $("#globalLoader").show();

            $.ajax({
                type: "POST",
                url: "/Invoice/EditSalesInvoice",
                data: { invoiceId: id },
                success: function (resp) {

                    console.log("Edit Response:", resp);

                    if (!resp || resp.errorCode !== 200 || !resp.data) {
                        showMessage && showMessage("Record not found", "error");
                        return;
                    }

                    let master = resp.data.JobImportMaster?.[0];   // single record
                    let payments = resp.data.JobImportPayment || []; // list

                    console.log("Master:", master);
                    console.log("Payments:", payments);

                    // ================= HEADER =================

                    // English Company Details
                    $("#lblCompanyName").text(master.CompanyName);
                    $("#lblEstablishmentName").text(master.EstablishmentName);
                    $("#lblCityCountry").text(master.Country + ", " + master.City);
                    $("#lblVATNumber").text("VAT No: " + master.UserVatNo);

                    // Arabic Company Details
                    $("#lblCompanyNameAr").text(master.CompanyNameAr);
                    $("#lblEstablishmentNameAr").text(master.EstablishmentNameAr);
                    $("#lblCityCountryAr").text(master.CountryAr + "، " + master.CityAr);
                    $("#lblVATNumberAr").text("رقم ضريبة القيمة المضافة: " + master.UserVatNo);

                    $('#lblInvoiceNo').text(master.InvoiceNo);
                    $('#lblInvoiceDate').text(formatDate(master.InvoiceDate));

                    $('#advanceAmount').val(parseFloat(master.Advance).toFixed(2));
                    $('#discountAmount').val(parseFloat(master.Discount).toFixed(2));

                    //$('#lblStatus').text(master.StatusName);

                    var $status = $('#lblStatus');

                    $status.removeClass('bg-success bg-danger bg-warning bg-secondary');
                    $status.text(master.StatusName);

                    switch (master.StatusId) {
                        case 0: // UnPaid
                            $status.addClass("bg-danger");
                            break;

                        case 1: // Paid
                            $status.addClass("bg-success");
                            break;

                        case 2: // Partially Paid
                            $status.addClass("bg-warning");
                            break;

                        default:
                            $status.addClass("bg-secondary");
                            break;
                    }


                    // ================= SHIPMENT =================
                    $('.shipment-job-no').text(master.JobNumber);
                    $('.shipment-mode').text(master.ModeOfShipment);
                    $('.shipment-type').text(master.ShipmentTypeName);
                    $('.shipment-pol').text(master.POL);
                    $('.shipment-pod').text(master.POD);
                    $('.shipment-blno').text(master.BLNumber);
                    $('.shipment-payment').text('Prepaid');

                    // ================= CUSTOMER =================
                    $('#CustomerId').val(master.CustomerId);
                    $('#InvoiceId').val(master.InvoiceId);
                    $('#JobId').val(master.JobId);
                    $('.customer-name').text(master.CustomerName + " " + master.CustomerNameAr);
                    $('.customer-address').text(master.Address);
                    $('.customer-region-country').text(master.RegionName + ', ' + master.CountryName);
                    $('.customer-vatid').text(master.VatId);

                    loadInvoiceTable(payments || []);

                    $("#divData").show();
                },
                error: function () {
                    showMessage && showMessage("An error occurred while fetching job details.", "error");
                },
                complete: function () {

                    // 🔥 HIDE LOADER + ENABLE SCREEN
                    $("#globalLoader").hide();
                }
            });
        }
        
        function getInvoiceData() {

            let items = [];

            $('#invoiceTable tbody tr').each(function () {

                let row = $(this);

                items.push({
                    PaymentTypeId: row.find('.payment-type').val(),
                    PaymentHeaderId: row.find('.payment_headers').val(),
                    Unit: row.find('.unit').val(),
                    Qty: row.find('.qty').val(),
                    Rate: row.find('.rate').val(),
                    Amount: row.find('.amount').val(),
                    VATPercent: row.find('.vat-percent').val(),
                    VATAmount: row.find('.vat-amount').val(),
                    TotalAmount: row.find('.total-amount').val()
                });
            });

            return {
                CustomerId: $('#CustomerId').val(),
                JobId: $('#JobId').val(),
                InvoiceId: $('#InvoiceId').val(),

                TotalAmount: $('#totalAmount').val(),
                Advance: $('#advanceAmount').val(),
                Discount: $('#discountAmount').val(),
                NetAmount: $('#netAmount').val(),
                VATAmount: $('#vatAmount').val(),
                GrandTotal: $('#grandTotal').val(),

                Status: 0,
                Items: items
            };
        }
    </script>
   
}