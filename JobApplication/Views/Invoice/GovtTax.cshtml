@inject BusinessLogic.Interfaces.ISessionHelper SessionHelper
@{
    ViewData["Title"] = "Govt Tax";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Head {
    <!-- DataTables -->
    <link href="~/assets/libs/datatables.net-bs4/css/dataTables.bootstrap4.min.css" rel="stylesheet" type="text/css" />
    <link href="~/assets/libs/datatables.net-buttons-bs4/css/buttons.bootstrap4.min.css" rel="stylesheet" type="text/css" />

    <style>
        .dataTables_paginate {
            text-align: right !important;
        }

        .pagination-rounded .page-link {
            border-radius: 50px !important;
        }

        .dataTables_paginate .pagination {
            justify-content: flex-end !important;
        }

    </style>
}


<div class="page-content">
    <div class="container-fluid">

        <!-- start page title -->
        <div class="row">
            <div class="col-12">
                <div class="page-title-box d-sm-flex align-items-center justify-content-between">
                    <h4 class="mb-sm-0">Govt Tax</h4>
                </div>
            </div>
        </div>
        <!-- end page title -->

        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-body">

                        <!-- Filter Button -->
                        <div class="mb-3">
                            <button class="btn btn-info" type="button" data-bs-toggle="collapse" data-bs-target="#filterSection">
                                <i class="fa fa-filter"></i> Filters
                            </button>
                        </div>

                        <!-- Filter Section -->
                        <div class="collapse" id="filterSection">
                            <div class="card mb-3 p-3">
                                <div class="row align-items-end">

                                    <!-- 📅 From Date -->
                                    <div class="col-md-3">
                                        <label class="form-label">From Date</label>
                                        <input type="date" id="filterFromDate" name="filterFromDate" class="form-control">
                                    </div>

                                    <!-- 📅 To Date -->
                                    <div class="col-md-3">
                                        <label class="form-label">To Date</label>
                                        <input type="date" id="filterToDate" name="filterToDate" class="form-control">
                                    </div>

                                    <!-- Buttons -->
                                    <div class="col-md-3">
                                        <button id="btnSearch" class="btn btn-primary me-2">
                                            <i class="fas fa-search"></i> Search
                                        </button>

                                        <button id="btnClear" class="btn btn-secondary">
                                            <i class="fas fa-window-close me-1"></i> Clear
                                        </button>
                                    </div>

                                </div>
                            </div>
                        </div>


                        <!-- Table Govt. TAX -->
                        <table id="datatable" class="table table-striped table-bordered dt-responsive nowrap" style="width:100%">
                            <thead>
                                <tr>
                                    <th>From Date</th>
                                    <th>To Date</th>
                                    <th>Total Sales Invoice VAT</th>
                                    <th>Total Purchase Invoice VAT</th>
                                    <th>Govt. Tax Amount</th>
                                </tr>
                            </thead>
                        </table>

                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

@section Script {

    <!-- Required datatable js -->
    <script src="~/assets/libs/datatables.net/js/jquery.dataTables.min.js"></script>
    <script src="~/assets/libs/datatables.net-bs4/js/dataTables.bootstrap4.min.js"></script>
    <script src="https://cdn.datatables.net/fixedheader/3.4.0/js/dataTables.fixedHeader.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/dataTables.buttons.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.html5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.print.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/pdfmake.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/vfs_fonts.js"></script>

    <script>

        var loginType = '@SessionHelper.LoginType';

        $(document).ready(function () {

             // Search & Clear
            clearForm();
            
            $("#btnSearch").click(function () {
                loadRecords();
            });

            $("#btnClear").click(function () {
                loadRecords();
            });

            loadRecords();

        });

        function loadRecords() {

            if ($.fn.DataTable.isDataTable('#datatable')) {
                $('#datatable').DataTable().destroy();
            }

            $("#datatable").DataTable({
                processing: true,
                serverSide: false,
                dom: 'Bfrtip',

                buttons: [
                    {
                        text: '📥 Export Excel',
                        className: 'btn btn-primary btn-sm',
                        action: function (e, dt, node, config) {
                            var fromDate = $("#filterFromDate").val();
                            var toDate = $("#filterToDate").val();

                            // Custom Backend Excel Download Endpoint
                            window.open(
                                '/Invoice/DownloadGovernmentTaxExcel?fromDate=' +
                                encodeURIComponent(fromDate) +
                                '&toDate=' +
                                encodeURIComponent(toDate),
                                '_blank'
                            );
                        }
                    },
                    {
                        text: '📄 PDF',
                        className: 'btn btn-primary btn-sm',
                        action: function (e, dt, node, config) {
                            var fromDate = $("#filterFromDate").val();
                            var toDate = $("#filterToDate").val();

                            window.open(
                                '/Invoice/DownloadGovernmentTaxPdf?fromDate=' +
                                encodeURIComponent(fromDate) +
                                '&toDate=' +
                                encodeURIComponent(toDate),
                                '_blank'
                            );
                        }
                    }
                ],

                ajax: {
                    url: "/Invoice/GetGovernmentTaxReport",
                    type: "POST",
                    dataSrc: function (json) {
                        // Agar json array na ho to array mein Wrap karein
                        return Array.isArray(json) ? json : [json];
                    },
                    data: function (d) {
                        d.fromDate = $("#filterFromDate").val();
                        d.toDate = $("#filterToDate").val();
                    }
                },
                columns: [
                    {
                        data: "FromDate",
                        render: function (data) {
                            if (!data) return "";
                            var date = moment(data);
                            return date.isValid() ? date.format("DD/MM/YYYY") : data;
                        }
                    },
                    {
                        data: "ToDate",
                        render: function (data) {
                            if (!data) return "";
                            // Invalid Date Issue Fix: Check validity explicitly
                            var date = moment(data);
                            return date.isValid() ? date.format("DD/MM/YYYY") : data;
                        }
                    },
                    {
                        data: "TotalSalesVAT",
                        className: "text-center",
                        render: function (data) {
                            return parseFloat(data || 0).toLocaleString('en-US', {
                                minimumFractionDigits: 2,
                                maximumFractionDigits: 2
                            });
                        }
                    },
                    {
                        data: "TotalPurchaseVAT",
                        className: "text-center",
                        render: function (data) {
                            return parseFloat(data || 0).toLocaleString('en-US', {
                                minimumFractionDigits: 2,
                                maximumFractionDigits: 2
                            });
                        }
                    },
                    {
                        data: "GovernmentTax",
                        className: "text-center",
                        render: function (data) {
                            return parseFloat(data || 0).toLocaleString('en-US', {
                                minimumFractionDigits: 2,
                                maximumFractionDigits: 2
                            });
                        }
                    }
                ]
            });
        }

        function clearForm() {

            $("#filterSection").find("input").val("");
            $("#filterSection").find("select").val("");

            var today = new Date();
            var firstDay = new Date(today.getFullYear(), today.getMonth(), 1);
            var lastDay = new Date(today.getFullYear(), today.getMonth() + 1, 0);

            $('#filterFromDate').val(formatDateFilter(firstDay));
            $('#filterToDate').val(formatDateFilter(lastDay));
        }

    </script>
}