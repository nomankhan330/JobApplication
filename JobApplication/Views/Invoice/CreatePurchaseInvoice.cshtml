</div>

<input type="hidden" id="InvoiceId" name="InvoiceId" value="0" />
<input type="hidden" id="ServiceProviderId" name="ServiceProviderId" />
<input type="hidden" id="JobId" name="JobId" value="0" />

<div id="globalLoader" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%;
background:rgba(0,0,0,0.4); z-index:9999; text-align:center; padding-top:20%;">

    <div class="spinner-border text-light" role="status"></div>
    <div style="color:white; margin-top:10px;">Loading...</div>
</div>

@section Script {

    <script src="~/assets/libs/select2/js/select2.min.js"></script>

    <script>

        loadServiceProvider();

        var vatPercentDisplay = 0;

        function calculateInvoice() {

            let total = 0;
            let totalVat = 0;
            let vatPercentDisplay = 0;

            $('#invoiceTable tbody tr').each(function () {

                let row = $(this);

                let qty = parseFloat(row.find('.qty').val()) || 0;
                let rate = parseFloat(row.find('.rate').val()) || 0;
                let vatPercent = parseFloat(row.find('.vat-percent').val()) || 0;

                if (vatPercent > 0 && vatPercentDisplay === 0) {
                    vatPercentDisplay = vatPercent;
                }

                // Amount
                let amount = qty * rate;

                // VAT
                let vatAmount = (amount * vatPercent) / 100;

                // Total Per Row
                let totalAmount = amount + vatAmount;

                // Set Row Values
                row.find('.amount').val(amount.toFixed(2));
                row.find('.vat-amount').val(vatAmount.toFixed(2));
                row.find('.total-amount').val(totalAmount.toFixed(2));

                // Summary Totals
                total += amount;
                totalVat += vatAmount;
            });

            // Inputs
            let advance = parseFloat($('#advanceAmount').val()) || 0;
            let discount = parseFloat($('#discountAmount').val()) || 0;

            // Total Including VAT
            let totalAmount = total + totalVat;

            // Grand Total
            let grandTotal = totalAmount - advance - discount;

            // Summary Fields
            $('#totalAmount').val(totalAmount.toFixed(2));
            $('#vatAmount').val(totalVat.toFixed(2));
            $('#netAmount').val(total.toFixed(2));
            $('#grandTotal').val(grandTotal.toFixed(2));

            // Amount In Words
            let roundedGrandTotal = parseFloat(grandTotal.toFixed(2));

            let integerPart = Math.floor(roundedGrandTotal);
            let decimalPart = Math.round((roundedGrandTotal - integerPart) * 100);

            let words =
                numberToWords(integerPart) +
                ' and ' +
                decimalPart.toString().padStart(2, '0') +
                '/100 Saudi Riyals Only';

            $('#amountInWords').text(words);

            // Row Numbers
            updateRowNumbers();

            $(".vatPercentDisplay").text(vatPercentDisplay + "% VAT");
        }

        // Add New Row
        $(document).on('click', '.addRow', function () {

            let PaymentTypeCheck = $("#PaymentTypeId").val();

            let newRow = `
                <tr>

                    <td class="row-no"></td>

                    <td>
                        <select class="form-select payment-type">
                            <option value="" selected>Select Payment Type</option>
                            ${PaymentTypeCheck == '1' ? `<option value="1"}>Official</option>` : ''}
                            ${PaymentTypeCheck == '2' ? `<option value="2"}>Unofficial</option>` : ''}
                        </select>
                    </td>

                    <td>
                        <select class="form-select payment_headers" name="payment_headers[]">
                            <option value="">Select Payment Details</option>
                    </select>
                    </td>

                    <td>
                        <input type="number"
                                class="form-control text-center unit"
                                value="1"
                                min="1">
                    </td>

                    <td>
                        <input type="number"
                                class="form-control text-center qty calc"
                                value="1"
                                min="1">
                    </td>

                    <td>
                        <input type="number"
                                class="form-control text-end rate calc"
                                value="0"
                                step="0.01" min="1">
                    </td>

                    <td>
                        <input type="text"
                                class="form-control text-end amount"
                                value="0.00"
                                readonly>
                    </td>

                    <td style="display:none;">
                        <input type="number"
                                class="form-control text-end vat-percent calc"
                                value="0" min="1">

                    <td>
                        <input type="text"
                                class="form-control text-end vat-amount"
                                value="0.00"
                                readonly>
                    </td>

                    <td>
                        <input type="text"
                                class="form-control text-end total-amount"
                                value="0.00"
                                readonly>
                    </td>

                    <td>
                        <button type="button"
                                class="btn btn-success btn-sm addRow">
                            +
                        </button>

                        <button type="button"
                                class="btn btn-danger btn-sm removeRow">
                            -
                        </button>
                    </td>

                </tr>
            `;

            $('#invoiceTable tbody').append(newRow);

            updateRowNumbers();
        });


        // Remove Row
        $(document).on('click', '.removeRow', function () {

            if ($('#invoiceTable tbody tr').length > 1) {

                $(this).closest('tr').remove();

                calculateInvoice();
            }
        });


        // Recalculate
        $(document).on('keyup change', '.calc, .summary-calc', function () {
            calculateInvoice();
        });

        $(document).on('change', '.payment-type', function () {

            let paymentTypeId = $(this).val();

            // Current Table Row
            let $currentRow = $(this).closest('tr');

            // Current Row Dropdown
            let $paymentDetailsDropdown =
                $currentRow.find('.payment_headers');

            // Load Dropdown Data
            loadPaymentDetails(
                paymentTypeId,
                $paymentDetailsDropdown
            );

        });

        $(document).on('change', '.payment_headers', function () {

            let vatPercent = $(this)
                .find(':selected')
                .data('vatpercentage');

            let row = $(this).closest('tr');

            row.find('.vat-percent').val(vatPercent || 0);

            // Recalculate row
            calculateInvoice();
        });

        $('#PaymentTypeId').on('change', function () {
            
            let selectedValue = $(this).val();
            
            $("#divData").hide();

            if (selectedValue === "2") {
                $('#serviceProviderContainer').show();
                $('#manualFields').hide();
                clearManualFields();
            }
            else if (selectedValue === "1") {
                $('#serviceProviderContainer').hide();
                $('#manualFields').show();
                $('#ServiceProvider').val('').trigger('change');
            }
            else {
                $('#serviceProviderContainer').hide();
                $('#manualFields').hide();
                clearManualFields();
                $('#ServiceProvider').val('');
            }
        });

        // Inputs clear karne ka helper function
        function clearManualFields() {
            $('#manualFields input').val('');
        }

        $('#btnSaveInvoice').click(function () {

            let PaymentType = $("#PaymentTypeId").val();
            //alert(PaymentType);
            //console.log(PaymentType)

            let model = getInvoiceData();

            let invoiceData = model;

            //console.log("invoiceData", invoiceData);
            //return;

            if (!invoiceData.Items || invoiceData.Items.length === 0) {
                showMessage("Please add at least one item before submitting.", "error");
                return;
            }

            if (PaymentType != 1) {
                if (!invoiceData.ServiceProviderId || !invoiceData.JobId) {
                    showMessage("Please complete all service provider details before submitting.", "error");
                    return;
                }
            }

            // if(PaymentType == 1){
                
            // } else {
            //     if (
            //         !invoiceData.ServiceProviderId ||
            //         !invoiceData.JobId ||
            //         invoiceData.Items.length === 0
            //     ) {
            //         showMessage("Please complete all invoice details before submitting.", "error");
            //         return;
            //     }
            // }
            

            var $btn = $(this);

            $.ajax({

                url: '/Invoice/SavePurchaseInvoice',

                type: 'POST',

                data: JSON.stringify(model),

                contentType: 'application/json',

                success: function (response) {

                    console.log(response);

                    if (response.errorCode === 200) {

                        //alert(response.message);
                        showMessage(response.message, "success");
                        //console.log("Invoice No:", response.invoiceNo);

                        redirectAction("/Invoice/PurchaseInvoice");

                    } else{
                        showMessage(response.errorMessage, "error");
                    }
                },

                beforeSend: function () {
                    $btn.prop("disabled", true).text("Processing...");
                },

                error: function (xhr) {

                    showMessage("An error occurred " + xhr, "error");

                },

                complete: function () {
                    $btn.prop("disabled", false).text("Save");
                }
            });

        });

        // Update Row Numbers
        function updateRowNumbers() {

            $('#invoiceTable tbody tr').each(function (index) {

                $(this).find('.row-no').text(index + 1);

            });
        }

        function numberToWords(num) {

            const ones = [
                '', 'One', 'Two', 'Three', 'Four', 'Five',
                'Six', 'Seven', 'Eight', 'Nine', 'Ten',
                'Eleven', 'Twelve', 'Thirteen', 'Fourteen',
                'Fifteen', 'Sixteen', 'Seventeen', 'Eighteen', 'Nineteen'
            ];

            const tens = [
                '', '', 'Twenty', 'Thirty', 'Forty',
                'Fifty', 'Sixty', 'Seventy', 'Eighty', 'Ninety'
            ];

            function convertHundreds(n) {

                let str = '';

                if (n > 99) {
                    str += ones[Math.floor(n / 100)] + ' Hundred ';
                    n = n % 100;
                }

                if (n > 19) {
                    str += tens[Math.floor(n / 10)] + ' ';
                    n = n % 10;
                }

                if (n > 0) {
                    str += ones[n] + ' ';
                }

                return str.trim();
            }

            if (num === 0)
                return 'Zero';

            let result = '';

            if (Math.floor(num / 1000000) > 0) {
                result += convertHundreds(Math.floor(num / 1000000)) + ' Million ';
                num %= 1000000;
            }

            if (Math.floor(num / 1000) > 0) {
                result += convertHundreds(Math.floor(num / 1000)) + ' Thousand ';
                num %= 1000;
            }

            if (num > 0) {
                result += convertHundreds(num);
            }

            return result.trim();
        }

        function loadInvoiceTable(items) {

            let PaymentTypeCheck = $("#PaymentTypeId").val();
            let tbody = $('#invoiceTable tbody');

            tbody.empty();

            console.log("items", items);

            $.each(items, function (i, item) {

                // DB Values
                let qty = parseFloat(item.Qty) || 1;
                let rate = parseFloat(item.Amount) || 0;
                let vatPercent = parseFloat(item.VAT) || 0;

                // Row Calculations
                let amount = qty * rate;
                let vatAmount = (amount * vatPercent) / 100;
                let totalAmount = amount + vatAmount;

                let row = $(`
                <tr>

                    <td class="row-no">${i + 1}</td>

                    <td>
                        <select class="form-select payment-type">
                            ${PaymentTypeCheck == '1' ? `<option value="1" ${item.PaymentType == '1' ? 'selected' : ''}>Official</option>` : ''}
                            ${PaymentTypeCheck == '2' ? `<option value="2" ${item.PaymentType == '2' ? 'selected' : ''}>Unofficial</option>` : ''}
                        </select>
                    </td>

                    <td>
                        <select class="form-select payment_headers">

                            <option value="">Select Payment Details</option>

                            <option value="${item.InvoiceDetail}" selected>
                                ${item.InvoiceDetail}
                            </option>

                        </select>
                    </td>

                    <td>
                        <input type="number"
                               class="form-control text-center unit"
                               min="1"
                               value="${item.Unit || 1}">
                    </td>

                    <td>
                        <input type="number"
                               class="form-control text-center qty calc"
                               min="1"
                               value="${qty}">
                    </td>

                    <td>
                        <input type="number"
                               class="form-control text-end rate calc"
                               value="${rate.toFixed(2)}"
                               min="0">
                    </td>

                    <td>
                        <input type="text"
                               class="form-control text-end amount"
                               value="${amount.toFixed(2)}"
                               readonly>
                    </td>

                    <td style="display:none;">
                        <input type="number"
                               class="form-control text-end vat-percent calc"
                               value="${vatPercent}"
                               min="0">
                    </td>

                    <td>
                        <input type="text"
                               class="form-control text-end vat-amount"
                               value="${vatAmount.toFixed(2)}"
                               readonly>
                    </td>

                    <td>
                        <input type="text"
                               class="form-control text-end total-amount"
                               value="${totalAmount.toFixed(2)}"
                               readonly>
                    </td>

                    <td>
                        <button type="button"
                                class="btn btn-success btn-sm addRow">
                            +
                        </button>

                        <button type="button"
                                class="btn btn-danger btn-sm removeRow">
                            -
                        </button>
                    </td>

                </tr>`);

                tbody.append(row);

                // AUTO LOAD PAYMENT DETAILS
                let paymentTypeId = item.PaymentType;

                let $paymentDropdown = row.find('.payment_headers');

                loadPaymentDetails(
                    paymentTypeId,
                    $paymentDropdown,
                    item.PaymentHeaderId
                );
            });

            // Generic Total Calculation
            calculateInvoice();
        }

        function loadPaymentDetails(paymentTypeId, $dropdown, selectedId = null) {

            $dropdown.empty();

            $dropdown.append(`
                <option value="">Select Payment Details</option>
            `);

            if (!paymentTypeId) {
                return;
            }

            $.ajax({
                url: '/Dropdown/GetPaymentHeadersByType',
                type: 'GET',
                data: { paymentTypeId: paymentTypeId },
                dataType: 'json',

                success: function (response) {

                    if (response.errorCode === 200 && response.data) {

                        $.each(response.data, function (i, item) {

                            $dropdown.append(`
                                <option value="${item.Id}" data-vatpercentage="${item.Vat}">
                                    ${item.CombinedHeader}
                                </option>
                            `);

                        });

                        // Edit Mode Selected Value
                        if (selectedId !== null &&
                            selectedId !== "" &&
                            selectedId !== undefined) {

                            $dropdown.val(selectedId);

                        }
                    }
                },

                error: function (xhr, status, error) {

                    console.error("Error loading payment details:", error);

                }
            });
        }

        function loadServiceProvider(selectedId = null) {
            $.ajax({
                url: '/Dropdown/GetServiceProvider',
                type: 'GET',
                dataType: 'json',
                success: function (response) {

                    let $dropdown = $('#ServiceProvider');

                    $dropdown.empty();
                    $dropdown.append('<option value="">Select Service Provider</option>');

                    $.each(response.data, function (i, item) {
                        $dropdown.append(
                            `<option value="${item.Id}">
                                        ${item.CustomerName} (${item.CustomerCode})
                                    </option>`
                        );
                    });

                    // Destroy previous Select2 instance (important)
                    if ($dropdown.hasClass("select2-hidden-accessible")) {
                        $dropdown.select2('destroy');
                    }

                    // Initialize Select2
                    $dropdown.select2({
                        placeholder: "Select Service Provider",
                        allowClear: true,
                        width: '100%'
                    });

                    // Set selected value
                    if (selectedId) {
                        $dropdown.val(selectedId).trigger('change');
                    }
                },
                error: function (xhr, status, error) {
                    console.error("Error loading service provider:", error);
                }
            });
        }

        function getServiceProviderDetails(serviceProviderId) {
            
            let url = `/Customer/GetServiceProviderById`;

            $.ajax({
                url: url,
                type: 'GET',
                data: { id: serviceProviderId },
                dataType: 'json',
                beforeSend: function() {
                    console.log("Fetching details...");
                },
                success: function (response) {

                    if (response.errorCode === 200) {

                        let customer = response.Customer;
                        console.log("Data successfully retrieved:", customer);

                        // 🔹 Yahan aap apna data HTML fields me set kar sakte hain:
                        // $('#CustomerNameInput').val(customer.CustomerName);
                        // $('#AddressInput').val(customer.Address);
                        // $('#RegionInput').val(customer.RegionName); // Jo join se aya hai
                        // $('#CountryInput').val(customer.CountryName); // Jo join se aya hai


                        $('#ServiceProviderId').val(customer.Id);
                        //$('.customer-name').text([customer.CustomerName, customer.CustomerNameAr].filter(x => x).join(" "));

                        $('.customer-name').text(
                            [
                                customer.CustomerName,
                                customer.CustomerNameAr,
                                customer.CompanyName ? `(${customer.CompanyName})` : ''
                            ]
                            .filter(x => x)
                            .join(" ")
                        );

                        $('.customer-address').text(customer.Address);
                        $('.customer-region-country').text(customer.RegionName + ', ' + customer.CountryName);
                        $('.customer-vatid').text(customer.VatId);

                        //alert("Service Provider data loaded successfully!");
                    }
                    else if (response.errorCode === 404) {
                        alert("Error: " + response.errorMessage);
                    }
                    else {
                        alert("System Error: " + response.errorMessage);
                    }
                }
            });
        }
    </script>

    <script>

        $(document).ready(function () {

            $('#JobNo').select2({

                placeholder: 'Select Job Number',
                allowClear: true,

                ajax: {

                    url: '/Dropdown/GetJobNos',
                    type: 'POST',
                    dataType: 'json',
                    delay: 250,

                    data: function (params) {
                        return {
                            search: params.term || "",
                            page: params.page || 1
                        };
                    },

                    processResults: function (data, params) {

                        params.page = params.page || 1;

                        return {
                            results: data.data,   // ✅ FIXED HERE
                            pagination: {
                                more: data.hasMore
                            }
                        };
                    },

                    cache: true
                }
            });

            $("#btnSubmit").on("click", function (e) {
                e.preventDefault();

                let jobNo = $('#JobNo').val().trim();
                let paymentType = $('#PaymentTypeId').val();
                let serviceProvider = $('#ServiceProvider').val();

                // 1. Common Fields Ki Validation (Jo dono conditions ke liye zaroori hain)
                if (jobNo === "") {
                    showMessage("Please enter Job Number", "error");
                    $('#JobNo').focus();
                    return false;
                }

                if (paymentType === "") {
                    showMessage("Please select Payment Type", "error");
                    $('#PaymentTypeId').focus();
                    return false;
                }

                // 2. Condition 1: With VAT (PaymentType == 2)
                if (paymentType == "2") {
                    if (serviceProvider === "") {
                        showMessage("Please select Service Provider", "error");
                        $('#ServiceProvider').focus();
                        return false;
                    }
                }
                // 3. Condition 2: Without VAT (PaymentType == 1 ya kuch aur)
                else {
                    let isValid = true;

                    if ($('#manualFields').is(':visible')) {
                        $('#manualFields input').each(function () {
                            let value = $(this).val().trim();
                            let placeholderText = $(this).attr('placeholder');

                            if (value === "") {
                                showMessage(`Please enter Service Provider ${placeholderText}`, "error");
                                $(this).focus();
                                isValid = false;
                                return false; // Loop break
                            }
                        });
                    }

                    // Agar manual fields valid nahi hain toh yahin se rok do
                    if (!isValid) return false;
                }

                // 4. Agar upar ki saari validations pass ho gayin, toh final function call hoga
                GetJobImportById(jobNo);
        });

        });

        function GetJobImportById(id) {

            // 🔥 SHOW LOADER + DISABLE SCREEN
            $("#globalLoader").show();

            $.ajax({
                type: "POST",
                url: "/Job/GetJobById",
                data: { id: id, paymentTypeId: $('#PaymentTypeId').val() },
                success: function (resp) {

                    console.log("Edit Response:", resp);

                    if (!resp || resp.errorCode !== 200 || !resp.data) {
                        showMessage && showMessage("Record not found", "error");
                        return;
                    }

                    let master = resp.data.JobImportMaster?.[0];   // single record
                    let payments = resp.data.JobImportPayment || []; // list

                    console.log("Master:", master);
                    console.log("Payments:", payments);

                    // Shipment Details
                    $('.shipment-job-no').text(master.JobNumber);
                    $('.shipment-mode').text(master.ModeOfShipment);
                    $('.shipment-type').text(master.ShipmentTypeName);
                    $('.shipment-pol').text(master.POL);
                    $('.shipment-pod').text(master.POD);
                    $('.shipment-blno').text(master.BLNumber);
                    $('.shipment-payment').text('Prepaid');
                    
                    // $('#CustomerId').val(master.CustomerId);
                    // $('.customer-name').text(master.CustomerName);
                    // $('.customer-address').text(master.Address);
                    // $('.customer-region-country').text(master.RegionName + ', ' + master.CountryName);
                    // $('.customer-vatid').text(master.VatId);

                    // Service Provider Details

                    if($("#PaymentTypeId").val() == 2){ //with VAT
                        getServiceProviderDetails($("#ServiceProvider").val());
                        $("#manualFields input").prop("readonly", false);
                    } else { //without VAT
                        $('.customer-name').text($("#ServiceProviderName").val().trim());
                        $('.customer-address').text($("#ServiceProviderAddress").val().trim());

                        // Region aur Country ko mila kar dikhane ke liye
                        let region = $("#ServiceProviderRegion").val().trim();
                        let country = $("#ServiceProviderCountry").val().trim();
                        $('.customer-region-country').text(region + ', ' + country);

                        $('.customer-vatid').text($("#ServiceProviderVatId").val().trim());
                        $("#manualFields input").prop("readonly", true);
                        $("#ServiceProvider").val(0);
                    }
                    
                    loadInvoiceTable(payments || []);

                    $("#divData").show();
                },
                error: function () {
                    showMessage && showMessage("An error occurred while fetching job details.", "error");
                },
                complete: function () {

                    // 🔥 HIDE LOADER + ENABLE SCREEN
                    $("#globalLoader").hide();
                }
            });
        }

        function getInvoiceData() {

            let items = [];
            let PaymentType = $("#PaymentTypeId").val();

            $('#invoiceTable tbody tr').each(function () {

                let row = $(this);

                items.push({
                    PaymentTypeId: row.find('.payment-type').val(),
                    PaymentHeaderId: row.find('.payment_headers').val(),
                    Unit: row.find('.unit').val(),
                    Qty: row.find('.qty').val(),
                    Rate: row.find('.rate').val(),
                    Amount: row.find('.amount').val(),
                    VATPercent: row.find('.vat-percent').val(),
                    VATAmount: row.find('.vat-amount').val(),
                    TotalAmount: row.find('.total-amount').val()
                });
            });

            return {
                InvoiceNo: $("#InvoiceNo").val().trim(),
                ServiceProviderId: PaymentType == 2 ? $('#ServiceProviderId').val() : 0,
                JobId: $('#JobNo').val(),

                ServiceProviderName: PaymentType == 1 ? $('#ServiceProviderName').val() : '',
                ServiceProviderAddress: PaymentType == 1 ? $('#ServiceProviderAddress').val() : '',
                ServiceProviderRegion: PaymentType == 1 ? $('#ServiceProviderRegion').val() : '',
                ServiceProviderCountry: PaymentType == 1 ? $('#ServiceProviderCountry').val() : '',
                ServiceProviderVatId: PaymentType == 1 ? $('#ServiceProviderVatId').val() : '',

                TotalAmount: $('#totalAmount').val(),
                Advance: $('#advanceAmount').val(),
                Discount: $('#discountAmount').val(),
                NetAmount: $('#netAmount').val(),
                VATAmount: $('#vatAmount').val(),
                GrandTotal: $('#grandTotal').val(),

                Status: 0,
                Items: items
            };
        }

    </script>

    <script>
        $(document).ready(function() {

            loadNextPurchaseInvoiceNumber();

            $('#InvoiceNo').on('input', function() {
                let input = $(this);
                let val = input.val();

                // Digits extract karein
                let digits = val.replace(/^PINV-?/i, '').replace(/\D/g, '').substring(0, 8);

                let year = digits.substring(0, 4);
                let num = digits.substring(4, 8);

                let formatted = 'PINV-';
                if (year) formatted += year;
                if (year.length === 4) formatted += '-' + num;

                input.val(formatted);
            });
        });


        function loadNextPurchaseInvoiceNumber() {
            $.ajax({
                url: "/Invoice/GetNextPurchaseInvoiceNumber",
                type: "GET",
                dataType: "json",
                success: function(response) {
                    if (response.errorCode === 200) {
                        $("#InvoiceNo").val(response.invoiceNo);
                    }
                },
                error: function() {
                    showMessage(
                        "Unable to generate invoice number.",
                        "error"
                    );
                }
            });
        }
    </script>
}