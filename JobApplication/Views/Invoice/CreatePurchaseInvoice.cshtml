@{
    ViewData["Title"] = "Create Purchase Invoice";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Head {
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="~/assets/libs/select2/css/select2.min.css" rel="stylesheet" type="text/css">
    <style>
        body {
            background: #f5f7fb;
            font-size: 14px;
        }

        .invoice-wrapper {
            max-width: 1200px;
            margin: 30px auto;
            background: #fff;
            border-radius: 16px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.08);
            overflow: hidden;
            margin-bottom: -61px;
        }

        .invoice-header {
            border-top: 6px solid #0d6efd;
            padding: 30px;
        }

        .company-title {
            font-size: 1.8rem;
            font-weight: 700;
            color: #1f2937;
        }

        .section-title {
            font-size: 1rem;
            font-weight: 700;
            margin-bottom: 12px;
            color: #0d6efd;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .info-card {
            border: 1px solid #dee2e6;
            border-radius: 12px;
            padding: 20px;
            height: 100%;
            background: #fff;
        }

        .table thead th {
            background: #0d6efd;
            color: #fff;
            border-color: #0d6efd;
            vertical-align: middle;
            white-space: nowrap;
        }

        .table tfoot th,
        .table tfoot td {
            background: #f8f9fa;
            font-weight: 600;
        }

        .summary-table td,
        .summary-table th {
            padding: 0.65rem 1rem;
        }

        .grand-total {
            background: #0d6efd !important;
            color: #fff;
        }

        .badge-status {
            font-size: 0.85rem;
            padding: 0.5rem 0.75rem;
        }


        .select2-container--default .select2-selection--single {
            min-height: calc(1.5em + .75rem + 2px);
            border: 1px solid gray !important;
            border-radius: .375rem;
        }

        .select2-container--default .select2-selection--single .select2-selection__rendered {
            line-height: 35px !important;
            padding-left: 10px;
            color: #212529 !important;
        }

        .select2-container--default .select2-selection--single .select2-selection__placeholder {
            color: #000 !important; /* slightly darker gray */
            opacity: 1 !important;
            font-weight: 400;
        }

        .select2-container.is-invalid .select2-selection {
            border: 1px solid #dc3545 !important;
        }

        /* #invoiceTable {
            width: 100%;
            table-layout: auto;
        }

        #invoiceTable td {
            padding: 6px;
        }

        #invoiceTable .form-control,
        #invoiceTable .form-select {
            min-width: 90px;
        } */

        #invoiceTable {
            width: 100%;
            table-layout: auto;
        }

        /* Payment Type */
        #invoiceTable td:nth-child(2),
        #invoiceTable th:nth-child(2) {
            width: 14%;
            min-width: 100px;
        }

        /* Invoice Detail (Payment Headers) - WIDER */
        #invoiceTable td:nth-child(3),
        #invoiceTable th:nth-child(3) {
            width: 35%;
            min-width: 250px;
        }

        /* Unit - SMALL */
        #invoiceTable td:nth-child(4),
        #invoiceTable th:nth-child(4) {
            width: 6%;
            min-width: 60px;
        }

        /* Qty - SMALL */
        #invoiceTable td:nth-child(5),
        #invoiceTable th:nth-child(5) {
            width: 6%;
            min-width: 60px;
        }

        /* Rate / Amount / VAT / Total - balanced */
        #invoiceTable td:nth-child(6),
        #invoiceTable th:nth-child(6),
        #invoiceTable td:nth-child(7),
        #invoiceTable th:nth-child(7),
        #invoiceTable td:nth-child(8),
        #invoiceTable th:nth-child(8),
        #invoiceTable td:nth-child(9),
        #invoiceTable th:nth-child(9) {
            width: 15%;
            min-width: 100px;
        }

    </style>
}

<div class="page-content">

     <div class="container-fluid py-4">
        <div class="invoice-wrapper">
            <div class="invoice-header">
                <div class="row align-items-start g-4">
                    
                    <h3>Create Purchase Invoice</h3>

                    <div class="col-lg-3">
                        <select id="JobNo" class="form-select" style="width:100%">
                        </select>
                    </div>

                    <div class="col-lg-3">
                        <select id="PaymentTypeId" class="form-select select-my" style="width:100%">
                            <option value="">Select Invoice Type</option>
                            <option value="2">With VAT</option>
                            <option value="1">Without VAT</option>
                        </select>
                    </div>

                    <div class="col-lg-3" id="serviceProviderContainer" style="display: none;">
                        <select id="ServiceProvider" class="form-select" style="width:100%">
                        </select>
                    </div>

                    <fieldset id="manualFields" class="border p-3 rounded mt-3" style="display: none;">

                        <legend class="w-auto px-2 fs-5 fw-bold text-primary">Enter Service Provider Details</legend>

                        <div class="row">
                            <div class="col-lg-4 mb-2">
                                <input type="text" id="ServiceProviderName" class="form-control" placeholder="Name">
                            </div>
                            <div class="col-lg-4 mb-2">
                                <input type="text" id="ServiceProviderAddress" class="form-control" placeholder="Address">
                            </div>
                            <div class="col-lg-4 mb-2">
                                <input type="text" id="ServiceProviderRegion" class="form-control" placeholder="Region">
                            </div>
                            <div class="col-lg-4 mb-2">
                                <input type="text" id="ServiceProviderCountry" class="form-control" placeholder="Country">
                            </div>
                            <div class="col-lg-4 mb-2">
                                <input type="text" id="ServiceProviderVatId" class="form-control" placeholder="VAT Id">
                            </div>
                        </div>

                    </fieldset>
                    
                    <div class="col-lg-3">
                        <button class="btn btn-primary" type="button" id="btnSubmit">Submit</button>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <div id="divData" class="p-4 p-lg-5" style="display:none;">
        <div class="row g-4 mb-4">
            <div class="col-md-6">
                <div class="info-card">
                    <div class="section-title">Service Provider</div>
                    <h6 class="fw-bold mb-2 customer-name">SABA AHMED</h6>
                    <p class="mb-1 customer-address">4396 Prince Mohammad Bin Abdul Aziz Road 6750</p>
                    <p class="mb-1 customer-region-country">Riyadh, Kingdom of Saudi Arabia</p>
                    <p class="mb-0 customer-vatid">VAT: 312036022600003</p>

                    <br />

                    <input type="text"
                           id="InvoiceNo"
                           name="InvoiceNo"
                           style="width:30%;"
                           class="form-control invoice-input"
                           value="INV-2026-0005"
                           autocomplete="off"
                           required
                           maxlength="14"
                           pattern="PINV-[0-9]{4}-[0-9]{4}"
                           title="Format must be INV-2026-0005" />

                </div>
            </div>

            <div class="col-md-6">
                <div class="info-card">
                    <div class="section-title">Shipment Details</div>
                    <div class="row g-2">
                        <div class="col-6"><strong>Job Number:</strong></div>
                        <div class="col-6 shipment-job-no">-</div>

                        <div class="col-6"><strong>Mode of Shipment:</strong></div>
                        <div class="col-6 shipment-mode">-</div>

                        <div class="col-6"><strong>Type of Shipment:</strong></div>
                        <div class="col-6 shipment-type">-</div>

                        <div class="col-6"><strong>POL:</strong></div>
                        <div class="col-6 shipment-pol">-</div>

                        <div class="col-6"><strong>POD:</strong></div>
                        <div class="col-6 shipment-pod">-</div>

                        <div class="col-6"><strong>B/L Number:</strong></div>
                        <div class="col-6 shipment-blno">-</div>

                        <div class="col-6"><strong>Payment Terms:</strong></div>
                        <div class="col-6 shipment-payment">Prepaid</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="table-responsive mb-4">
            <table class="table table-bordered align-middle" id="invoiceTable">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Payment Type</th>
                        <th>Invoice Detail</th>
                        <th class="text-center">Unit</th>
                        <th class="text-center">Qty</th>
                        <th class="text-end">Rate</th>
                        <th class="text-end">Amount</th>
                        <th class="text-end" style="display:none;">VAT %</th>
                        <th class="text-end vatPercentDisplay">VAT</th>
                        <th class="text-end">Total Amount</th>
                        <th width="120">Action</th>
                    </tr>
                </thead>

                <tbody>



                </tbody>
            </table>
        </div>

        <div class="row g-4">
            <div class="col-lg-7">
                <div class="info-card">
                    <div class="section-title">Amount in Words</div>

