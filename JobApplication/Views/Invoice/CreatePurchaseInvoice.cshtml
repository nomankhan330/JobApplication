                        </td>
                    </tr>

                    <tr>
                        <th>Advance</th>
                        <td class="text-end">
                            <input type="number"
                                   id="advanceAmount"
                                   class="form-control text-end summary-calc"
                                   value="0.00"
                                   step="0.01" min="1">
                        </td>
                    </tr>

                    <tr>
                        <th>Discount</th>
                        <td class="text-end">
                            <input type="number"
                                   id="discountAmount"
                                   class="form-control text-end summary-calc"
                                   value="0.00"
                                   step="0.01" min="1">
                        </td>
                    </tr>

                    <tr>
                        <th>Net Amount</th>
                        <td class="text-end">
                            <input type="text"
                                   id="netAmount"
                                   class="form-control text-end"
                                   value="0.00"
                                   readonly>
                        </td>
                    </tr>

                    <tr>
                        <th>VAT Amount</th>
                        <td class="text-end">
                            <input type="text"
                                   id="vatAmount"
                                   class="form-control text-end"
                                   value="0.00"
                                   readonly>
                        </td>
                    </tr>

                    <tr class="grand-total">
                        <th>Grand Total</th>
                        <td class="text-end">
                            <input type="text"
                                   id="grandTotal"
                                   class="form-control text-end fw-bold"
                                   value="0.00"
                                   readonly>
                        </td>
                    </tr>

                </table>
            </div>
        </div>

        <div class="row g-4">

            <div class="col-lg-12 mt-5">
                <div class="info-card">
                    <button class="btn btn-primary" type="button" id="btnSaveInvoice">Save</button>
                </div>
            </div>



        </div>

