@{
    Layout = null;
}

<!doctype html>
<html lang="en">

<head>

    <meta charset="utf-8" />
    <title>Forgot Password | C & F Management System</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta content="C & F Management System" name="description" />
    <meta content="Themesdesign" name="author" />
    <!-- App favicon -->
    <link rel="shortcut icon" href="~/assets/images/favicon.ico">

    <!-- Bootstrap Css -->
    <link href="~/assets/css/bootstrap.min.css" id="bootstrap-style" rel="stylesheet" type="text/css" />
    <!-- Icons Css -->
    <link href="~/assets/css/icons.min.css" rel="stylesheet" type="text/css" />
    <!-- App Css-->
    <link href="~/assets/css/app.min.css" id="app-style" rel="stylesheet" type="text/css" />
    <!-- Toastr Css-->
    <link rel="stylesheet" href="//cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/css/toastr.min.css" asp-append-version="true" />
</head>

<body class="auth-body-bg">
    <div class="bg-overlay"></div>
    <div class="wrapper-page">
        <div class="container-fluid p-0">
            <div class="card">
                <div class="card-body">

                    <div class="text-center" style="margin-bottom: -45px;">
                        <div class="mb-3">
                            <a href="#" class="auth-logo">
                                <img src="~/assets/images/logo-dark.png" height="200" class="logo-dark mx-auto" alt="">
                                <img src="~/assets/images/logo-dark.png" height="30" class="logo-light mx-auto" alt="">
                            </a>
                        </div>
                    </div>

                    <h4 class="text-muted text-center font-size-18"><b>Forgot Password</b></h4>

                    <!-- Step 1: Verify -->
                    <div class="p-3" id="step-verify">
                        <form class="form-horizontal mt-3" action="#" id="verify-form">
                            <div class="form-group mb-3 row">
                                <div class="col-12">
                                    <input class="form-control" type="text" placeholder="User ID" id="userid">
                                </div>
                            </div>
                            <div class="form-group mb-3 row">
                                <div class="col-12">
                                    <input class="form-control" type="tel" placeholder="Security Answer (Phone / CNIC)" id="answer">
                                </div>
                            </div>
                            <div class="text-muted" style="font-size: 13px; margin-top: -10px;">
                                Verify using your registered <b>Phone Number</b> or <b>CNIC</b>.
                            </div>
                            <div class="form-group mb-0 text-center row mt-3 pt-1">
                                <div class="col-12">
                                    <button class="btn btn-info w-100 waves-effect waves-light" id="btnverify">Verify</button>
                                </div>
                            </div>
                        </form>
                    </div>

                    <!-- Step 2: Reset -->
                    <div class="p-3" id="step-reset" style="display:none;">
                        <p class="text-muted text-center mb-3">Verified: <b id="lbluser"></b></p>
                        <form class="form-horizontal mt-3" action="#" id="reset-form">
                            <div class="form-group mb-3 row">
                                <div class="col-12">
                                    <input class="form-control" type="password" placeholder="New Password" id="newpass">
                                </div>
                            </div>
                            <div class="form-group mb-3 row">
                                <div class="col-12">
                                    <input class="form-control" type="password" placeholder="Confirm Password" id="confirmpass">
                                </div>
                            </div>
                            <div class="form-group mb-0 text-center row mt-3 pt-1">
                                <div class="col-12">
                                    <button class="btn btn-success w-100 waves-effect waves-light" id="btnreset">Reset Password</button>
                                </div>
                            </div>
                        </form>
                    </div>

                    <div class="mt-3 text-center">
                        <a href="/Home/Login" class="text-muted"><i class="mdi mdi-arrow-left me-1"></i> Back to Login</a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="container-fluid" style="position: fixed; bottom: 10px; left: 0; right: 0; padding: 0 20px; color: #ffffff; font-weight: 600; font-size: 1rem; text-shadow: 0 1px 3px rgba(0,0,0,.8);">
        <div class="row">
            <div class="col-sm-6">
                <img src="~/assets/images/mz-logo-white.png" alt="MZ Solutions" height="22" class="me-2">
                <span>&copy; 2026 MZ Solutions Pvt. Ltd. All rights reserved.</span>
            </div>
            <div class="col-sm-6">
                <div class="text-end">
                    <span>Designed and developed by MZ Solutions.</span>
                </div>
            </div>
        </div>
    </div>

    <!-- JAVASCRIPT -->
    <script src="~/assets/libs/jquery/jquery.min.js"></script>
    <script src="~/assets/libs/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/assets/libs/metismenu/metisMenu.min.js"></script>
    <script src="~/assets/libs/simplebar/simplebar.min.js"></script>
    <script src="~/assets/libs/node-waves/waves.min.js"></script>
    <script src="~/assets/libs/jquery.easing/jquery.easing.min.js"></script>

    <!-- toastr -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>

    <script>
        $(document).ready(function () {

            var verifiedUserId = null;
            var $btnVerify = $('#btnverify');
            var $btnReset = $('#btnreset');

            function showMessage(Message, type) {
                toastr.options = {
                    positionClass: 'toast-top-right',
                    toastClass: 'custom-toastr',
                    closeMethod: 'fadeout',
                    timeOut: 2500
                };
                if (type == "info")
                    toastr.info(Message);
                else if (type == "success")
                    toastr.success(Message);
                else if (type == "error")
                    toastr.error(Message);
            }

            $('#verify-form').on('submit', function (e) {
                e.preventDefault();
                var userid = $('#userid').val().trim();
                var answer = $('#answer').val().trim();

                if (!userid || !answer) {
                    showMessage("Please enter User ID and security answer", "error");
                    return;
                }

                $btnVerify.prop("disabled", true).text("Verifying...");

                $.ajax({
                    url: '/Account/VerifySecurityAnswer',
                    method: 'POST',
                    data: { userId: userid, answer: answer },
                    success: function (data) {
                        if (data.errorCode == 200) {
                            verifiedUserId = data.userId;
                            $('#lbluser').text(data.userName + ' (' + data.userId + ')');
                            $('#step-verify').hide();
                            $('#step-reset').show();
                            showMessage("Verified successfully!", "success");
                        } else {
                            showMessage(data.errorMessage, "error");
                        }
                        $btnVerify.prop("disabled", false).text("Verify");
                    },
                    error: function () {
                        showMessage("An error occurred", "error");
                        $btnVerify.prop("disabled", false).text("Verify");
                    }
                });
            });

            $('#reset-form').on('submit', function (e) {
                e.preventDefault();
                var newpass = $('#newpass').val();
                var confirmpass = $('#confirmpass').val();

                if (!newpass || !confirmpass) {
                    showMessage("Please fill all fields", "error");
                    return;
                }
                if (newpass !== confirmpass) {
                    showMessage("Passwords do not match", "error");
                    return;
                }

                $btnReset.prop("disabled", true).text("Resetting...");

                $.ajax({
                    url: '/Account/ResetPassword',
                    method: 'POST',
                    data: { userId: verifiedUserId, newPassword: newpass },
                    success: function (data) {
                        if (data.errorCode == 200) {
                            showMessage(data.errorMessage, "success");
                            setTimeout(function () {
                                window.location = '/Home/Login';
                            }, 1500);
                        } else {
                            showMessage(data.errorMessage, "error");
                            $btnReset.prop("disabled", false).text("Reset Password");
                        }
                    },
                    error: function () {
                        showMessage("An error occurred", "error");
                        $btnReset.prop("disabled", false).text("Reset Password");
                    }
                });
            });
        });
    </script>
</body>
</html>