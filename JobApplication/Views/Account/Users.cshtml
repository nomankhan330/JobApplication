    function loadCostCenters(selectedIds = []) {

        var $dropdown = $('#CostCenterIds');

        $.ajax({
            url: '/Dropdown/GetCostCenter',
            type: 'GET',
            dataType: 'json',
            success: function (response) {

                // console.log("GetCostCenter", response);

                $dropdown.empty();

                $.each(response.data, function (i, item) {
                    $dropdown.append(
                        `<option value="${item.Id}">${item.CostCenterName}</option>`
                    );

                    console.log("CostCenterName", item.CostCenterName);
                });
                
                // Pre-select values if any (for edit case)
                if (selectedIds.length > 0) {
