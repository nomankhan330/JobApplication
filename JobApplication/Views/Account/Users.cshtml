@inject BusinessLogic.Interfaces.ISessionHelper SessionHelper
@{
    ViewData["Title"] = "Users";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Head {
    <!-- DataTables -->
    <link href="~/assets/libs/datatables.net-bs4/css/dataTables.bootstrap4.min.css" rel="stylesheet" type="text/css" />
    <link href="~/assets/libs/datatables.net-buttons-bs4/css/buttons.bootstrap4.min.css" rel="stylesheet" type="text/css" />
    <link href="~/assets/libs/select2/css/select2.min.css" rel="stylesheet" type="text/css">



    <style>
        /* .dataTables_filter {
            display:none;
        } */

        /* Right align pagination */
        .dataTables_paginate {
            text-align: right !important;
        }

        /* Rounded pagination buttons */
        .pagination-rounded .page-link {
            border-radius: 50px !important;
        }

        /* Optional: Better spacing */
        .dataTables_paginate .pagination {
            justify-content: flex-end !important;
        }

       
        .select2-container.is-invalid .select2-selection {
            border: 1px solid #dc3545 !important;
        }
        
    </style>
}


<div class="page-content">
    <div class="container-fluid">

        <!-- start page title -->
        <div class="row">
            <div class="col-12">
                <div class="page-title-box d-sm-flex align-items-center justify-content-between">
                    <h4 class="mb-sm-0">Users</h4>

                </div>
            </div>
        </div>
        <!-- end page title -->

        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-body">

                        <!-- Collapse Button -->
                        <div class="mb-3" style="display:block;">
                            <button class="btn btn-info" type="button" data-bs-toggle="collapse" data-bs-target="#filterSection" aria-expanded="false" aria-controls="filterSection">
                                <i class="fa fa-filter"></i> Filter Users
                            </button>
                        </div>

                        <!-- Filter Section (Collapsed by Default) -->
                        <div class="collapse" id="filterSection">
                            <div class="card mb-3 p-3">

                                <div class="row mb-3">
                                    <div class="col-md-3">
                                        <select id="filterUserType" class="form-control">
                                            <option value="">All User Types</option>
                                            <option value="1">Admin</option>
                                            <option value="2">Authorize</option>
                                            <option value="3">UnAuthorize</option>
                                        </select>
                                    </div>

                                    <div class="col-md-3">
                                        <input id="filterUserName" class="form-control" placeholder="User name search" />
                                    </div>

                                    <div class="col-md-3">
                                        <select id="filterStatus" class="form-control">
                                            <option value="">All Status</option>
                                            <option value="true">Active</option>
                                            <option value="false">Inactive</option>
                                        </select>
                                    </div>

                                  
                                </div>

                                <div class="row">
                                    <div class="col-md-4 d-flex align-items-end">
                                        <button id="btnSearch" class="btn btn-primary me-2">
                                            <i class="fas fa-search"></i> Search
                                        </button>
                                        <button id="btnClear" class="btn btn-secondary">
                                            <i class="fas fa-window-close me-1"></i> Clear
                                        </button>
                                    </div>
                                </div>

                            </div>
                        </div>

                     
                        <!-- Add User Button -->
                        <div class="text-end mb-3">
                            <button class="btn btn-success" id="btnAdd">
                                <i class="fa fa-plus"></i> Add User
                            </button>
                        </div>

                        <!-- Table User -->
                        <table id="datatable" class="table table-striped table-bordered dt-responsive nowrap" style="border-collapse: collapse; border-spacing: 0; width: 100%;">
                            <thead>
                                <tr>
                                    <th>Id</th>
                                    <th>Full Name</th>
                                    <th>User Name</th>
                                    <th>User Type</th>
                                    <th>Assigned Cost Center</th>
                                    <th>Created Date</th>
                                    <th>Status</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                        </table>
                        <div id="tableLoader" style="text-align:center; padding:40px; display:none;">
                            <div class="spinner-border text-primary" role="status">
                            </div>
                            <div class="mt-2">Loading...</div>
                        </div>
                    </div>
                </div>
            </div> <!-- end col -->
        </div>

    </div>
</div>

<!-- User Modal -->
<div class="modal fade" id="userModal" tabindex="-1" aria-labelledby="userModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title" id="userModalLabel">Add / Edit User</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">
                <form id="userForm">
                    <div class="row">
                        
                        <input type="hidden" id="Id" name="Id" value="" />

                        <div class="col-md-6 mb-3">
                            <label class="form-label" for="UserName">Full Name <span class="required-label">*</span></label>
                            <input type="text" class="form-control" id="UserName" name="UserName" placeholder="User’s complete name" required />
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label" for="UserId">Username <span class="required-label">*</span></label>
                            <input type="text" class="form-control" id="UserId" name="UserId" placeholder="Login ID" required data-type="alphanumeric" />
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label" for="Password">Password <span class="required-label">*</span></label>
                            <input type="password" class="form-control" id="Password" name="Password" placeholder="Login Password" required />
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label" for="UserType">User Type <span class="required-label">*</span></label>
                            <select class="form-control select-my" id="UserType" name="UserType" required>
                               
                            </select>
                        </div>

                        @if(SessionHelper.LoginType == 1)
                        {
                            <div class="col-md-6 mb-3" style="display:none;">
                                <label class="form-label" for="ReferenceId">Reference Admin <span class="required-label">*</span></label>
                                <select class="form-control select-my" id="ReferenceId" name="ReferenceId" required>
                                </select>
                            </div>
                        }


                        <div class="col-md-6 mb-3">
                            <label class="form-label" for="CostCenterIds">Cost Center</label>
                            <select class="form-control" id="CostCenterIds" name="CostCenterIds[]" multiple required>
                            </select>
                        </div>


                        <div class="col-md-6 mb-3">
                            <label class="form-label" for="Email">Email</label>
                            <input type="email" class="form-control" id="Email" name="Email" placeholder="Email Address" required data-type="email" />
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label" for="PhoneNo">Phone Number</label>
                            <input type="text" class="form-control" id="PhoneNo" name="PhoneNo" placeholder="Phone #" data-type="phone" />
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label" for="CNIC">CNIC Number</label>
                            <input type="text" class="form-control" id="CNIC" name="CNIC" placeholder="CNIC" />
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label" for="Photo">User Photo</label>
                            <input type="file" class="form-control select-my" id="PhotoFile" name="PhotoFile" />
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label" for="IsActive">Status <span class="required-label">*</span></label>
                            <select class="form-control select-my" id="IsActive" name="IsActive" required>
                                <option value="" disabled>Select Status</option>
                                <option value="true" selected>Active</option>
                                <option value="false">Inactive</option>
                            </select>
                        </div>

                        <div class="col-md-12 mb-3">
                            <img id="PhotoPreview" src="" style="max-width:150px; display:none; border:1px solid #ccc; padding:5px; border-radius:5px;" />
                        </div>


                        <fieldset class="border rounded p-3 mt-3 mb-3" id="CompanyDetails" style="display:none;">
                            <legend class="float-none w-auto px-2 fw-bold">
                                Company Details
                            </legend>

                            <div class="row">

                                <!-- Company Name -->
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Company Name (English)</label>
                                    <input type="text" class="form-control"
                                           id="CompanyName"
                                           name="CompanyName"
                                           placeholder="Company Name">
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Company Name (Arabic)</label>
                                    <input type="text" class="form-control"
                                           id="CompanyNameAr"
                                           name="CompanyNameAr"
                                           dir="rtl"
                                           placeholder="اسم الشركة">
                                </div>

                                <!-- Establishment -->
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Establishment Name (English)</label>
                                    <input type="text" class="form-control"
                                           id="EstablishmentName"
                                           name="EstablishmentName"
                                           placeholder="Establishment Name">
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Establishment Name (Arabic)</label>
                                    <input type="text" class="form-control"
                                           id="EstablishmentNameAr"
                                           name="EstablishmentNameAr"
                                           dir="rtl"
                                           placeholder="اسم المؤسسة">
                                </div>

                                <!-- Country -->
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Country (English)</label>
                                    <input type="text" class="form-control"
                                           id="Country"
                                           name="Country"
                                           placeholder="Country">
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Country (Arabic)</label>
                                    <input type="text" class="form-control"
                                           id="CountryAr"
                                           name="CountryAr"
                                           dir="rtl"
                                           placeholder="الدولة">
                                </div>

                                <!-- City -->
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">City (English)</label>
                                    <input type="text" class="form-control"
                                           id="City"
                                           name="City"
                                           placeholder="City">
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label class="form-label">City (Arabic)</label>
                                    <input type="text" class="form-control"
                                           id="CityAr"
                                           name="CityAr"
                                           dir="rtl"
                                           placeholder="المدينة">
                                </div>

                                <!-- VAT -->
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">VAT Number</label>
                                    <input type="text"
                                           class="form-control"
                                           id="Vatnumber"
                                           name="Vatnumber"
                                           placeholder="VAT Number">
                                </div>

                            </div>
                        </fieldset>
                    </div>
                </form>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" id="btnSubmit" class="btn btn-primary">Submit</button>
            </div>

        </div>
    </div>
</div>


@section Script {

<!-- Required datatable js -->
<script src="~/assets/libs/datatables.net/js/jquery.dataTables.min.js"></script>
<script src="~/assets/libs/datatables.net-bs4/js/dataTables.bootstrap4.min.js"></script>
<script src="~/assets/libs/select2/js/select2.min.js"></script>

<script>

    var loginType = parseInt('@SessionHelper.LoginType');

    $(document).ready(function () {

        applyGlobalInputRules();
        
        var myModal = new bootstrap.Modal(document.getElementById('userModal'), {
            backdrop: 'static',
            keyboard: false
        });

        $('#CostCenterIds').select2({
            width: '100%',
            dropdownParent: $('#userModal'),
            placeholder: 'Select Cost Center',
            allowClear: true
        });

        loadRecords();
        loadUserType();
        loadAdmin();
        loadCostCenters();

        if (loginType === 1) {
            $('#ReferenceId').attr('required', 'required');
        } else {
            $('#ReferenceId').removeAttr('required');
        }

            
        $('#btnAdd').on('click', function () {

            $("#userForm")[0].reset();
            $("#userForm [required]").removeClass("is-invalid");
            $("#Password").attr("required", true);
            $("#PhotoPreview").attr("src", "").hide();
            $("#Id").val('0');

            

            $('#CostCenterIds').select2('destroy'); // remove old
            $('#CostCenterIds').select2({
                width: '100%',
                dropdownParent: $('#userModal'),
                placeholder: 'Select Cost Center',
                allowClear: true
            });

            if (loginType === 1) {
                $('#CompanyDetails').show();
                $("#CostCenterIds").closest(".col-md-6").hide();
                $("#CostCenterIds").prop("required", false);
            }else {

                $("#CostCenterIds").closest(".col-md-6").show();
                $("#CostCenterIds").prop("required", true);

                $('#CompanyDetails').hide();
            }

            loadUserType();
            //var userModal = new bootstrap.Modal(document.getElementById('userModal'));
            myModal.show();
        });

        $('#btnSubmit').on('click', function () {

            if (!validateForm()) return;
            
            $('#UserType').prop('disabled', false);

            var formData = new FormData($("#userForm")[0]);
            var $btn = $(this); // current button reference

            // for (let [key, value] of formData.entries()) {
            //     console.log(key, value);
            // }
            // return;

            $.ajax({
                url: "/Account/SaveUser",
                type: "POST",
                data: formData,
                contentType: false,
                processData: false,
                beforeSend: function () {
                    $btn.prop("disabled", true).text("Processing...");
                },
                success: function (data) {
                    console.log("data", data);

                    if (data.errorCode == 200) {
                        showMessage("Data saved successfully!", "success");
                        myModal.hide();
                        loadRecords();
                    } else {
                        showMessage(data.errorMessage, "error");
                    }
                },
                error: function (error) {
                    showMessage("An error occurred", "error");
                },
                complete: function () {
                    $btn.prop("disabled", false).text("Submit");
                }
            });

        });

        $(document).on("click", ".btn-edit", function () {

            let Id = $(this).data("id");
            
            $("#userForm")[0].reset();
            $("#userForm [required]").removeClass("is-invalid");

            $.ajax({
                type: "post",
                url: "/Account/GetUserById",
                data: { "Id": Id },
                async: false,
                success: function (resp) {
                    
                    console.log("edit resp", resp);
                    
                    let data = resp.User;
                    //console.log("IsActive", data.IsActive);

                    $("#Id").val(data.Id);
                    $("#UserId").val(data.UserId);
                    $("#UserName").val(data.UserName);
                    $("#Email").val(data.Email);
                    $("#PhoneNo").val(data.PhoneNo);
                    $("#CNIC").val(data.CNIC);
                    $("#IsActive").val(String(data.IsActive).toLowerCase());

                    $("#CompanyName").val(data.CompanyName);
                    $("#EstablishmentName").val(data.EstablishmentName);
                    $("#Country").val(data.Country);
                    $("#City").val(data.City);
                    $("#Vatnumber").val(data.Vatnumber);

                    $("#Password").removeAttr("required");
                    $("#Password").val("");

                    loadUserType(data.UserType);
                    //loadAdmin(data.ReferenceId);
                    loadCostCenters(data.CostCenterIds);

                    if (data.Photo) {
                        $("#PhotoPreview")
                            .attr("src", "/uploads/users/" + data.Photo)
                            .show();
                    } else {
                        $("#PhotoPreview").hide();
                    }
                   
                    if (data.UserType == "2") {
                        $("#CostCenterIds")
                            .closest(".col-md-6")
                            .hide();

                        $("#CostCenterIds")
                            .prop("required", false)
                            .removeAttr("required")
                            .trigger("change");


                        $("#CompanyDetails").show();
                    } else {
                        $("#CostCenterIds")
                            .show()
                            .prop("required", true)
                            .attr("required", "required");

                        $("#CompanyDetails").hide();
                    }

                    myModal.show();
                }
            });
        });

        $(document).on("click", ".btn-delete", function () {

            let id = $(this).data("id");

            confirmDelete(function () {

                $.ajax({
                    type: "POST",
                    url: "/Account/DeleteUserById",
                    data: { id: id },
                    success: function (resp) {
                        if (resp.errorCode === 200) {
                            showMessage('Deleted successfully', 'success');
                            loadRecords();
                        } else {
                            showMessage('Error: ' + resp.errorMessage, 'error');
                        }
                    },
                    error: function () {
                        showMessage('An error occurred while trying to delete the Record', 'error');
                    }
                });

            });

              
        });

        // Status
        $(document).on("click", ".btn-toggle", function () {

            let id = $(this).data("id");
                
            Swal.fire({
                title: "Are you sure?",
                text: "You want to change user status",
                icon: "warning",
                showCancelButton: true,
                confirmButtonText: "Yes, update it!"
            }).then((result) => {

                if (!result.isConfirmed) return;

                $.ajax({
                    type: "POST",
                    url: "/Account/ToggleUserStatus",
                    data: { id: id },
                    success: function (res) {

                        if (!res || res.errorCode !== 200) {
                            Swal.fire("Error", res.errorMessage || "Something went wrong", "error");
                            return;
                        }

                        Swal.fire("Success", "Status updated successfully", "success");

                        //$('#datatable').DataTable().ajax.reload(null, false);
                        loadRecords();
                    }
                });

            });

        });

        $("#PhotoFile").on("change", function () {
            let file = this.files[0];
            if (file) {
                let reader = new FileReader();
                reader.onload = function (e) {
                    $("#PhotoPreview").attr("src", e.target.result).show();
                };
                reader.readAsDataURL(file);
            }
        });

        $("#btnClear").click(function () {

            $("#filterSection").find("input").val("");
            $("#filterSection").find("select").val("");

            // Example: call your search function again
            loadRecords();
        });
    });


    function loadRecords() {

        // Show loader
        $("#tableLoader").show();

        // Destroy table if already initialized
        if ($.fn.DataTable.isDataTable('#datatable')) {
            $('#datatable').DataTable().clear().destroy();
        }

        // Clear table body before loading
        $("#datatable tbody").html("");

        $.ajax({
            url: "/Account/GetUser",
            type: "POST",
            data: { filters: [] },

            beforeSend: function () {
                $("#tableLoader").show();   // show loader
            },

            success: function (res) {

                if (res.errorCode !== 200) {
                    alert(res.errorMessage);
                    return;
                }

                res.data = res.data.map(x => ({
                    ...x,
                    StatusName: x.IsActive ? "Active" : "Inactive",
                    StatusBadgeClass: x.IsActive ? "badge bg-success" : "badge bg-danger"
                }));

                // Initialize DataTable
                table = $("#datatable").DataTable({
                    data: res.data,
                    columns: [
                        { data: "Id" },
                        { data: "UserName" },
                        { data: "UserId" },
                        {
                            data: "UserTypeName",
                            render: data => {
                                const types = {
                                    "Admin": ["type-admin", "fas fa-user-shield"],
                                    "Authorize": ["type-authorize", "fas fa-check-circle"],
                                    "UnAuthorize": ["type-unauthorize", "fas fa-times-circle"]
                                };

                                const [cls, icon] = types[data] || ["type-default", "fas fa-user"];

                                return `<span class="type-badge ${cls}">
                                            <i class="${icon} me-1"></i>${data}
                                        </span>`;
                            }
                        },
                        //{ data: "CostCenters" },
                        {
                            data: "CostCenters",
                            render: function (data) {

                                if (!data)
                                    return '<span class="text-muted">-</span>';

                                return data
                                    .split(',')
                                    .map(x => `
                                        <span class="costcenter-badge">
                                            <i class="fas fa-building me-1"></i>${x.trim()}
                                        </span>
                                    `)
                                    .join(' ');
                            }
                        },
                        {
                            data: "CreatedOn",
                            render: d => moment(d).format("YYYY-MM-DD")
                        },
                        {
                            data: "IsActive",
                            render: function (data) {
                                return `<span class="status-badge ${data ? 'status-active' : 'status-inactive'}">
                                            <span class="status-dot"></span>
                                            ${data ? 'Active' : 'Inactive'}
                                        </span>`;
                            }
                        },
                        {
                            data: null,
                            orderable: false,
                            searchable: false,
                            className: "text-center align-middle",
                            render: function (data) {

                                // 1. Check karein kya current row ka user type 1 hai?
                                // (Apne actual backend key name ke mutabiq 'data.UserType' ya 'data.UserTypeId' check kar lein)
                                const isUserType1 = (data.UserType == 1 || data.UserTypeId == 1);

                                // Disabled state ke liye common style (takay button thoda transparent/greyish dikhe)
                                const disabledStyle = "opacity: 0.5; cursor: not-allowed;";

                                // 2. Show Password Button (sirf loginType == 1 ke liye show hoga)
                                let showPasswordBtn = '';
                                if (loginType == 1) {
                                    const isPassDisabled = isUserType1 ? "disabled" : "";
                                    const passStyle = isUserType1 ? disabledStyle : "";

                                    showPasswordBtn = `
                                        <button class="action-btn btn-show-password"
                                                data-userid="${data.UserId}"
                                                data-password="${data.Password || ''}"
                                                title="${isUserType1 ? 'Not allowed for User Type 1' : 'Show Password'}"
                                                ${isPassDisabled}
                                                style="background-color: #ffc107; color: #000; ${passStyle}">
                                            <i class="fas fa-key"></i>
                                        </button>
                                    `;
                                }

                                // 3. Edit Button status configuration
                                const isEditDisabled = isUserType1 ? "disabled" : "";
                                const editStyle = isUserType1 ? disabledStyle : "";

                                // 4. Archive / Toggle Button status configuration
                                const isToggleDisabled = isUserType1 ? "disabled" : "";
                                const toggleStyle = isUserType1 ? disabledStyle : "";

                                return `
                                    <div class="action-btn-group">

                                        <button class="action-btn btn-view" style="display:none;"
                                                data-id="${data.Id}"
                                                title="View">
                                            <i class="fas fa-eye"></i>
                                        </button>

                                        <button class="action-btn btn-edit"
                                                data-id="${data.Id}"
                                                title="${isUserType1 ? 'Editing is disabled for User Type 1' : 'Edit'}"
                                                ${isEditDisabled}
                                                style="${editStyle}">
                                            <i class="fas fa-pen"></i>
                                        </button>

                                        ${showPasswordBtn}

                                        <button class="action-btn btn-delete" style="display:none;"
                                                data-id="${data.Id}"
                                                title="Delete">
                                            <i class="fas fa-trash"></i>
                                        </button>

                                        <button class="action-btn btn-toggle"
                                                data-id="${data.Id}"
                                                title="${isUserType1 ? 'Archiving is disabled for User Type 1' : 'Archive'}"
                                                ${isToggleDisabled}
                                                style="${toggleStyle}">
                                            <i class="fas fa-trash"></i>
                                        </button>

                                    </div>
                                `;
                            }
                        }
                    ]
                });

                // Filters
                $("#filterUserType").on("change", function () {
                    table.column(3).search(this.value ? $(this).find("option:selected").text() : "").draw();
                });

                $("#filterStatus").on("change", function () {
                    let val = $(this).val();
                    let text = val === "true" ? "Active" : val === "false" ? "Inactive" : "";
                    table.column(5).search(text).draw();
                });

                $("#filterUserName").on("keyup", function () {
                    table.column(1).search(this.value).draw();
                });

            },

            complete: function () {
                // Hide loader after data is fully loaded
                $("#tableLoader").hide();
            }
        });
    }

        $(document).off('click', '.btn-show-password').on('click', '.btn-show-password', function () {
            const btn = $(this);
            const userId = btn.data('userid');
            const encryptedPassword = btn.data('password');
                    
            if (!encryptedPassword) {
                alert("The encrypted password for this user is missing or empty.");
                return;
            }

            // Set loading indicator on the key button during processing
            const originalIcon = btn.html();
            btn.html('<i class="fas fa-spinner fa-spin"></i>').attr('disabled', true);

            $.ajax({
                url: "/Account/DecryptPassword",
                type: "POST",
                data: {
                    userId: userId,
                    encryptedPassword: encryptedPassword
                },
                success: function (response) {
                    if (response.success) {
                        // Khoobsurat SweetAlert2 Popup with Copy Button
                        Swal.fire({
                            title: '<strong>Decrypted Password</strong>',
                            icon: 'success',
                            html: `
                                <div class="mt-3">
                                    <div class="input-group">
                                        <input type="text" id="swal-password-field" class="form-control text-center fw-bold"
                                               value="${response.password}" readonly
                                               style="font-size: 1.2rem; letter-spacing: 1px; background-color: #f8f9fa;">
                                        <button class="btn btn-outline-secondary" type="button" id="btn-copy-swal" title="Copy to Clipboard">
                                            <i class="fas fa-copy"></i> Copy
                                        </button>
                                    </div>
                                    <small id="copy-toast-msg" class="text-success d-block mt-2" style="display:none; font-weight: 500;"></small>
                                </div>
                            `,
                            showCloseButton: true,
                            confirmButtonText: '<i class="fas fa-times"></i> Close',
                            confirmButtonColor: '#6c757d',
                            didOpen: () => {
                                // Copy to Clipboard functionality inside the popup
                                document.getElementById('btn-copy-swal').addEventListener('click', function() {
                                    const passwordInput = document.getElementById('swal-password-field');

                                    // Clipboard API se copy karna
                                    navigator.clipboard.writeText(passwordInput.value).then(() => {
                                        // Button ka UI change karna taaki user ko pata chale copy ho gaya
                                        const copyBtn = document.getElementById('btn-copy-swal');
                                        const toastMsg = document.getElementById('copy-toast-msg');

                                        copyBtn.innerHTML = '<i class="fas fa-check text-success"></i> Copied!';
                                        copyBtn.classList.remove('btn-outline-secondary');
                                        copyBtn.classList.add('btn-outline-success');

                                        // 2 seconds baad button ko wapas normal kar dena
                                        setTimeout(() => {
                                            copyBtn.innerHTML = '<i class="fas fa-copy"></i> Copy';
                                            copyBtn.classList.remove('btn-outline-success');
                                            copyBtn.classList.add('btn-outline-secondary');
                                        }, 2000);
                                    }).catch(err => {
                                        console.error('Could not copy text: ', err);
                                    });
                                });
                            }
                        });
                    } else {
                        // Error message popup
                        Swal.fire({
                            icon: 'error',
                            title: 'Decryption Failed',
                            text: response.message,
                            confirmButtonColor: '#dc3545'
                        });
                    }
                },
                error: function (xhr, status, error) {
                    console.error("AJAX Error:", error);
                    alert("Failed to communicate with the server. Please try again.");
                },
                complete: function () {
                    // Reset button to its original state
                    btn.html(originalIcon).attr('disabled', false);
                }
            });
        });

    function loadUserType(selectedId = null){
        //alert(loginType)
        $.ajax({
            url: '/Dropdown/GetUserType',
            type: 'GET',
            dataType: 'json',
            success: function (response) {

                let $dropdown = $('#UserType');
                $dropdown.empty();
                $dropdown.append('<option value="" disabled>Select User Type</option>');
                $dropdown.prop('disabled', false);

                $.each(response.data, function (i, item) {
                    
                    // Add case only for super admin
                    if (loginType === 1 && !selectedId && item.Id > 2) {
                        return;
                    }

                        // Add case only for admin
                    if (loginType === 2 && !selectedId && item.Id === 2) {
                        return;
                    }

                    $dropdown.append(`<option value="${item.Id}">${item.Name}</option>`);
                });

                // Set selected if ID provided
                if (selectedId !== null && selectedId !== "" && selectedId !== undefined) {
                    $dropdown.val(selectedId);
                    
                    // Edit case super admin
                    // if (loginType == 1) {
                    //     alert("loginType")
                    //     $dropdown.prop('disabled', true);
                    // }

                    // Edit case admin
                    if (loginType == 2 && selectedId === 2) {
                        $dropdown.prop('disabled', true);
                    } else if(loginType == 1){
                        $dropdown.prop('disabled', true);
                    }
                    else {
                        $dropdown.find('option[value="2"]').remove();
                        $dropdown.prop('disabled', false);
                    }
                }
            },
            error: function (xhr, status, error) {
                console.error("Error loading user types:", error);
            }
        });
    }

    function loadAdmin(selectedId = null){

        $.ajax({
            url: '/Dropdown/GetAdmin',
            type: 'GET',
            dataType: 'json',
