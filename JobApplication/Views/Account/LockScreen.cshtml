@inject BusinessLogic.Interfaces.ISessionHelper SessionHelper
@{
    Layout = null;
}

<!doctype html>
<html lang="en">

<head>

    <meta charset="utf-8" />
    <title>Lock Screen | C & F Management System</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta content="C & F Management System" name="description" />
    <meta content="Themesdesign" name="author" />
    <!-- App favicon -->
    <link rel="shortcut icon" href="~/assets/images/favicon.ico">

    <!-- Bootstrap Css -->
    <link href="~/assets/css/bootstrap.min.css" id="bootstrap-style" rel="stylesheet" type="text/css" />
    <!-- Icons Css -->
    <link href="~/assets/css/icons.min.css" rel="stylesheet" type="text/css" />
    <!-- App Css-->
    <link href="~/assets/css/app.min.css" id="app-style" rel="stylesheet" type="text/css" />
    <!-- Toastr Css-->
    <link rel="stylesheet" href="//cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/css/toastr.min.css" asp-append-version="true" />
</head>

<body class="auth-body-bg">
    <div class="bg-overlay"></div>
    <div class="wrapper-page">
        <div class="container-fluid p-0">
            <div class="card">
                <div class="card-body">

                    <div class="text-center mt-3">
                        <img src="~/uploads/users/@SessionHelper.Photo" alt="Profile" class="avatar-lg rounded-circle img-thumbnail">
                        <h4 class="mt-3 mb-1">@SessionHelper.UserName</h4>
                        <p class="text-muted mb-3">Enter your password to unlock your screen</p>
                    </div>

                    <div class="p-3">
                        <form class="form-horizontal mt-3" action="#" id="unlock-form">

                            <div class="form-group mb-3 row">
                                <div class="col-12">
                                    <input class="form-control" type="password" placeholder="Password" id="password">
                                </div>
                            </div>

                            <div class="form-group mb-0 text-center row mt-3 pt-1">
                                <div class="col-12">
                                    <button class="btn btn-info w-100 waves-effect waves-light" id="btnunlock">Unlock</button>
                                </div>
                            </div>
                        </form>
                    </div>

                    <div class="text-center mt-2">
                        <a href="javascript:;" class="text-muted" id="btnlogout"><i class="mdi mdi-logout me-1"></i> Not @SessionHelper.UserName? Logout</a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="container-fluid" style="position: fixed; bottom: 10px; left: 0; right: 0; padding: 0 20px; color: #ffffff; font-weight: 600; font-size: 1rem; text-shadow: 0 1px 3px rgba(0,0,0,.8);">
        <div class="row">
            <div class="col-sm-6">
                <img src="~/assets/images/mz-logo-white.png" alt="MZ Solutions" height="22" class="me-2">
                <span>&copy; 2026 MZ Solutions Pvt. Ltd. All rights reserved.</span>
            </div>
            <div class="col-sm-6">
                <div class="text-end">
                    <span>Designed and developed by MZ Solutions.</span>
                </div>
            </div>
        </div>
    </div>

    <!-- JAVASCRIPT -->
    <script src="~/assets/libs/jquery/jquery.min.js"></script>
    <script src="~/assets/libs/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/assets/libs/metismenu/metisMenu.min.js"></script>
    <script src="~/assets/libs/simplebar/simplebar.min.js"></script>
    <script src="~/assets/libs/node-waves/waves.min.js"></script>
    <script src="~/assets/libs/jquery.easing/jquery.easing.min.js"></script>

    <!-- toastr -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>

    <script>
        $(document).ready(function () {

            var $btn = $('#btnunlock');

            function showMessage(Message, type) {
                toastr.options = {
                    positionClass: 'toast-top-right',
                    toastClass: 'custom-toastr',
                    closeMethod: 'fadeout',
                    timeOut: 2000
                };
                if (type == "info")
                    toastr.info(Message);
                else if (type == "success")
                    toastr.success(Message);
                else if (type == "error")
                    toastr.error(Message);
            }

            function resetButton() {
                $btn.prop("disabled", false).text("Unlock");
            }

            $('#unlock-form').on('submit', function (e) {
                e.preventDefault();
                var password = $('#password').val();

                if (!password) {
                    showMessage("Please enter your password", "error");
                    resetButton();
                    return;
                }

                $btn.prop("disabled", true).text("Unlocking...");

                $.ajax({
                    url: '/Account/Unlock',
                    method: 'POST',
                    data: { password: password },
                    success: function (data) {
                        if (data.errorCode == 200) {
                            showMessage("Screen unlocked!", "success");
                            setTimeout(function () {
                                if (data.data == 1) {
                                    window.location = '/Account/AdminUsers';
                                } else {
                                    window.location = '/Dashboard/Index';
                                }
                            }, 500);
                        } else {
                            showMessage(data.errorMessage, "error");
                            resetButton();
                        }
                    },
                    error: function () {
                        showMessage("An error occurred", "error");
                        resetButton();
                    }
                });
            });

            $('#btnlogout').on('click', function () {
                $.ajax({
                    url: '/Account/logout',
                    method: 'POST',
                    success: function () {
                        window.location = '/Home/Login';
                    }
                });
            });
        });
    </script>
</body>
</html>