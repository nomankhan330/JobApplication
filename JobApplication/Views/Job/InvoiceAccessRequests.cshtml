@{
    ViewData["Title"] = "Invoice Access Requests";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Head {
    <!-- DataTables -->
    <link href="~/assets/libs/datatables.net-bs4/css/dataTables.bootstrap4.min.css" rel="stylesheet" type="text/css" />
    <link href="~/assets/libs/datatables.net-buttons-bs4/css/buttons.bootstrap4.min.css" rel="stylesheet" type="text/css" />

    <style>
        .dataTables_paginate {
            text-align: right !important;
        }

        .pagination-rounded .page-link {
            border-radius: 50px !important;
        }

        .dataTables_paginate .pagination {
            justify-content: flex-end !important;
        }
    </style>
}

<div class="page-content">
    <div class="container-fluid">

        <!-- Page Title -->
        <div class="row">
            <div class="col-12">
                <div class="page-title-box d-sm-flex align-items-center justify-content-between">
                    <h4 class="mb-sm-0">Invoice Access Requests</h4>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-body">

                       <div style="display:none;">
                        <!-- Filter Button -->
                        <div class="mb-3">
                            <button class="btn btn-info" type="button" data-bs-toggle="collapse" data-bs-target="#filterSection">
                                <i class="fa fa-filter"></i> Filter Customers
                            </button>
                        </div>

                        <!-- Filter Section -->
                        <div class="collapse" id="filterSection">
                            <div class="card mb-3 p-3">

                                <div class="row mb-3">

                                    <div class="col-md-3">
                                        <input id="filterCustomerName" class="form-control" placeholder="Customer Name">
                                    </div>

                                    <div class="col-md-3">
                                        <input id="filterEmail" class="form-control" placeholder="Email">
                                    </div>

                                    <div class="col-md-3">
                                        <input id="filterVatId" class="form-control" placeholder="VAT ID">
                                    </div>

                                    <div class="col-md-3">
                                        <select id="filterStatus" class="form-control">
                                            <option value="">All Status</option>
                                            <option value="true">Active</option>
                                            <option value="false">Inactive</option>
                                        </select>
                                    </div>

                                </div>

                                <div class="row">
                                    <div class="col-md-4 d-flex align-items-end">
                                        <button id="btnSearch" class="btn btn-primary me-2 w-50">Search</button>
                                        <button id="btnClear" class="btn btn-secondary w-50">Clear</button>
                                    </div>
                                </div>

                            </div>
                        </div>

                        <!-- Add Button -->
                        <div class="text-end mb-3">
                            <button class="btn btn-success" id="btnAdd">
                                <i class="fa fa-plus"></i> Add Customer
                            </button>
                        </div>
                       </div>

                        <!-- Datatable -->
                        <table id="requestTable" class="table table-striped table-bordered dt-responsive nowrap" style="width:100%">
                            <thead>
                                <tr>
                                    <th>Job No.</th>
                                    <th>Requested By</th>
                                    <th>Requested On</th>
                                    <th>Status</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                        </table>

                        <div id="tableLoader" style="text-align:center;padding:40px;display:none;">
                            <div class="spinner-border text-primary"></div>
                            <div class="mt-2">Loading...</div>
                        </div>

                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

@section Script {

    <!-- Required datatable js -->
    <script src="~/assets/libs/datatables.net/js/jquery.dataTables.min.js"></script>
    <script src="~/assets/libs/datatables.net-bs4/js/dataTables.bootstrap4.min.js"></script>

    <script>

        $(document).ready(function () {

            $('#requestTable').DataTable({
                ajax: {
                    url: '/Job/GetInvoiceAccessRequests',
                    type: 'POST',
                    dataSrc: ''
                },
                columns: [
                    { data: 'JobNumber' },
                    { data: 'UserName' },
                    {
                        data: 'RequestedOn',
                        render: function (data) {
                            return moment(data).format('DD-MM-YYYY HH:mm');
                        }
                    },
                    {
                        data: 'IsApproved',
                        render: function (data) {
                            if (data) {
                                return '<span class="badge bg-success">Approved</span>';
                            }
                            return '<span class="badge bg-warning">Pending</span>';
                        }
                    },
                    {
                        data: 'Id',
                        render: function (data, type, row) {

                            if (row.IsApproved) {
                                return '<span class="text-success">✔ Done</span>';
                            }

                            return `<button class="btn btn-sm btn-success" onclick="approveRequest(${data})">
                                        Approve
                                    </button>`;
                        }
                    }
                ]
            });

        });


        function approveRequest(requestId) {

            Swal.fire({
                title: 'Are you sure?',
                text: "You want to approve this request?",
                icon: 'question',
                showCancelButton: true,
                confirmButtonText: 'Yes, Approve'
            }).then((result) => {

                if (result.isConfirmed) {

                    $.ajax({
                        url: '/Job/ApproveInvoiceAccess',
                        type: 'POST',
                        data: { requestId: requestId },
                        success: function (response) {

                            Swal.fire({
                                icon: 'success',
                                title: 'Approved',
                                text: response.message
                            });

                            $('#requestTable').DataTable().ajax.reload();
                        }
                    });
                }
            });
        }

    </script>

}