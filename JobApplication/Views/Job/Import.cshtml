@inject BusinessLogic.Interfaces.ISessionHelper SessionHelper
@{
    ViewData["Title"] = "Job Imports";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Head {
    <!-- DataTables CSS -->
    <link href="~/assets/libs/datatables.net-bs4/css/dataTables.bootstrap4.min.css" rel="stylesheet" type="text/css" />
    <link href="~/assets/libs/datatables.net-buttons-bs4/css/buttons.bootstrap4.min.css" rel="stylesheet" type="text/css" />

    <!-- SweetAlert2 CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
}

<div class="page-content">
    <div class="container-fluid">

        <!-- Start Page Title -->
        <div class="row">
            <div class="col-12">
                <div class="page-title-box d-sm-flex align-items-center justify-content-between">
                    <h4 class="mb-sm-0">Import Jobs</h4>
                </div>
            </div>
        </div>
        <!-- End Page Title -->

        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-body">

                        <!-- Filter Button -->
                        <div class="mb-3">
                            <button class="btn btn-info" type="button" data-bs-toggle="collapse" data-bs-target="#filterSection" aria-expanded="false" aria-controls="filterSection">
                                <i class="fa fa-filter me-1"></i> Filter Jobs
                            </button>
                        </div>

                        <!-- Filter Section -->
                        <div class="collapse" id="filterSection">
                            <div class="card mb-3 p-3 bg-light">
                                <div class="row g-3 mb-3">
                                    @if (SessionHelper.LoginType != 3)
                                    {
                                        <div class="col-md-3">
                                            <label class="form-label font-size-13">User</label>
                                            <select id="filterUsers" class="form-select">
                                                <option value="">All Users</option>
                                            </select>
                                        </div>
                                    }

                                    <!-- From Date -->
                                    <div class="col-md-3">
                                        <label class="form-label font-size-13">From Date</label>
                                        <input type="date" id="filterFromDate" name="filterFromDate" class="form-control" placeholder="From Date">
                                    </div>

                                    <!-- To Date -->
                                    <div class="col-md-3">
                                        <label class="form-label font-size-13">To Date</label>
                                        <input type="date" id="filterToDate" name="filterToDate" class="form-control" placeholder="To Date">
                                    </div>

                                    <!-- B/L Number -->
                                    <div class="col-md-3">
                                        <label class="form-label font-size-13">B/L or Booking No</label>
                                        <input type="text" id="filterBLNumber" class="form-control" placeholder="B/L or Booking Number">
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-12 d-flex align-items-end justify-content-start">
                                        <button id="btnSearch" type="button" class="btn btn-primary me-2">
                                            <i class="fas fa-search me-1"></i> Search
                                        </button>
                                        <button id="btnClear" type="button" class="btn btn-secondary">
                                            <i class="fas fa-window-close me-1"></i> Clear
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Add Import Job Button (Admin and Authorized User) -->
                        @if (SessionHelper.UserType == 2 || SessionHelper.UserType == 3)
                        {
                            <div class="text-end mb-3">
                                <a class="btn btn-success" id="btnAdd" href="/Job/AddImport">
                                    <i class="fa fa-plus me-1"></i> Add Import Job
                                </a>
                            </div>
                        }

                        <!-- Table Job Import -->
                        <div class="table-responsive">
                            <table id="datatable" class="table table-striped table-bordered custom-datatable nowrap" style="width:100%">
                                <thead>
                                    <tr>
                                        <th>Id</th>
                                        <th>Job No</th>
                                        <th>User - Admin</th>
                                        <th>Cost Center</th>
                                        <th>Customer</th>
                                        <th>Carrier</th>
                                        <th>Job Date</th>
                                        <th>Shipment</th>
                                        <th>B/L No.</th>
                                        <th>POL</th>
                                        <th>POD</th>
                                        <th>Container Type</th>
                                        <th>Container No.</th>
                                        <th>B/L Status</th>
                                        <th>Created By</th>
                                        <th class="text-center">Actions</th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>
                        </div>

                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

@section Script {
    <!-- Required DataTables JS -->
    <script src="~/assets/libs/datatables.net/js/jquery.dataTables.min.js"></script>
    <script src="~/assets/libs/datatables.net-bs4/js/dataTables.bootstrap4.min.js"></script>

    <!-- SweetAlert2 JS -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        var loginType = '@SessionHelper.LoginType';

        $(document).ready(function () {
            if ($('#filterUsers').length > 0) {
                loadUser();
            }
            setDefaultDates();

            // Search & Clear Button Events
            $("#btnSearch").click(function () {
                loadRecords();
            });

            $("#btnClear").click(function () {
                $("#filterSection").find("input[type='text'], input[type='date']").val("");
                $("#filterSection").find("select").val("");
                setDefaultDates();
                loadRecords();
            });

            loadRecords();
        });

        // Date Initializer Helper Function
        function setDefaultDates() {
            var today = new Date();
            var firstDay = new Date(today.getFullYear(), today.getMonth(), 1);
            var lastDay = new Date(today.getFullYear(), today.getMonth() + 1, 0);

            $('#filterFromDate').val(formatDateFilter(firstDay));
            $('#filterToDate').val(formatDateFilter(lastDay));
        }

        // Date Formatter Helper Function
        function formatDateFilter(date) {
            var d = new Date(date),
                month = '' + (d.getMonth() + 1),
                day = '' + d.getDate(),
                year = d.getFullYear();

            if (month.length < 2) month = '0' + month;
            if (day.length < 2) day = '0' + day;

            return [year, month, day].join('-');
        }

        function loadRecords() {
            if ($.fn.DataTable.isDataTable('#datatable')) {
                $('#datatable').DataTable().destroy();
            }

            var table = $("#datatable").DataTable({
                processing: true,   // keep this true, we're using our own overlay via the event
                serverSide: true,
                paging: true,
                lengthChange: true,
                autoWidth: false,
                responsive: false,
                scrollX: false,
                pageLength: 10,
                order: [[0, "desc"]],
                searching: false,
                dom: "<'row mb-2'<'col-sm-12 col-md-6'l><'col-sm-12 col-md-6'f>>" +
                     "<'row'<'col-sm-12'tr>>" +
                     "<'row mt-3'<'col-sm-12 col-md-5'i><'col-sm-12 col-md-7'p>>",
                language: {
                    paginate: {
                        previous: "<i class='fas fa-chevron-left'></i>",
                        next: "<i class='fas fa-chevron-right'></i>"
                    }
                },
                ajax: {
                    url: "/Job/GetImportJobs",
                    type: "POST",
                    data: function (d) {
                        d.userId = $("#filterUsers").val() || "";
                        d.fromDate = $("#filterFromDate").val() || "";
                        d.toDate = $("#filterToDate").val() || "";
                        d.blNumber = $("#filterBLNumber").val() || "";
                        d.shipmentType = 1;
                    }
                },
                columns: [
                    { data: "Id" },
                    { data: "JobNo" },
                    { data: "LoginTypeName" },
                    { data: "CostCenter" },
                    { data: "CustomerName" },
                    { data: "Carrier" },
                    { data: "JobDate" },
                    { data: "ModeOfShipment" },
                    { data: "BLNumber" },
                    { data: "POL" },
                    { data: "POD" },
                    { data: "ContainerType" },
                    { data: "ContainerNo" },
                    { data: "ShipmentStatus" },
                    { data: "CreatedByUser" },
                    {
                        data: null,
                        orderable: false,
                        searchable: false,
                        className: "text-center",
                        render: function (data, type, row) {
                            if (typeof loginType !== 'undefined' && loginType != '3') {
                                return `<a href="/Job/AddImport/${row.Id}" class="btn btn-sm btn-primary"><i class="fas fa-edit me-1"></i> Edit</a>`;
                            }
                            return `<a href="javascript:void(0);" onclick="openJobDetails(${row.Id})" class="btn btn-sm btn-info"><i class="fas fa-eye me-1"></i> Details</a>`;
                        }
                    }
                ]
            });

            // Show/hide custom loader on every processing event (initial load, search, page change, etc.)
            table.on('processing.dt', function (e, settings, processing) {
                $('#tableLoader').toggle(processing);
            });
        }

        function loadUser(selectedId = null) {
            $.ajax({
                url: '/Dropdown/GetUser',
                type: 'GET',
                dataType: 'json',
                success: function (response) {
                    let $dropdown = $('#filterUsers');
                    $dropdown.empty();
                    $dropdown.append('<option value="" selected>Select All User</option>');

                    if (response && response.data) {
                        $.each(response.data, function (i, item) {
                            $dropdown.append(`<option value="${item.Id}">${item.UserId}</option>`);
                        });
                    }

                    if (selectedId) {
                        $dropdown.val(selectedId);
                    }
                },
                error: function (xhr, status, error) {
                    console.error("Error loading user:", error);
                }
            });
        }

        function openJobDetails(jobId) {
            $.ajax({
                url: '/Job/CheckInvoiceAccess',
                type: 'POST',
                data: { jobId: jobId },
                success: function (response) {
                    if (response.errorCode === 403) {
                        Swal.fire({
                            icon: 'warning',
                            title: 'Access Restricted',
                            text: response.message,
                            showCancelButton: true,
                            confirmButtonText: 'Request Approval',
                            cancelButtonText: 'Cancel'
                        }).then((result) => {
                            if (result.isConfirmed) {
                                requestInvoiceAccess(jobId);
                            }
                        });
                        return;
                    }

                    if (response.errorCode === 409) {
                        Swal.fire({
                            icon: 'info',
                            title: 'Already Requested',
                            text: response.message
                        });
                        return;
                    }

                    window.location.href = '/Job/AddImport/' + jobId;
                },
                error: function () {
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: 'Something went wrong. Please try again.'
                    });
                }
            });
        }

        function requestInvoiceAccess(jobId) {
            $.ajax({
                url: '/Job/RequestInvoiceAccess',
                type: 'POST',
                data: { jobId: jobId },
                success: function (response) {
                    if (response.errorCode === 200) {
                        Swal.fire({
                            icon: 'success',
                            title: 'Request Submitted',
                            text: response.message
                        });
                    } else {
                        Swal.fire({
                            icon: 'info',
                            title: 'Notice',
                            text: response.message
                        });
                    }
                },
                error: function () {
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: 'Unable to submit request.'
                    });
                }
            });
        }
    </script>
}