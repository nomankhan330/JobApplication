@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Head {

    <!-- DataTables -->
    <link href="~/assets/libs/datatables.net-bs4/css/dataTables.bootstrap4.min.css" rel="stylesheet" type="text/css" />
    <link href="~/assets/libs/datatables.net-buttons-bs4/css/buttons.bootstrap4.min.css" rel="stylesheet" type="text/css" />

    <style>
        /* Right align pagination */
        .dataTables_paginate {
            text-align: right !important;
        }

        /* Rounded pagination buttons */
        .pagination-rounded .page-link {
            border-radius: 50px !important;
        }

        /* Optional: Better spacing */
        .dataTables_paginate .pagination {
            justify-content: flex-end !important;
        }
    </style>

    <!-- Custom Styling Extensions -->
    <style>
        .kpi-card-v2 {
            border: 1px solid rgba(0, 0, 0, 0.05);
            border-radius: 12px;
            transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
            position: relative;
            overflow: hidden;
            background: #ffffff;
        }

            .kpi-card-v2:hover {
                transform: translateY(-4px);
                box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.08), 0 8px 10px -6px rgba(0, 0, 0, 0.01);
            }

            .kpi-card-v2::before {
                content: "";
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 3px;
                background: transparent;
                transition: background 0.3s ease;
            }

            /* Top Accent Bars */
            .kpi-card-v2.accent-primary::before {
                background: linear-gradient(90deg, #5b73e8, #4458be);
            }

            .kpi-card-v2.accent-info::before {
                background: linear-gradient(90deg, #17a2b8, #02a0b6);
            }

            .kpi-card-v2.accent-warning::before {
                background: linear-gradient(90deg, #f1b44c, #ff9800);
            }

            .kpi-card-v2.accent-success::before {
                background: linear-gradient(90deg, #34c38f, #10b981);
            }

            .kpi-card-v2.accent-danger::before {
                background: linear-gradient(90deg, #f46a6a, #ef4444);
            }

        /* Soft Icon Containers with subtle glow */
        .avatar-soft-primary {
            background: rgba(91, 115, 232, 0.12) !important;
            color: #5b73e8 !important;
        }

        .avatar-soft-info {
            background: rgba(23, 162, 184, 0.12) !important;
            color: #17a2b8 !important;
        }

        .avatar-soft-warning {
            background: rgba(241, 180, 76, 0.12) !important;
            color: #f1b44c !important;
        }

        .avatar-soft-success {
            background: rgba(52, 195, 143, 0.12) !important;
            color: #34c38f !important;
        }

        .avatar-soft-danger {
            background: rgba(244, 106, 106, 0.12) !important;
            color: #f46a6a !important;
        }

        /* Indicator Badges */
        .trend-badge {
            font-weight: 600;
            padding: 0.25rem 0.5rem;
            border-radius: 6px;
            font-size: 11px;
        }

        .trend-badge-success {
            background: rgba(52, 195, 143, 0.12);
            color: #10b981;
        }

        .trend-badge-danger {
            background: rgba(244, 106, 106, 0.12);
            color: #ef4444;
        }
    </style>
}

<div class="page-content">
    <!-- Full page loader for dashboard -->
    <div id="dashboardFullLoader" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(255,255,255,0.85); z-index:99999; display:flex; align-items:center; justify-content:center;">
        <div style="text-align:center;">
            <div class="spinner-border text-primary" role="status" style="width:3rem;height:3rem;"></div>
            <div style="margin-top:12px; font-weight:600; color:#333;">Loading dashboard, please wait...</div>
        </div>
    </div>
    <div class="container-fluid">

        <!-- start page title -->
        <div class="row">
            <div class="col-12">
                <div class="page-title-box d-sm-flex align-items-center justify-content-between">
                    <h4 class="mb-sm-0">Dashboard</h4>
                    <div class="d-flex align-items-center">
                        <label class="me-2 mb-0 text-muted font-size-13" for="dashboardMonth">Month</label>
                        <select id="dashboardMonth" class="form-select form-select-sm shadow-none" style="width: auto; min-width: 180px;">
                            <option value="all">All</option>
                            <option value="current" selected>Current Month</option>
                            <option value="previous">Previous Month</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
        <!-- end page title -->
        <!-- Row 1: Job Statistics -->
        <div class="row">
            <!-- Total Jobs -->
            <div class="col-xl-4 col-md-6 mb-4">
                <div class="card kpi-card-v2 accent-primary h-100 mb-0">
                    <div class="card-body">
                        <div class="d-flex align-items-center justify-content-between">
                            <div>
                                <span class="text-uppercase font-size-12 fw-bold text-muted tracking-wide">Total Jobs</span>
                                <h3 class="my-2 fw-bold text-dark"><span id="totalJobsCount">0</span></h3>
                                <div class="d-flex align-items-center mt-2">
                                    <span id="totalJobsTrend" class="trend-badge trend-badge-success me-2">
                                        <i class="ri-arrow-right-up-line align-middle"></i> <span class="trend-text">+0.00%</span>
                                    </span>
                                    <span class="text-muted font-size-12">from previous month</span>
                                </div>
                            </div>
                            <div class="avatar-md">
                                <span class="avatar-title avatar-soft-primary rounded-circle">
                                    <i class="ri-archive-line font-size-24"></i>
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Import Jobs -->
            <div class="col-xl-4 col-md-6 mb-4">
                <div class="card kpi-card-v2 accent-info h-100 mb-0">
                    <div class="card-body">
                        <div class="d-flex align-items-center justify-content-between">
                            <div>
                                <span class="text-uppercase font-size-12 fw-bold text-muted tracking-wide">Import Jobs</span>
                                <h3 class="my-2 fw-bold text-dark"><span id="importJobsCount">0</span></h3>
                                <div class="d-flex align-items-center mt-2">
                                    <span id="importJobsTrend" class="trend-badge trend-badge-success me-2">
                                        <i class="ri-arrow-right-up-line align-middle"></i> <span class="trend-text">+0.00%</span>
                                    </span>
                                    <span class="text-muted font-size-12">from previous month</span>
                                </div>
                            </div>
                            <div class="avatar-md">
                                <span class="avatar-title avatar-soft-info rounded-circle">
                                    <i class="ri-ship-line font-size-24"></i>
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Export Jobs -->
            <div class="col-xl-4 col-md-6 mb-4">
                <div class="card kpi-card-v2 accent-warning h-100 mb-0">
                    <div class="card-body">
                        <div class="d-flex align-items-center justify-content-between">
                            <div>
                                <span class="text-uppercase font-size-12 fw-bold text-muted tracking-wide">Export Jobs</span>
                                <h3 class="my-2 fw-bold text-dark"><span id="exportJobsCount">0</span></h3>
                                <div class="d-flex align-items-center mt-2">
                                    <span id="exportJobsTrend" class="trend-badge trend-badge-success me-2">
                                        <i class="ri-arrow-right-up-line align-middle"></i> <span class="trend-text">+0.00%</span>
                                    </span>
                                    <span class="text-muted font-size-12">from previous month</span>
                                </div>
                            </div>
                            <div class="avatar-md">
                                <span class="avatar-title avatar-soft-warning rounded-circle">
                                    <i class="ri-plane-line font-size-24"></i>
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Row 2: Financial Statistics -->
        <div class="row">
            <!-- Sales Revenue -->
            <div class="col-xl-4 col-md-6 mb-4">
                <div class="card kpi-card-v2 accent-success h-100 mb-0">
                    <div class="card-body">
                        <div class="d-flex align-items-center justify-content-between">
                            <div>
                                <span class="text-uppercase font-size-12 fw-bold text-muted tracking-wide">Sales Revenue</span>
                                <h3 class="my-2 fw-bold text-success" id="salesRevenueAmount">0</h3>
                                <div class="d-flex align-items-center mt-2">
                                    <span class="trend-badge me-2" id="salesRevenueTrend">
                                        <i class="ri-arrow-right-up-line align-middle"></i>
                                        <span class="trend-text">0%</span>
                                    </span>
                                    <span class="text-muted font-size-12">Month to Date</span>
                                </div>
                            </div>
                            <div class="avatar-md">
                                <span class="avatar-title avatar-soft-success rounded-circle">
                                    <i class="mdi mdi-currency-usd font-size-24"></i>
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Service Provider Outstanding -->
            <div class="col-xl-4 col-md-6 mb-4">
                <div class="card kpi-card-v2 accent-danger h-100 mb-0">
                    <div class="card-body">
                        <div class="d-flex align-items-center justify-content-between">
                            <div>
                                <span class="text-uppercase font-size-12 fw-bold text-muted tracking-wide">SP Outstanding</span>
                                <h3 class="my-2 fw-bold text-danger" id="spOutstandingAmount">0</h3>
                                <div class="d-flex align-items-center mt-2">
                                    <span class="trend-badge me-2" id="spOutstandingTrend">
                                        <i class="ri-arrow-right-down-line align-middle"></i>
                                        <span class="trend-text">0%</span>
                                    </span>
                                    <span class="text-muted font-size-12">Pending Payables</span>
                                </div>
                            </div>
                            <div class="avatar-md">
                                <span class="avatar-title avatar-soft-danger rounded-circle">
                                    <i class="ri-file-text-line font-size-24"></i>
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Net Cash Inflow -->
            <div class="col-xl-4 col-md-6 mb-4">
                <div class="card kpi-card-v2 accent-primary h-100 mb-0">
                    <div class="card-body">
                        <div class="d-flex align-items-center justify-content-between">
                            <div>
                                <span class="text-uppercase font-size-12 fw-bold text-muted tracking-wide">Net Cash Inflow</span>
                                <h3 class="my-2 fw-bold text-dark" id="netCashInflowAmount">0</h3>
                                <div class="d-flex align-items-center mt-2">
                                    <span class="trend-badge me-2" id="netCashInflowTrend">
                                        <i class="ri-arrow-right-up-line align-middle"></i>
                                        <span class="trend-text">0%</span>
                                    </span>
                                    <span class="text-muted font-size-12">Cash Flow Strength</span>
                                </div>
                            </div>
                            <div class="avatar-md">
                                <span class="avatar-title avatar-soft-primary rounded-circle">
                                    <i class="ri-safe-2-line font-size-24"></i>
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>


        <!-- Charts Row -->
        <div class="row">
            <div class="col-xl-6">
                <div class="card">
                    <div class="card-body pb-0">
                        <div class="float-end d-none d-md-inline-block">
                            <div class="dropdown card-header-dropdown" style="display:none;">
                                <a class="text-reset dropdown-btn" href="#" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                    <span class="text-muted">Report<i class="mdi mdi-chevron-down ms-1"></i></span>
                                </a>
                                <div class="dropdown-menu dropdown-menu-end">
                                    <a class="dropdown-item" href="#">Export CSV</a>
                                    <a class="dropdown-item" href="#">Download PDF</a>
                                </div>
                            </div>
                        </div>
                        <h4 class="card-title mb-4">Sales vs Purchases Trend</h4>

                        <div class="text-center pt-3">
                            <div class="row">
                                <div class="col-sm-4 mb-3 mb-sm-0">
                                    <div class="d-inline-flex">
                                        <h5 class="me-2" id="salesWeekAmount">Rs. 0</h5>
                                    </div>
                                    <p class="text-muted text-truncate mb-0">Sales (This Week)</p>
                                </div><!-- end col -->
                                <div class="col-sm-4 mb-3 mb-sm-0">
                                    <div class="d-inline-flex">
                                        <h5 class="me-2" id="purchasesWeekAmount">Rs. 0</h5>
                                    </div>
                                    <p class="text-muted text-truncate mb-0">Purchases (This Week)</p>
                                </div><!-- end col -->
                                <div class="col-sm-4">
                                    <div class="d-inline-flex">
                                        <h5 class="me-2" id="netMarginAmount">Rs. 0</h5>
                                    </div>
                                    <p class="text-muted text-truncate mb-0">Net Margin</p>
                                </div><!-- end col -->
                            </div><!-- end row -->
                        </div>
                    </div>
                    <div class="card-body py-0 px-2">
                        <div id="area_chart" class="apex-charts" dir="ltr"></div>
                    </div>
                </div><!-- end card -->
            </div><!-- end col -->

            <div class="col-xl-6">
                <div class="card">
                    <div class="card-body pb-0">
                        <h4 class="card-title mb-4">Revenue Billing vs Cash Collection</h4>

                        <div class="text-center pt-3">
                            <div class="row">
                                <div class="col-sm-4 mb-3 mb-sm-0">
                                    <div>
                                        <h5 id="totalInvoicedAmount">Rs. 0</h5>
                                        <p class="text-muted text-truncate mb-0">Total Invoiced</p>
                                    </div>
                                </div><!-- end col -->
                                <div class="col-sm-4 mb-3 mb-sm-0">
                                    <div>
                                        <h5 id="collectedCashAmount">Rs. 0</h5>
                                        <p class="text-muted text-truncate mb-0">Collected Cash</p>
                                    </div>
                                </div><!-- end col -->
                                <div class="col-sm-4">
                                    <div>
                                        <h5 id="remainingRecoveryAmount">Rs. 0</h5>
                                        <p class="text-muted text-truncate mb-0">Remaining Recovery</p>
                                    </div>
                                </div><!-- end col -->
                            </div><!-- end row -->
                        </div>
                    </div>
                    <div class="card-body py-0 px-2">
                        <div id="column_line_chart" class="apex-charts" dir="ltr"></div>
                    </div>
                </div><!-- end card -->
            </div><!-- end col -->
        </div>
        <!-- end row -->

        <!-- Tables & Donut Chart Row -->
        <div class="row">
            <div class="col-xl-8">
                <div class="card">
                    <div class="card-body">
                        <div class="dropdown float-end">
                            <a href="#" class="dropdown-toggle arrow-none card-drop" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="mdi mdi-dots-vertical"></i>
                            </a>
                            <div class="dropdown-menu dropdown-menu-end">
                                <a href="/Invoice/SalesInvoice" class="dropdown-item">View All Sales Invoices</a>
                                <a href="/Invoice/PurchaseInvoice" class="dropdown-item">View All Purchase Invoices</a>
                            </div>
                        </div>

                        <h4 class="card-title mb-4">Recent Invoices & Status</h4>

                        <div class="table-responsive">
                            <table class="table table-centered mb-0 align-middle table-hover table-nowrap">
                                <thead class="table-light">
                                    <tr>
                                        <th>Invoice No</th>
                                        <th>Job No</th>
                                        <th>Party Name</th>
                                        <th>Type</th>
                                        
                                        <th>Grand Total</th>
                                        <th style="width: 120px;">Status</th>
                                    </tr>
                                </thead><!-- end thead -->
                                <tbody id="recentInvoicesBody">
                                    <!-- Dynamic -->
                                </tbody><!-- end tbody -->
                            </table> <!-- end table -->
                        </div>

                    </div><!-- end cardbody -->
                </div><!-- end card -->
            </div><!-- end col -->

            <div class="col-xl-4">
                <div class="card">
                    <div class="card-body">
                        <h4 class="card-title mb-4">Job Operations Share</h4>

                        <div class="row" id="jobSharePercentages">
                            
                        </div>

                        <div class="mt-4">
                            <div id="job-operation-chart" class="apex-charts"></div>
                        </div>
                    </div>
                </div>
            </div><!-- end col -->
        </div>
        <!-- end row -->

    </div>
</div>

@section Script {
    <!-- Required datatable js -->
    <script src="~/assets/libs/datatables.net/js/jquery.dataTables.min.js"></script>
    <script src="~/assets/libs/datatables.net-bs4/js/dataTables.bootstrap4.min.js"></script>
    <script src="~/assets/libs/apexcharts/apexcharts.min.js"></script>
    <script>
        // Register handlers early so initial dashboard.init AJAX calls are tracked
        (function(){
            var trackedUrls = ['/Dashboard/GetSalesPurchaseTrend', '/Dashboard/GetRevenueBillingTrend', '/Dashboard/GetDashboardData'];
            var active = 0;

            function showLoader(){
                try{ $('#dashboardFullLoader').show(); }catch(e){}
            }
            function hideLoader(){
                try{ $('#dashboardFullLoader').hide(); }catch(e){}
            }

            // move loader to body so position:fixed centers in viewport (avoid ancestor transform issues)
            try {
                var $loader = $('#dashboardFullLoader');
                if ($loader.length) {
                    $loader.appendTo('body');
                }
            } catch (e) {}

            // show loader immediately on page load
            showLoader();

            $(document).on('ajaxSend.dashboardLoader', function (e, jqXHR, settings) {
                try{
                    var url = settings && settings.url ? settings.url.toString() : '';
                    trackedUrls.forEach(function(u){ if (url.indexOf(u) !== -1) active++; });
                    if (active > 0) showLoader();
                }catch(err){ }
            });

            $(document).on('ajaxComplete.dashboardLoader', function (e, jqXHR, settings) {
                try{
                    var url = settings && settings.url ? settings.url.toString() : '';
                    trackedUrls.forEach(function(u){ if (url.indexOf(u) !== -1) active = Math.max(0, active-1); });
                    if (active === 0) hideLoader();
                }catch(err){ }
            });

            // safety timeout: hide loader after 15s if something hangs
            setTimeout(function(){ if (active > 0) hideLoader(); }, 10000);
        })();
    </script>
    <script src="~/assets/js/pages/dashboard.init.js"></script>

    <script>

        $(function () {

            // ========== Helpers ==========
            function formatCurrency(amount) {
                return 'Rs. ' + Number(amount || 0).toLocaleString('en-PK');
            }

            function applyTrend(elemId, trendText, trendClass) {
                var $el = $(elemId);
                $el.removeClass('trend-badge-success trend-badge-danger');
                if (trendClass) $el.addClass(trendClass);
                $el.find('.trend-text').text(trendText || '0%');

                var $icon = $el.find('i');
                if (trendText && trendText.toString().trim().startsWith('-')) {
                    $icon.removeClass('ri-arrow-right-up-line').addClass('ri-arrow-right-down-line');
                } else {
                    $icon.removeClass('ri-arrow-right-down-line').addClass('ri-arrow-right-up-line');
                }
            }

            // ========== Update Functions ==========
            function updateStatistics(resp) {
                if (!resp) return;

                $('#totalJobsCount').text(resp.totalJobs ?? 0);
                $('#importJobsCount').text(resp.importJobs ?? 0);
                $('#exportJobsCount').text(resp.exportJobs ?? 0);

                applyTrend('#totalJobsTrend', resp.totalJobsTrendText, resp.totalJobsTrendClass);
                applyTrend('#importJobsTrend', resp.importJobsTrendText, resp.importJobsTrendClass);
                applyTrend('#exportJobsTrend', resp.exportJobsTrendText, resp.exportJobsTrendClass);

                $('#salesRevenueAmount').text(formatCurrency(resp.salesRevenue));
                $('#spOutstandingAmount').text(formatCurrency(resp.spOutstanding));
                $('#netCashInflowAmount').text(formatCurrency(resp.netCashInflow));

                applyTrend('#salesRevenueTrend', resp.salesRevenueTrendText, resp.salesRevenueTrendClass);
                applyTrend('#spOutstandingTrend', resp.spOutstandingTrendText, resp.spOutstandingTrendClass);
                applyTrend('#netCashInflowTrend', resp.netCashInflowTrendText, resp.netCashInflowTrendClass);
            }

            function updateRecentInvoices(data) {

                if (!data || !Array.isArray(data)) return;
                //alert(data.length)

                // 🔹 Jab koi record na mile
                if (data.length === 0) {
                    let emptyHtml = `
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">
                                <i class="ri-inbox-line display-6 d-block mb-2"></i>
                                No Recent Invoices Found
                            </td>
                        </tr>`;
                    $('#recentInvoicesBody').html(emptyHtml);
                    return;
                }

                let html = '';
                data.forEach(function (item) {
                    let typeBadge = item.Type === 'Sales'
                        ? '<span class="badge badge-soft-primary">Sales</span>'
                        : '<span class="badge badge-soft-warning">Purchase</span>';

                    // ========== Status Mapping ==========
                    let statusName = 'Unknown';
                    let statusClass = 'text-secondary';

                    switch (parseInt(item.Status)) {
                        case 1:
                            statusName = 'Paid';
                            statusClass = 'text-success';
                            break;

                        case 0:
                            statusName = 'Unpaid';
                            statusClass = 'text-danger';
                            break;

                        case 2:
                            statusName = 'Partially Paid';
                            statusClass = 'text-warning';
                            break;

                        default:
                            statusName = 'Unknown';
                            statusClass = 'text-secondary';
                    }

                    html += `
                        <tr>
                            <td><h6 class="mb-0">${item.InvoiceNo || ''}</h6></td>
                            <td>${item.JobNo || ''}</td>
                            <td>${item.PartyName || ''}</td>
                            <td>${typeBadge}</td>
                            <td>Rs. ${Number(item.GrandTotal || 0).toLocaleString('en-PK', { minimumFractionDigits: 2 })}</td>
                            <td>
                                <div class="font-size-13">
                                    <i class="ri-checkbox-blank-circle-fill font-size-10 ${statusClass} align-middle me-2"></i>
                                    ${statusName}
                                </div>
                            </td>
                        </tr>`;
                });

                $('#recentInvoicesBody').html(html);
            }

            let donutChart = null;

            function updateJobOperationsShare(data) {
                if (!data || !Array.isArray(data)) return;

                const $chartContainer = $('#job-operation-chart');
                const $percentContainer = $('#jobSharePercentages');

                // 🔹 Jab koi record na ho (Empty State)
                if (data.length === 0) {
                    // Highcharts / ApexCharts instance reset
                    if (donutChart) {
                        donutChart.destroy();
                        donutChart = null;
                    }

                    // Percentage Section Empty Clear
                    $percentContainer.html('');

                    // Chart Area mein Empty State UI Message
                    let emptyHtml = `
                        <div class="text-center py-5 text-muted">
                            <i class="ri-pie-chart-line display-4 d-block mb-2 text-secondary opacity-50"></i>
                            <h6 class="text-muted fw-normal mb-1">No Job Operations Data Found</h6>
                            <p class="font-size-12 text-muted mb-0">No records available for the selected period.</p>
                        </div>`;
        
                    $chartContainer.html(emptyHtml);
                    return;
                }

                // 🔹 Percentages Render
                let percentHtml = '';
                data.forEach(function (item) {
                    percentHtml += `
                        <div class="col-4">
                            <div class="text-center mt-4">
                                <h5>${item.Percentage}%</h5>
                                <p class="mb-2 text-truncate">${item.Label}</p>
                            </div>
                        </div>`;
                });
                $percentContainer.html(percentHtml);

                // 🔹 Donut Chart Render / Update
                const series = data.map(x => x.Percentage);
                const labels = data.map(x => x.Label);

                // Agar pehle empty HTML container mein lag gaya tha toh usko clear karein
                if ($chartContainer.find('.text-center').length > 0) {
                    $chartContainer.html('');
                }

                if (donutChart) {
                    donutChart.updateOptions({
                        series: series,
                        labels: labels
                    });
                } else {
                    donutChart = new ApexCharts(document.querySelector("#job-operation-chart"), {
                        series: series,
                        chart: { type: 'donut', height: 300 },
                        labels: labels,
                        legend: { position: 'bottom' },
                        dataLabels: { enabled: false },
                        colors: ['#5b73e8', '#34c38f', '#f1b44c', '#f46a6a', '#17a2b8']
                    });
                    donutChart.render();
                }
            }

            // ========== Month Dropdown ==========
            function pad(n) { return n < 10 ? '0' + n : '' + n; }

            (function populateMonthOptions() {
                var $month = $('#dashboardMonth');
                if (!$month.length) return;

                var now = new Date();
                var monthNames = ['January', 'February', 'March', 'April', 'May', 'June',
                    'July', 'August', 'September', 'October', 'November', 'December'];

                $month.append('<option disabled>────────────</option>');

                // Past months (2 months ago se start, takke Previous Month na dohraye)
                for (var i = 2; i <= 13; i++) {
                    var d = new Date(now.getFullYear(), now.getMonth() - i, 1);
                    var value = d.getFullYear() + '-' + pad(d.getMonth() + 1);
                    var label = monthNames[d.getMonth()] + ' ' + d.getFullYear();
                    $month.append($('<option></option>').attr('value', value).text(label));
                }
            })();

            function getSelectedMonth() {
                return $('#dashboardMonth').val() || 'current';
            }

            // ========== Main Load Function (Sirf 1 Request) ==========
            function loadDashboard() {
                const month = getSelectedMonth();

                // All (all-time) select hone pe trend badges meaningful nahi hote
                try { $('.trend-badge').closest('.d-flex').toggle(month !== 'all'); } catch (e) { }

                // ensure loader visible while dashboard main data is being fetched
                try { $('#dashboardFullLoader').show(); } catch (e) { }

                $.ajax({
                    url: '/Dashboard/GetDashboardData',
                    type: 'GET',
                    data: { month: month },
                    cache: false,
                    success: function (resp) {

                        console.log(resp);

                        if (!resp || resp.error) {
                            console.error(resp?.message || 'Failed to load dashboard');
                            return;
                        }

                        updateStatistics(resp.statistics);
                        updateRecentInvoices(resp.recentInvoices);
                        updateJobOperationsShare(resp.jobOperationsShare);

                        // hide loader immediately after main dashboard data applied
                        try { $('#dashboardFullLoader').hide(); } catch (e) { }
                    },
                    error: function (xhr) {
                        console.error('Dashboard load failed', xhr);
                        try { $('#dashboardFullLoader').hide(); } catch (e) { }
                    }
                });
            }

            // ========== Events ==========
            loadDashboard();                          // First load

            $('#dashboardMonth').on('change', function () {
                loadDashboard();                      // Month change pe dashboard reload

                // Charts bhi selected month ke according reload
                var month = getSelectedMonth();
                if (window.DashboardFetchTrend) DashboardFetchTrend(null, null, null, month);
                if (window.DashboardFetchRevenue) DashboardFetchRevenue(null, null, null, month);
            });

            // Auto refresh every 30 seconds
            setInterval(loadDashboard, 30000);
        });
    </script>
}