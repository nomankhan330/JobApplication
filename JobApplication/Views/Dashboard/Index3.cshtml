@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Head {

    <!-- DataTables -->
    <link href="~/assets/libs/datatables.net-bs4/css/dataTables.bootstrap4.min.css" rel="stylesheet" type="text/css" />
    <link href="~/assets/libs/datatables.net-buttons-bs4/css/buttons.bootstrap4.min.css" rel="stylesheet" type="text/css" />

    <style>
        /* Right align pagination */
        .dataTables_paginate {
            text-align: right !important;
        }

        /* Rounded pagination buttons */
        .pagination-rounded .page-link {
            border-radius: 50px !important;
        }

        /* Optional: Better spacing */
        .dataTables_paginate .pagination {
            justify-content: flex-end !important;
        }
    </style>
}

<div class="page-content">
    <div class="container-fluid">

        <!-- start page title -->
        <div class="row">
            <div class="col-12">
                <div class="page-title-box d-sm-flex align-items-center justify-content-between">
                    <h4 class="mb-sm-0">Dashboard</h4>
                </div>
            </div>
        </div>
        <!-- end page title -->
        <!-- 4 Quick Stats (KPI Cards) -->
        <div class="row">
            <div class="col-xl-3 col-md-6">
                <div class="card">
                    <div class="card-body">
                        <div class="d-flex">
                            <div class="flex-grow-1">
                                <p class="text-truncate font-size-14 mb-2">Active Jobs (Month)</p>
                                <h4 class="mb-2">142</h4>
                                <p class="text-muted mb-0"><span class="text-success fw-bold font-size-12 me-2"><i class="ri-arrow-right-up-line me-1 align-middle"></i>+5.4%</span>from previous month</p>
                            </div>
                            <div class="avatar-sm">
                                <span class="avatar-title bg-light text-primary rounded-3">
                                    <i class="ri-briefcase-4-line font-size-24"></i>
                                </span>
                            </div>
                        </div>
                    </div><!-- end cardbody -->
                </div><!-- end card -->
            </div><!-- end col -->
            <div class="col-xl-3 col-md-6">
                <div class="card">
                    <div class="card-body">
                        <div class="d-flex">
                            <div class="flex-grow-1">
                                <p class="text-truncate font-size-14 mb-2">Total Sales Revenue</p>
                                <h4 class="mb-2">Rs. 2,450,000</h4>
                                <p class="text-muted mb-0"><span class="text-success fw-bold font-size-12 me-2"><i class="ri-arrow-right-up-line me-1 align-middle"></i>+9.23%</span>Month to Date</p>
                            </div>
                            <div class="avatar-sm">
                                <span class="avatar-title bg-light text-success rounded-3">
                                    <i class="mdi mdi-currency-usd font-size-24"></i>
                                </span>
                            </div>
                        </div>
                    </div><!-- end cardbody -->
                </div><!-- end card -->
            </div><!-- end col -->
            <div class="col-xl-3 col-md-6">
                <div class="card">
                    <div class="card-body">
                        <div class="d-flex">
                            <div class="flex-grow-1">
                                <p class="text-truncate font-size-14 mb-2">Vendor Outstandings</p>
                                <h4 class="mb-2">Rs. 1,120,000</h4>
                                <p class="text-muted mb-0"><span class="text-danger fw-bold font-size-12 me-2"><i class="ri-arrow-right-down-line me-1 align-middle"></i>1.09%</span>Pending Payables</p>
                            </div>
                            <div class="avatar-sm">
                                <span class="avatar-title bg-light text-danger rounded-3">
                                    <i class="ri-bank-card-line font-size-24"></i>
                                </span>
                            </div>
                        </div>
                    </div><!-- end cardbody -->
                </div><!-- end card -->
            </div><!-- end col -->
            <div class="col-xl-3 col-md-6">
                <div class="card">
                    <div class="card-body">
                        <div class="d-flex">
                            <div class="flex-grow-1">
                                <p class="text-truncate font-size-14 mb-2">Net Cash Inflow</p>
                                <h4 class="mb-2">Rs. 1,330,000</h4>
                                <p class="text-muted mb-0"><span class="text-success fw-bold font-size-12 me-2"><i class="ri-arrow-right-up-line me-1 align-middle"></i>16.2%</span>Cash Flow Strength</p>
                            </div>
                            <div class="avatar-sm">
                                <span class="avatar-title bg-light text-info rounded-3">
                                    <i class="ri-safe-2-line font-size-24"></i>
                                </span>
                            </div>
                        </div>
                    </div><!-- end cardbody -->
                </div><!-- end card -->
            </div><!-- end col -->
        </div><!-- end row -->
        <!-- Charts Row -->
        <div class="row">
            <div class="col-xl-6">
                <div class="card">
                    <div class="card-body pb-0">
                        <div class="float-end d-none d-md-inline-block">
                            <div class="dropdown card-header-dropdown">
                                <a class="text-reset dropdown-btn" href="#" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                    <span class="text-muted">Report<i class="mdi mdi-chevron-down ms-1"></i></span>
                                </a>
                                <div class="dropdown-menu dropdown-menu-end">
                                    <a class="dropdown-item" href="#">Export CSV</a>
                                    <a class="dropdown-item" href="#">Download PDF</a>
                                </div>
                            </div>
                        </div>
                        <h4 class="card-title mb-4">Sales vs Purchases Trend</h4>

                        <div class="text-center pt-3">
                            <div class="row">
                                <div class="col-sm-4 mb-3 mb-sm-0">
                                    <div class="d-inline-flex">
                                        <h5 class="me-2">Rs. 845,000</h5>
                                    </div>
                                    <p class="text-muted text-truncate mb-0">Sales (This Week)</p>
                                </div><!-- end col -->
                                <div class="col-sm-4 mb-3 mb-sm-0">
                                    <div class="d-inline-flex">
                                        <h5 class="me-2">Rs. 320,000</h5>
                                    </div>
                                    <p class="text-muted text-truncate mb-0">Purchases (This Week)</p>
                                </div><!-- end col -->
                                <div class="col-sm-4">
                                    <div class="d-inline-flex">
                                        <h5 class="me-2">Rs. 525,000</h5>
                                    </div>
                                    <p class="text-muted text-truncate mb-0">Net Margin</p>
                                </div><!-- end col -->
                            </div><!-- end row -->
                        </div>
                    </div>
                    <div class="card-body py-0 px-2">
                        <div id="area_chart" class="apex-charts" dir="ltr"></div>
                    </div>
                </div><!-- end card -->
            </div><!-- end col -->

            <div class="col-xl-6">
                <div class="card">
                    <div class="card-body pb-0">
                        <div class="float-end d-none d-md-inline-block">
                            <div class="dropdown">
                                <a class="text-reset" href="#" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                    <span class="text-muted">This Year<i class="mdi mdi-chevron-down ms-1"></i></span>
                                </a>
                                <div class="dropdown-menu dropdown-menu-end">
                                    <a class="dropdown-item" href="#">Last Month</a>
                                    <a class="dropdown-item" href="#">This Year</a>
                                </div>
                            </div>
                        </div>
                        <h4 class="card-title mb-4">Revenue Billing vs Cash Collection</h4>

                        <div class="text-center pt-3">
                            <div class="row">
                                <div class="col-sm-4 mb-3 mb-sm-0">
                                    <div>
                                        <h5>Rs. 2,450,000</h5>
                                        <p class="text-muted text-truncate mb-0">Total Invoiced</p>
                                    </div>
                                </div><!-- end col -->
                                <div class="col-sm-4 mb-3 mb-sm-0">
                                    <div>
                                        <h5>Rs. 1,850,000</h5>
                                        <p class="text-muted text-truncate mb-0">Collected Cash</p>
                                    </div>
                                </div><!-- end col -->
                                <div class="col-sm-4">
                                    <div>
                                        <h5>Rs. 600,000</h5>
                                        <p class="text-muted text-truncate mb-0">Remaining Recovery</p>
                                    </div>
                                </div><!-- end col -->
                            </div><!-- end row -->
                        </div>
                    </div>
                    <div class="card-body py-0 px-2">
                        <div id="column_line_chart" class="apex-charts" dir="ltr"></div>
                    </div>
                </div><!-- end card -->
            </div><!-- end col -->
        </div><!-- end row -->
        <!-- Tables & Donut Chart Row -->
        <div class="row">
            <div class="col-xl-8">
                <div class="card">
                    <div class="card-body">
                        <div class="dropdown float-end">
                            <a href="#" class="dropdown-toggle arrow-none card-drop" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="mdi mdi-dots-vertical"></i>
                            </a>
                            <div class="dropdown-menu dropdown-menu-end">
                                <a href="javascript:void(0);" class="dropdown-item">View All Sales Invoices</a>
                                <a href="javascript:void(0);" class="dropdown-item">View All Purchase Invoices</a>
                            </div>
                        </div>

                        <h4 class="card-title mb-4">Recent Invoices & Status</h4>

                        <div class="table-responsive">
                            <table class="table table-centered mb-0 align-middle table-hover table-nowrap">
                                <thead class="table-light">
                                    <tr>
                                        <th>Invoice No</th>
                                        <th>Party Name</th>
                                        <th>Type</th>
                                        <th>BL Number</th>
                                        <th>Grand Total</th>
                                        <th style="width: 120px;">Status</th>
                                    </tr>
                                </thead><!-- end thead -->
                                <tbody>
                                    <tr>
                                        <td><h6 class="mb-0">INV-2024-001</h6></td>
                                        <td>Al-Noor Logistics</td>
                                        <td><span class="badge badge-soft-primary">Sales</span></td>
                                        <td>BL-99231A</td>
                                        <td>Rs. 45,000.00</td>
                                        <td>
                                            <div class="font-size-13"><i class="ri-checkbox-blank-circle-fill font-size-10 text-success align-middle me-2"></i>Paid</div>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td><h6 class="mb-0">PINV-2024-042</h6></td>
                                        <td>Swift Shipping Line</td>
                                        <td><span class="badge badge-soft-warning">Purchase</span></td>
                                        <td>BL-88123B</td>
                                        <td>Rs. 120,000.00</td>
                                        <td>
                                            <div class="font-size-13"><i class="ri-checkbox-blank-circle-fill font-size-10 text-danger align-middle me-2"></i>Unpaid</div>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td><h6 class="mb-0">INV-2024-002</h6></td>
                                        <td>Universal Traders</td>
                                        <td><span class="badge badge-soft-primary">Sales</span></td>
                                        <td>BL-44122C</td>
                                        <td>Rs. 75,000.00</td>
                                        <td>
                                            <div class="font-size-13"><i class="ri-checkbox-blank-circle-fill font-size-10 text-warning align-middle me-2"></i>Partially Paid</div>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td><h6 class="mb-0">INV-2024-003</h6></td>
                                        <td>Karam Ceramics</td>
                                        <td><span class="badge badge-soft-primary">Sales</span></td>
                                        <td>BL-10293D</td>
                                        <td>Rs. 32,500.00</td>
                                        <td>
                                            <div class="font-size-13"><i class="ri-checkbox-blank-circle-fill font-size-10 text-success align-middle me-2"></i>Paid</div>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td><h6 class="mb-0">PINV-2024-043</h6></td>
                                        <td>Maersk Pakistan</td>
                                        <td><span class="badge badge-soft-warning">Purchase</span></td>
                                        <td>BL-77481E</td>
                                        <td>Rs. 210,000.00</td>
                                        <td>
                                            <div class="font-size-13"><i class="ri-checkbox-blank-circle-fill font-size-10 text-warning align-middle me-2"></i>Partially Paid</div>
                                        </td>
                                    </tr>
                                </tbody><!-- end tbody -->
                            </table> <!-- end table -->
                        </div>
                    </div><!-- end cardbody -->
                </div><!-- end card -->
            </div><!-- end col -->

            <div class="col-xl-4">
                <div class="card">
                    <div class="card-body">
                        <div class="float-end">
                            <select class="form-select shadow-none form-select-sm">
                                <option selected>This Month</option>
                                <option value="1">Last Month</option>
                                <option value="2">This Year</option>
                            </select>
                        </div>
                        <h4 class="card-title mb-4">Job Operations Share</h4>

                        <div class="row">
                            <div class="col-4">
                                <div class="text-center mt-4">
                                    <h5>55%</h5>
                                    <p class="mb-2 text-truncate">Sea Import</p>
                                </div>
                            </div><!-- end col -->
                            <div class="col-4">
                                <div class="text-center mt-4">
                                    <h5>30%</h5>
                                    <p class="mb-2 text-truncate">Air Import</p>
                                </div>
                            </div><!-- end col -->
                            <div class="col-4">
                                <div class="text-center mt-4">
                                    <h5>15%</h5>
                                    <p class="mb-2 text-truncate">Local Log.</p>
                                </div>
                            </div><!-- end col -->
                        </div><!-- end row -->

                        <div class="mt-4">
                            <div id="donut-chart" class="apex-charts"></div>
                        </div>
                    </div><!-- end cardbody -->
                </div><!-- end card -->
            </div><!-- end col -->
        </div><!-- end row -->
    </div>
</div>

@section Script {
    <!-- Required datatable js -->
    <script src="~/assets/libs/datatables.net/js/jquery.dataTables.min.js"></script>
    <script src="~/assets/libs/datatables.net-bs4/js/dataTables.bootstrap4.min.js"></script>
    <script src="~/assets/libs/apexcharts/apexcharts.min.js"></script>
    <script src="~/assets/js/pages/dashboard.init.js"></script>
}